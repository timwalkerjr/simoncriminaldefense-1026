---
// Footer component - ported from source layout
import { SITE } from '@/config/site';
---

<footer class="bg-[#04101F] text-[#98A6BB] pt-16 pb-12 border-t border-white/10" data-ps="src/components/Footer.astro:footer">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/components/Footer.astro:256hmy">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.3fr_0.8fr_0.8fr_1.1fr] gap-10 lg:gap-12 mb-12" data-ps="src/components/Footer.astro:p4vf82">
      <!-- Col 1: Brand & Bio -->
      <div data-ps="src/components/Footer.astro:p4vf83">
        <div class="flex flex-col items-start justify-center mb-4" data-ps="src/components/Footer.astro:p4vf84">
          <div class="flex items-center gap-1.5 text-[10px] uppercase tracking-[1.8px] text-[#C9A840] font-semibold leading-tight" data-ps="src/components/Footer.astro:p4vf85">
            <span class="w-[12px] h-[1px] bg-[#C9A840] opacity-70 inline-block" data-ps="src/components/Footer.astro:abywyy"></span>
            <span data-ps="src/components/Footer.astro:abywyz">LAW OFFICES OF</span>
            <span class="w-[12px] h-[1px] bg-[#C9A840] opacity-70 inline-block" data-ps="src/components/Footer.astro:abywz0"></span>
          </div>
          <span class="font-heading font-bold text-[20px] text-white tracking-normal leading-tight my-0.5" data-ps="src/components/Footer.astro:abywz1">
            Joseph A. Simon
          </span>
          <div class="text-[9px] uppercase tracking-[2px] text-[#C9A840] font-semibold leading-tight" data-ps="src/components/Footer.astro:p4vf86">
            — PLLC —
          </div>
        </div>

        <p class="text-[14px] text-[#98A6BB] leading-relaxed mb-6" data-ps="src/components/Footer.astro:csf9x">
          Criminal defense is all we do. Defending clients across Washtenaw County and throughout Southeast Michigan for more than 40 years.
        </p>

        <!-- Social Links -->
        <div class="flex items-center gap-2.5" data-ps="src/components/Footer.astro:p4vf87">
          <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-9 h-9 rounded-[4px] bg-white/[0.04] border border-white/10 flex items-center justify-center text-[#C3CCDA] hover:text-white hover:border-[#732521] transition-colors" data-ps="src/components/Footer.astro:7gqbxw">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href="/reviews/" aria-label="Google Reviews" class="w-9 h-9 rounded-[4px] bg-white/[0.04] border border-white/10 flex items-center justify-center text-[#C3CCDA] hover:text-white hover:border-[#732521] transition-colors" data-ps="src/components/Footer.astro:7gqbxy">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Practice Areas -->
      <div data-ps="src/components/Footer.astro:p4vf88">
        <h4 class="font-bold uppercase tracking-[1.8px] mb-4 text-[rgb(201,168,64)] text-[12px]" data-ps="src/components/Footer.astro:2uqr9n">
          PRACTICE AREAS
        </h4>
        <ul class="list-none p-0 m-0 space-y-2.5 text-[14.5px]">
          <li data-ps="src/components/Footer.astro:wyji3t"><a href="/practice-area/drug-crimes/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqby0">Drug Crimes</a></li>
          <li data-ps="src/components/Footer.astro:wyji3u"><a href="/practice-area/assault-defense/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqby1">Assault & Battery</a></li>
          <li data-ps="src/components/Footer.astro:wyji3v"><a href="/practice-area/domestic-violence-defense/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyn">Domestic Violence</a></li>
          <li data-ps="src/components/Footer.astro:wyji3w"><a href="/practice-area/sex-crime-defense/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyo">Criminal Sexual Conduct</a></li>
          <li data-ps="src/components/Footer.astro:wyji3x"><a href="/practice-area/expungements/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyp">Expungements</a></li>
          <li data-ps="src/components/Footer.astro:wyji3y"><a href="/practice-area/college-crimes-defense/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyq">College & Campus Crimes</a></li>
          <li data-ps="src/components/Footer.astro:wyji4a"><a href="/practice-area/theft-offenses/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyz">Theft Offenses</a></li>
          <li data-ps="src/components/Footer.astro:wyji4b"><a href="/practice-area/police-investigations/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbza">Police Investigations</a></li>
        </ul>
      </div>

      <!-- Col 3: Firm -->
      <div data-ps="src/components/Footer.astro:p4vf89">
        <h4 class="font-bold uppercase tracking-[1.8px] mb-4 text-[rgb(201,168,64)] text-[12px]" data-ps="src/components/Footer.astro:2uqr9o">
          FIRM
        </h4>
        <ul class="list-none p-0 m-0 space-y-2.5 text-[14.5px]">
          <li data-ps="src/components/Footer.astro:wyji3z"><a href="/case-results/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyr">Case Results</a></li>
          <li data-ps="src/components/Footer.astro:wyji40"><a href="/reviews/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbys">Reviews</a></li>
          <li data-ps="src/components/Footer.astro:posts-foot"><a href="/posts/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqby_posts">Posts</a></li>
          <li data-ps="src/components/Footer.astro:media-foot"><a href="/media/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqby_media">In the News</a></li>
          <li data-ps="src/components/Footer.astro:wyji4o"><a href="/#faq" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyv">FAQs</a></li>
          <li data-ps="src/components/Footer.astro:wyji4p"><a href="/service-areas/" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbyw">Service Areas</a></li>
          <li data-ps="src/components/Footer.astro:wyji4q"><a href="/#contact" class="text-[#98A6BB] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbzi">Consultation</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Office -->
      <div data-ps="src/components/Footer.astro:p4vf8a">
        <h4 class="font-bold uppercase tracking-[1.8px] mb-4 text-[rgb(201,168,64)] text-[12px]" data-ps="src/components/Footer.astro:2uqr9p">
          CONTACT & OFFICE
        </h4>
        <p class="text-[14.5px] text-[#98A6BB] leading-snug mb-3" data-ps="src/components/Footer.astro:csfaj">
          1310 South Main Street, Suite 11<br />
          Ann Arbor, MI 48104
        </p>
        <p class="mb-2" data-ps="src/components/Footer.astro:csfak">
          <a href="tel:+17348876200" class="text-[16px] font-bold text-white hover:text-[#DDC582] transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbzj">
            (734) 887-6200
          </a>
        </p>
        <p class="text-[13.5px] text-[#98A6BB] mb-4" data-ps="src/components/Footer.astro:csfal">
          Available 24/7 for urgent matters
        </p>
        <a href="/#contact" class="inline-block bg-[#732521] text-white text-[14px] font-semibold px-5 py-2.5 rounded-[3px] hover:bg-[#5a1c19] transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbzk">
          Confidential Consultation
        </a>
      </div>
    </div>

    <!-- Legal Disclaimer Bar -->
    <div class="border-t border-white/10 pt-8 text-center sm:text-left space-y-4" data-ps="src/components/Footer.astro:p4vf8b">
      <p class="text-[13.12px] text-[#98A6BB]" data-ps="src/components/Footer.astro:csfam">
        © 2026 Law Offices of Joseph A. Simon, PLLC. All Rights Reserved.
      </p>
      <p class="text-[12px] text-[#727C8B] leading-[1.6]" data-ps="src/components/Footer.astro:csfan">
        Attorney advertising. Prior results do not guarantee similar outcomes. AV Preeminent is a peer-review rating from Martindale-Hubbell; it is not a certification of specialization. No aspect of this advertisement has been approved by the Supreme Court of Michigan. Awards and recognitions reflect past selections by third-party organizations and do not guarantee a similar outcome in any future matter.
      </p>
      <p class="text-[12px] text-[#98A6BB] flex items-center justify-center gap-1.5 pt-2" data-ps="src/components/Footer.astro:csfao">
        <span data-ps="src/components/Footer.astro:abywz2">Web Design and SEO by</span>
        <a href="https://twalkerco.com/" target="_blank" rel="noopener noreferrer" class="text-[#C9A840] hover:underline" data-ps="src/components/Footer.astro:7gqbzl">twalkerco</a>
      </p>
    </div>
  </div>
</footer>
