  <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(4, 16, 38, 0.97) 0%, rgba(5, 19, 45, 0.9) 46%, rgba(8, 26, 60, 0.62) 100%);"></div>
  <div class="relative max-w-[1280px] mx-auto px-6 pt-[140px] pb-[60px]">
