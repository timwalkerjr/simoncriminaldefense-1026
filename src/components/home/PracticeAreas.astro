---
const areas = [
  { n: '01', title: 'Assault Charges', body: 'Facing assault charges in Michigan can be daunting. With over 38 years of experience, Joseph A. Simon has a proven record of successfully defending assault cases. Contact us to learn more.', href: '/practice-area/assault-defense' },
  { n: '02', title: 'College Crimes', body: 'Facing criminal allegations as a college student? Contact attorney Joseph A. Simon, a trusted advocate for students in Ann Arbor and surrounding areas. Contact us for a consultation.', href: '/practice-area/college-crimes-defense' },
  { n: '03', title: 'Computer Crimes', body: "Explore how Joseph A. Simon's extensive experience in computer cases can protect you and ensure your rights. Contact us for more information.", href: '/practice-area/computer-crimes' },
  { n: '04', title: 'Criminal Sexual Conduct', body: 'If you or a loved one faces criminal sexual conduct charges, trust the experienced and aggressive defense attorney Joseph A. Simon had been providing for over 38 years. Contact us for a confidential consultation.', href: '/practice-area/sex-crime-defense' },
  { n: '05', title: 'Domestic Violence', body: 'Facing Domestic Violence charges can be overwhelming. Turn to the experienced and established practice of attorney Joseph A. Simon to protect your rights. Contact us for a consultation.', href: '/practice-area/domestic-violence-defense' },
  { n: '06', title: 'Drug Crimes', body: 'Facing drug charges in Michigan? With over 38 years of experience, Joseph A. Simon has a proven record of successfully defending drug cases. Contact us to learn more.', href: '/practice-area/drug-crimes' },
  { n: '07', title: 'Drunk Driving DUI/OWI', body: 'Facing a DUI/OWI charge in Southeast Michigan? With over 38 years of experience, Joseph A. Simon has a proven record of successfully defending OWI cases. Contact us to learn more.', href: '/practice-area/dui-defense' },
  { n: '08', title: 'Expungements', body: 'For over 38 years, Joseph A. Simon has helped individuals expunge criminal convictions in Michigan and clear criminal records. Contact us to see if you qualify for a fresh start.', href: '/practice-area/expungements' },
  { n: '09', title: 'Home Invasion', body: 'Facing serious charges like Home Invasion in Southeast Michigan? Trust the experienced attorneys at Joseph A. Simon to protect your rights. Contact us for a free consultation today.', href: '/practice-area/home-invasion-defense' },
  { n: '10', title: 'Homicide', body: "Entrust your defense to one of Ann Arbor's most experienced and acclaimed attorneys. Contact Joseph A. Simon, defending homicide cases for over 38 years.", href: '/practice-area/homicide-defense' },
  { n: '11', title: 'Malicious Destruction of Property', body: "If you're facing MDOP charges in Washtenaw County, turn to Ann Arbor's Five-Time Criminal Defense Lawyer of the Year, Joseph A. Simon, a local attoreny with over 38 years of successful criminal defense. ", href: '/practice-area/malicious-destruction-of-property' },
  { n: '12', title: 'OWI - DUI Expungements', body: "For over 35 years, Joseph A. Simon has helped clients successfully expunge convictions and clear their criminal records. Contact us today to see if you qualify for Michigan's new OWI expungement opportunities.", href: '/practice-area/owi-dui-expungements' },
  { n: '13', title: 'Police Investigations', body: 'Facing a criminal investigation? Contact Joseph A. Simon, an experienced attorney providing over 38 years of successful criminal defense. Contact us today for a consultation.', href: '/practice-area/police-investigations' },
  { n: '14', title: 'Theft Offenses', body: "Facing a theft or property crimes charge in Southeast Michigan? Joseph A. Simon has over 38 years' experience successfully defending these charges. Contact us today for a free consultation.", href: '/practice-area/theft-offenses' },
];
---
<div id="practice-areas" data-ps="src/components/home/PracticeAreas.astro:vuglat">
  <section class="bg-white py-[100px]" data-ps="src/components/home/PracticeAreas.astro:pea0bw">
    <div class="max-w-[1280px] mx-auto px-6" data-ps="src/components/home/PracticeAreas.astro:vuglau">
      <div class="mb-4" data-ps="src/components/home/PracticeAreas.astro:vuglav"><span class="inline-flex items-center text-[12px] font-bold uppercase tracking-[1.8px] text-[#732521]" data-ps="src/components/home/PracticeAreas.astro:kve2rc"><span class="w-[28px] h-[2px] bg-[#C9A840] inline-block mr-3" data-ps="src/components/home/PracticeAreas.astro:kve2rb"></span>What We Defend</span></div>
      <h2 class="text-[44px] font-black leading-[1.14] tracking-[-0.53px] text-[#061633] mb-4 max-w-[820px]" data-ps="src/components/home/PracticeAreas.astro:qjnvaz">Criminal defense in Southeast Michigan.</h2>
      <p class="text-[18.08px] leading-[31px] text-[#454F5E] max-w-[820px] mb-12" data-ps="src/components/home/PracticeAreas.astro:qwedte">From misdemeanors to serious felonies, we appear in the district and circuit courts of Southeast Michigan and examine every element of the prosecution's case.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/components/home/PracticeAreas.astro:vuglaw">
        {areas.map((a, __psIdx) => (
          <div class="border border-[#E6E2D9] p-7 rounded-[4px] bg-white hover:border-[#732521]/40 hover:shadow-md transition flex flex-col justify-between" data-ps={`src/components/home/PracticeAreas.astro:vuglax-${__psIdx}`}>
            <div data-ps={`src/components/home/PracticeAreas.astro:vuglay-${__psIdx}`}>
              <span class="text-[#C9A840] font-black text-[15px] tracking-wider block mb-3" data-ps={`src/components/home/PracticeAreas.astro:kve2ra-${__psIdx}`}>{a.n}</span>
              <h3 class="text-[19.84px] font-black text-[#061633] mb-3 leading-[1.14] tracking-[-0.24px]" data-ps={`src/components/home/PracticeAreas.astro:q2m862-${__psIdx}`}>{a.title}</h3>
              <p class="text-[15.5px] leading-[25px] text-[#454F5E] mb-5" data-ps={`src/components/home/PracticeAreas.astro:qwedtf-${__psIdx}`}>{a.body}</p>
            </div>
            <a href={a.href} class="text-[#732521] font-bold text-[12.16px] inline-flex items-center gap-1 hover:gap-2 transition-all" data-ps={`src/components/home/PracticeAreas.astro:y0caj2-${__psIdx}`}>LEARN MORE<span aria-hidden="true" data-ps={`src/components/home/PracticeAreas.astro:kve2r9-${__psIdx}`}>→</span></a>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center max-w-[680px] mx-auto" data-ps="src/components/home/PracticeAreas.astro:vuglaz">
        <p class="text-[16.5px] text-[#454F5E] leading-[26px]" data-ps="src/components/home/PracticeAreas.astro:qwedtg">Not sure if your charge is listed? We defend the full range of Michigan criminal offenses.<a href="/#contact" class="text-[#732521] font-bold border-b border-[#732521]/28 pb-0.5 hover:border-[#732521] ml-1" data-ps="src/components/home/PracticeAreas.astro:y0caj3">Discuss your case →</a></p>
      </div>
    </div>
  </section>
</div>
