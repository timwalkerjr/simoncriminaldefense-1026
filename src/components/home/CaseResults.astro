---
import {getCollection} from 'astro:content';
const results=(await getCollection('caseResults')).filter(p=>!p.data.isDraft&&!p.data.isArchived&&p.data.fieldData['feature-this-case']);
---
<section id="results" class="bg-[#061633] text-white py-[90px] border-t border-white/10">
 <div class="max-w-[1280px] mx-auto px-6"><div class="text-[#C9A840] text-[12px] font-bold tracking-widest uppercase mb-4">Courtroom Results</div><h2 class="text-[36px] sm:text-[44px] font-black mb-10">Representative case results.</h2>
 <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">{results.map(({id,data})=><article data-featured-case={id} class="border border-white/10 p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840]/40 transition">
 <div><div class="text-[12px] font-bold uppercase text-[#C9A840] tracking-wider mb-3">{data.fieldData.charges}</div><h3 class="text-[20px] font-bold mb-4">{data.fieldData.result}</h3><p class="text-[#C3CCDA] leading-[1.65] mb-6">{data.fieldData.court}</p>{data.caseDate&&<time datetime={data.caseDate}>{data.caseDate}</time>}</div><span class="border border-[#C9A840]/40 text-[#DDC582] text-[12px] px-3 py-1 rounded-[2px] self-start">Case {data.fieldData.name}</span>
 </article>)}</div>
 <div class="text-center mt-10"><a href="/case-results/" class="border border-[#C9A840]/42 text-[#DDC582] px-6 py-3 rounded-[3px] inline-block">View all case results →</a><p class="text-[13px] text-[#C3CCDA] mt-4">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p></div></div>
</section>
