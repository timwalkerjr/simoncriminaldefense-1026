---
import {getCollection} from 'astro:content';
const faqs=(await getCollection('faqs')).filter(q=>!q.data.isDraft&&!q.data.isArchived);
---
<section id="faq" class="bg-white py-[90px] border-t border-[#E6E2D9]">
 <div class="max-w-[1280px] mx-auto px-6 grid lg:grid-cols-[320px_1fr] gap-12 items-start">
  <div class="bg-[#061633] text-white p-8 rounded-[8px]"><div class="text-[#C9A840] text-[12px] uppercase tracking-widest mb-4">Questions & Answers</div><h2 class="text-[32px] font-black mb-6">Frequently Asked Questions</h2><a href="/#contact" class="block bg-[#732521] text-white p-4 rounded-[3px] text-center font-semibold">Confidential Consultation</a></div>
  <div>{faqs.map(({id,data})=><details data-faq-id={id} class="border-b border-[#E6E2D9] py-5"><summary class="text-[20px] font-bold text-[#061633] cursor-pointer">{data.fieldData.name}</summary><div class="faq-answer" set:html={data.fieldData['faq-answer']} /></details>)}</div>
 </div>
</section>
<style>.faq-answer{padding-top:20px;color:#454f5e;font-size:17px;line-height:1.8}.faq-answer :global(p){margin-bottom:18px}.faq-answer :global(a){color:#732521;text-decoration:underline}.faq-answer :global(ul){list-style:disc;padding-left:24px}.faq-answer :global(ol){list-style:decimal;padding-left:24px}</style>
