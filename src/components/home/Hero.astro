---
import {getCollection} from 'astro:content';
import home from '@/content/homepage.json';
const stats=(await getCollection('reviewStats'))[0].data.fieldData;
const quotes=(await getCollection('reviews')).filter(p=>!p.data.isDraft&&!p.data.isArchived&&p.data.fieldData['featured-review']).slice(0,4);
---

<section
  id="home"
  class="relative isolate bg-[#061633] text-[#C3CCDA] pt-[130px] pb-[44px] overflow-hidden"
  data-ps="src/components/home/Hero.astro:section"
>
  <!-- Background Courtroom Image with Gradient Overlay -->
  <div class="absolute inset-0 -z-10 overflow-hidden" data-ps="src/components/home/Hero.astro:iy4t9j">
    <img
      src="/hero-court-1.svg"
      alt="Courtroom background"
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover object-center" data-ps="src/components/home/Hero.astro:gfvoy2" />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(100deg, rgba(4, 16, 38, 0.97) 0%, rgba(5, 19, 45, 0.90) 46%, rgba(8, 26, 60, 0.62) 100%);"
     data-ps="src/components/home/Hero.astro:iy4t9k"></div>
  </div>

  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/components/home/Hero.astro:iy4t9l">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-10 lg:gap-12 items-center" data-ps="src/components/home/Hero.astro:iy4t9m">
      <!-- Left Column: Copy & CTAs -->
      <div data-ps="src/components/home/Hero.astro:iy4ta8">
        <div class="inline-flex items-center gap-2 border border-[#C9A840]/36 bg-[#C9A840]/10 text-[#DDC582] text-[11.36px] font-bold uppercase tracking-[1.5px] px-3 py-1 rounded-[2px] mb-6" data-ps="src/components/home/Hero.astro:iy4ta9">
          <svg class="w-3.5 h-3.5 text-[#C9A840]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
          </svg>
          <span data-ps="src/components/home/Hero.astro:z1i1z6">Criminal Defense Is All We Do</span>
        </div>

        <h1 class="font-heading font-black text-white leading-[1.05] tracking-[-0.6px] mb-6 text-[42px] sm:text-[46px] xl:text-[48px]" data-ps="src/components/home/Hero.astro:307k0t">
          {home.heading}
        </h1>

        <p class="text-[17px] sm:text-[19.04px] text-[#C3CCDA] leading-[1.65] mb-8 max-w-[620px]" data-ps="src/components/home/Hero.astro:6uykny">
          {home.intro}
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-2" data-ps="src/components/home/Hero.astro:iy4taa">
          <a
            href="/#contact"
            class="bg-[#732521] text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] text-center hover:bg-[#5a1c19] transition-colors border border-transparent shadow-lg"
           data-ps="src/components/home/Hero.astro:8zc04">
            Request a Confidential Consultation
          </a>

          <a
            href="tel:+17348876200"
            class="border border-white/30 text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] text-center hover:border-[#C9A840] hover:text-[#DDC582] transition-colors flex items-center justify-center gap-2"
           data-ps="src/components/home/Hero.astro:8zc05">
            <svg class="w-4 h-4 text-[#C9A840]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            <span data-ps="src/components/home/Hero.astro:z1i1z5">(734) 887-6200</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Testimonial Card Slider -->
      <div class="relative" data-ps="src/components/home/Hero.astro:iy4tab">
        <div class="bg-white/[0.07] border border-white/16 rounded-[12px] p-6 sm:p-8 backdrop-blur-sm shadow-2xl" data-ps="src/components/home/Hero.astro:iy4tac">
          <!-- Stars -->
          <div class="flex items-center gap-1 text-[#C9A840] text-[18px] mb-4" data-ps="src/components/home/Hero.astro:iy4tad">
            <span data-ps="src/components/home/Hero.astro:z1i1z4">★</span><span data-ps="src/components/home/Hero.astro:z1i1z3">★</span><span data-ps="src/components/home/Hero.astro:z1i1z2">★</span><span data-ps="src/components/home/Hero.astro:z1i1z1">★</span><span data-ps="src/components/home/Hero.astro:z1i1z0">★</span>
          </div>

          <!-- Slider Quotes -->
          <div id="hero-quote-container" class="min-h-[140px] flex flex-col justify-between" data-ps="src/components/home/Hero.astro:iy4tae">
            <div id="hero-quote-0" class="hero-quote-slide" data-ps="src/components/home/Hero.astro:iy4taf">
              <blockquote class="text-[17px] sm:text-[18px] text-white font-medium leading-[1.5] italic mb-6">{quotes[0].data.fieldData['review-short-text'] || quotes[0].data.fieldData['review-content']}</blockquote>
              <div class="flex items-center justify-between text-[13px] text-[#C3CCDA]" data-ps="src/components/home/Hero.astro:iy4tag">
                <span class="font-bold text-white" data-ps="src/components/home/Hero.astro:z1i1ye">Verified Client Review</span>
                <span class="flex items-center gap-1 opacity-80" data-ps="src/components/home/Hero.astro:z1i1yd">
                  <svg class="w-3.5 h-3.5 text-[#C9A840]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                  Client review
                </span>
              </div>
            </div>

            <div id="hero-quote-1" class="hero-quote-slide hidden" data-ps="src/components/home/Hero.astro:iy4tah">
              <blockquote class="text-[17px] sm:text-[18px] text-white font-medium leading-[1.5] italic mb-6">{quotes[1].data.fieldData['review-short-text'] || quotes[1].data.fieldData['review-content']}</blockquote>
              <div class="flex items-center justify-between text-[13px] text-[#C3CCDA]" data-ps="src/components/home/Hero.astro:ecxgf3">
                <span class="font-bold text-white" data-ps="src/components/home/Hero.astro:z1i1yc">Verified Client Review</span>
                <span class="flex items-center gap-1 opacity-80" data-ps="src/components/home/Hero.astro:z1i1yb">Client review</span>
              </div>
            </div>

            <div id="hero-quote-2" class="hero-quote-slide hidden" data-ps="src/components/home/Hero.astro:ecxgf4">
              <blockquote class="text-[17px] sm:text-[18px] text-white font-medium leading-[1.5] italic mb-6">{quotes[2].data.fieldData['review-short-text'] || quotes[2].data.fieldData['review-content']}</blockquote>
              <div class="flex items-center justify-between text-[13px] text-[#C3CCDA]" data-ps="src/components/home/Hero.astro:ecxgf5">
                <span class="font-bold text-white" data-ps="src/components/home/Hero.astro:z1i1ya">Verified Client Review</span>
                <span class="flex items-center gap-1 opacity-80" data-ps="src/components/home/Hero.astro:z1i1y9">Client review</span>
              </div>
            </div>

            <div id="hero-quote-3" class="hero-quote-slide hidden" data-ps="src/components/home/Hero.astro:ecxgf6">
              <blockquote class="text-[17px] sm:text-[18px] text-white font-medium leading-[1.5] italic mb-6">{quotes[3].data.fieldData['review-short-text'] || quotes[3].data.fieldData['review-content']}</blockquote>
              <div class="flex items-center justify-between text-[13px] text-[#C3CCDA]" data-ps="src/components/home/Hero.astro:ecxgf7">
                <span class="font-bold text-white" data-ps="src/components/home/Hero.astro:z1i1y8">Verified Client Review</span>
                <span class="flex items-center gap-1 opacity-80" data-ps="src/components/home/Hero.astro:z1i1y7">Client review</span>
              </div>
            </div>
          </div>

          <!-- Slider Pagination Dots -->
          <div class="flex items-center gap-2 mt-6 justify-center" data-ps="src/components/home/Hero.astro:ecxgf8">
            <button type="button" class="hero-dot w-2 h-2 rounded-full bg-[#C9A840] transition-all" data-index="0" aria-label="Quote 1" data-ps="src/components/home/Hero.astro:c0aysj"></button>
            <button type="button" class="hero-dot w-2 h-2 rounded-full bg-white/30 transition-all" data-index="1" aria-label="Quote 2" data-ps="src/components/home/Hero.astro:c0aysk"></button>
            <button type="button" class="hero-dot w-2 h-2 rounded-full bg-white/30 transition-all" data-index="2" aria-label="Quote 3" data-ps="src/components/home/Hero.astro:c0aysl"></button>
            <button type="button" class="hero-dot w-2 h-2 rounded-full bg-white/30 transition-all" data-index="3" aria-label="Quote 4" data-ps="src/components/home/Hero.astro:c0ayt7"></button>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Trust Bar -->
    <div class="border border-white/10 bg-white/[0.03] rounded-[4px] px-6 py-3.5 mt-12 text-[13.5px] sm:text-[14px] text-white flex flex-col md:flex-row items-center justify-between gap-4" data-ps="src/components/home/Hero.astro:ecxgf9">
      <div class="flex items-center gap-2 font-medium" data-ps="src/components/home/Hero.astro:ecxgfa">
        <span class="text-[#C9A840]" data-ps="src/components/home/Hero.astro:z1i1y6">★★★★★</span>
        <span data-ps="src/components/home/Hero.astro:z1i1y5">{stats['cumaltive-review-rating']} Google Rating · {stats['total-reviews']} Client Reviews</span>
      </div>
      <div class="flex items-center gap-2 font-medium" data-ps="src/components/home/Hero.astro:ecxgfb">
        <span class="text-[#C9A840]" data-ps="src/components/home/Hero.astro:z1i1xj">✓</span>
        <span data-ps="src/components/home/Hero.astro:z1i1xi">Michigan Super Lawyers Since 2007</span>
      </div>
      <div class="flex items-center gap-2 font-medium" data-ps="src/components/home/Hero.astro:ecxgfc">
        <span class="text-[#C9A840]" data-ps="src/components/home/Hero.astro:z1i1xh">🕒</span>
        <span>Available 24/7</span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  let currentHeroSlide = 0;
  const heroSlides = document.querySelectorAll('.hero-quote-slide');
  const heroDots = document.querySelectorAll('.hero-dot');

  function showHeroSlide(index) {
    heroSlides.forEach((s, i) => {
      s.classList.toggle('hidden', i !== index);
    });
    heroDots.forEach((d, i) => {
      if (i === index) {
        d.classList.remove('bg-white/30');
        d.classList.add('bg-[#C9A840]');
      } else {
        d.classList.remove('bg-[#C9A840]');
        d.classList.add('bg-white/30');
      }
    });
    currentHeroSlide = index;
  }

  heroDots.forEach((dot, idx) => {
    dot.addEventListener('click', () => showHeroSlide(idx));
  });

  setInterval(() => {
    const next = (currentHeroSlide + 1) % heroSlides.length;
    showHeroSlide(next);
  }, 6000);
</script>
