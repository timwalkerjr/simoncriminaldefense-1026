<script>
  const heroDots = Array.from(document.querySelectorAll<HTMLButtonElement>('.hero-dot'));
  const heroSlides = Array.from(document.querySelectorAll<HTMLElement>('.hero-quote-slide'));
  function showHeroQuote(index: number) {
    heroSlides.forEach((slide, i) => slide.classList.toggle('hidden', i !== index));
    heroDots.forEach((dot, i) => {
      dot.classList.toggle('bg-[#C9A840]', i === index);
      dot.classList.toggle('bg-white/30', i !== index);
    });
  }
  heroDots.forEach((dot, i) => dot.addEventListener('click', () => showHeroQuote(i)));
</script>
