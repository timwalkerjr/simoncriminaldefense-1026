---
import {getCollection} from 'astro:content';
const reviews=(await getCollection('reviews')).filter(p=>!p.data.isDraft&&!p.data.isArchived&&p.data.fieldData['featured-review']);
---
<section id="testimonials" class="bg-[#F7F5F1] py-[90px] border-t border-[#E6E2D9]">
 <div class="max-w-[1280px] mx-auto px-6"><div class="text-center mb-10"><div class="text-[#732521] text-[12px] font-bold uppercase tracking-widest mb-3">Client Testimonials</div><h2 class="text-[#061633] text-[36px] sm:text-[44px] font-black mb-5">Client Reviews</h2><a href="/reviews/" class="text-[#732521] font-bold underline">Read all client reviews →</a></div>
 <div id="testimonials-track" class="grid lg:grid-cols-3 gap-6">{reviews.map(({id,data})=><article data-featured-review={id} class="testimonial-card bg-white border border-[#E6E2D9] rounded-[10px] p-7 flex flex-col justify-between">
 <div><div class="text-[#987b29] text-[14px] mb-4">{data.fieldData['review-rating'] && `Rating: ${data.fieldData['review-rating']}`}</div><div class="review-copy text-[#141C28] text-[16px] leading-[1.75]" >{data.fieldData['review-short-text'] || data.fieldData['review-content']}</div></div>
 <div class="border-t border-[#E6E2D9] mt-6 pt-4 text-[13px]"><strong class="text-[#061633]">Verified Client Review</strong>{data.fieldData['date-created']&&<p class="text-[#727C8B] mt-2">{data.fieldData['date-created']}</p>}</div>
 </article>)}</div>
 <div class="flex items-center justify-center gap-5 mt-8"><button id="reviews-prev" class="w-11 h-11 bg-white border rounded-full text-[#061633] text-[24px]" aria-label="Previous reviews">‹</button><span id="reviews-position" class="text-[#596371] text-[14px]" aria-live="polite"></span><button id="reviews-next" class="w-11 h-11 bg-white border rounded-full text-[#061633] text-[24px]" aria-label="Next reviews">›</button></div>
 </div>
</section>
<style>.review-copy :global(p){margin-bottom:16px}.review-copy :global(a){color:#732521;text-decoration:underline}.testimonial-card[hidden]{display:none}</style>
<script>
const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-featured-review]'));
let page=0;
function showPage(next:number){const perPage=window.matchMedia('(min-width:1024px)').matches?3:1;const pages=Math.ceil(cards.length/perPage);page=(next+pages)%pages;cards.forEach((c,i)=>c.hidden=i<page*perPage||i>=(page+1)*perPage);const label=document.querySelector('#reviews-position');if(label)label.textContent=`${page+1} / ${pages}`;}
document.querySelector('#reviews-prev')?.addEventListener('click',()=>showPage(page-1));
document.querySelector('#reviews-next')?.addEventListener('click',()=>showPage(page+1));
window.addEventListener('resize',()=>showPage(0));showPage(0);
</script>
