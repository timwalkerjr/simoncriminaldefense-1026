---
const links = [
  { label: "Home", href: "/" },
  { label: "Practice Areas", href: "/practice-areas/" },
  { label: "Results", href: "/#results" },
  { label: "About", href: "/#about" },
  { label: "Testimonials", href: "/#testimonials" },
  { label: "FAQs", href: "/#faq" },
  { label: "Contact", href: "/#contact" }
];
---
<section class="bg-[#061633] py-[100px]">
  <div class="max-w-[1280px] mx-auto px-6 text-center">
    <div class="mb-4">
      <span class="inline-flex items-center text-[12px] font-bold uppercase tracking-[1.8px] text-[#C9A840]">
        <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block mr-3"></span>
        Consultation
      </span>
    </div>
    <h2 class="text-[44px] font-black leading-[1.14] tracking-[-0.53px] text-white mb-6 max-w-[820px] mx-auto">
      Wherever your case is heard, we'll be there.
    </h2>
    <p class="text-[18.08px] leading-[31px] text-[#C3CCDA] max-w-[680px] mx-auto mb-8">
      Tell us where you were charged and what you're facing. Your consultation is confidential and available 24/7.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mb-12">
      <a href="/#contact" class="bg-[#732521] text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] hover:bg-[#5a1c19] transition inline-flex items-center gap-2">
        Request a Confidential Consultation
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="tel:+17348876200" class="border border-white/30 text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] hover:border-[#C9A840] hover:text-[#DDC582] transition inline-flex items-center gap-2">
        Call (734) 887-6200
      </a>
    </div>
    <div class="border-t border-white/10 pt-8 mt-8">
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-3">
        {links.map((link) => (
          <a href={link.href} class="text-[14px] text-[#C3CCDA] hover:text-white transition">
            {link.label}
          </a>
        ))}
      </div>
      <div class="mt-6">
        <a href="tel:+17348876200" class="text-[#C9A840] font-bold text-[16px] hover:text-[#DDC582] transition">
          Call (734) 887-6200
        </a>
      </div>
    </div>
  </div>
</section>
