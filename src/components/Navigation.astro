---
// Navigation - transparent over hero, solid dark navy on scroll, custom wordmark
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent border-b border-white/10" data-ps="src/components/Navigation.astro:header">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/components/Navigation.astro:gqvsd7">
    <div class="flex items-center justify-between h-[74px]" data-ps="src/components/Navigation.astro:gqvsd8">
      <!-- Wordmark Logo -->
      <a href="/#home" class="flex flex-col items-center justify-center no-underline text-center group" data-ps="src/components/Navigation.astro:brand">
        <div class="flex items-center gap-1.5 text-[10px] sm:text-[11px] uppercase tracking-[1.8px] text-[#C9A840] font-semibold leading-tight" data-ps="src/components/Navigation.astro:gqvsd9">
          <span class="w-[12px] sm:w-[15px] h-[1px] bg-[#C9A840] opacity-70 inline-block" data-ps="src/components/Navigation.astro:7xpc9p"></span>
          <span data-ps="src/components/Navigation.astro:7xpc9o">LAW OFFICES OF</span>
          <span class="w-[12px] sm:w-[15px] h-[1px] bg-[#C9A840] opacity-70 inline-block" data-ps="src/components/Navigation.astro:7xpc9n"></span>
        </div>
        <span class="font-heading font-bold text-[18px] sm:text-[20px] text-white tracking-normal leading-tight group-hover:text-[#DDC582] transition-colors" data-ps="src/components/Navigation.astro:7xpc9m">
          Joseph A. Simon
        </span>
        <div class="text-[9px] sm:text-[10px] uppercase tracking-[2px] text-[#C9A840] font-semibold leading-tight" data-ps="src/components/Navigation.astro:gqvsda">
          — PLLC —
        </div>
      </a>

      <!-- Desktop Nav Links & CTAs -->
      <div class="hidden lg:flex items-center gap-6" data-ps="src/components/Navigation.astro:desktop-nav">
        <nav class="flex items-center gap-5" aria-label="Main Navigation" data-ps="src/components/Navigation.astro:m59h3e">
          <a href="/#home" class="text-[14.4px] font-semibold text-[#C3CCDA] hover:text-white no-underline transition-colors" data-ps="src/components/Navigation.astro:7vkjrb">Home</a>
          <a href="/practice-areas/" class="text-[14.4px] font-semibold text-[#C3CCDA] hover:text-white no-underline transition-colors" data-ps="src/components/Navigation.astro:7vkjrc">Practice Areas</a>
          <a href="/service-areas/" class="text-[14.4px] font-semibold text-[#C3CCDA] hover:text-white no-underline transition-colors" data-ps="src/components/Navigation.astro:service-areas-link">Service Areas</a>
          <a href="/posts/" class="text-[14.4px] font-semibold text-[#C3CCDA] hover:text-white no-underline transition-colors" data-ps="src/components/Navigation.astro:articles-link">Posts</a>
          <a href="/#testimonials" class="text-[14.4px] font-semibold text-[#C3CCDA] hover:text-white no-underline transition-colors" data-ps="src/components/Navigation.astro:7vkjrf">Testimonials</a>
          <a href="/#faq" class="text-[14.4px] font-semibold text-[#C3CCDA] hover:text-white no-underline transition-colors" data-ps="src/components/Navigation.astro:7vkjrg">FAQs</a>
        </nav>

        <div class="h-5 w-[1px] bg-white/20" data-ps="src/components/Navigation.astro:gqvsdb"></div>

        <a href="tel:+17348876200" class="flex items-center gap-2 text-[14.4px] font-bold text-white no-underline hover:text-[#DDC582] transition-colors" data-ps="src/components/Navigation.astro:7vkjrh">
          <svg class="w-4 h-4 text-[#C9A840]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span data-ps="src/components/Navigation.astro:7xpc9l">(734) 887-6200</span>
        </a>

        <a href="/#contact" class="bg-[#732521] text-white text-[14px] font-semibold px-4 py-2 rounded-[3px] no-underline hover:bg-[#5a1c19] transition-colors border border-transparent" data-ps="src/components/Navigation.astro:7vkjri">
          Confidential Consultation
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="lg:hidden p-2 text-white hover:text-[#DDC582] transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-ps="src/components/Navigation.astro:toggle-btn"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-[#061633] border-b border-white/10 shadow-2xl"
    role="navigation"
    aria-label="Mobile navigation"
   data-ps="src/components/Navigation.astro:gqvsdc">
    <div class="px-6 py-5 flex flex-col gap-3" data-ps="src/components/Navigation.astro:gqvsdd">
      <a href="/#home" class="text-[#C3CCDA] font-semibold text-[15px] py-1.5 hover:text-white transition-colors" data-ps="src/components/Navigation.astro:7vkjrj">Home</a>
      <a href="/practice-areas/" class="text-[#C3CCDA] font-semibold text-[15px] py-1.5 hover:text-white transition-colors" data-ps="src/components/Navigation.astro:7vkjrk">Practice Areas</a>
      <a href="/service-areas/" class="text-[#C3CCDA] font-semibold text-[15px] py-1.5 hover:text-white transition-colors" data-ps="src/components/Navigation.astro:mob-service-areas">Service Areas</a>
      <a href="/posts/" class="text-[#C3CCDA] font-semibold text-[15px] py-1.5 hover:text-white transition-colors" data-ps="src/components/Navigation.astro:mob-articles">Posts</a>
      <a href="/#testimonials" class="text-[#C3CCDA] font-semibold text-[15px] py-1.5 hover:text-white transition-colors" data-ps="src/components/Navigation.astro:7vkjs8">Testimonials</a>
      <a href="/#faq" class="text-[#C3CCDA] font-semibold text-[15px] py-1.5 hover:text-white transition-colors" data-ps="src/components/Navigation.astro:7vkjs9">FAQs</a>

      <div class="pt-3 border-t border-white/10 flex flex-col gap-3" data-ps="src/components/Navigation.astro:gqvsde">
        <a href="tel:+17348876200" class="flex items-center gap-2 text-white font-bold text-[16px]" data-ps="src/components/Navigation.astro:7vkjsa">
          <svg class="w-4 h-4 text-[#C9A840]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span data-ps="src/components/Navigation.astro:i2om69">(734) 887-6200</span>
        </a>
        <a href="/#contact" class="bg-[#732521] text-white text-center font-semibold text-[15px] py-2.5 rounded-[3px] hover:bg-[#5a1c19] transition-colors" data-ps="src/components/Navigation.astro:kd8n5q">
          Confidential Consultation
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const navbar = document.getElementById('navbar');
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  function updateNavbar() {
    if (window.scrollY > 30) {
      navbar?.classList.add('bg-[#061633]', 'shadow-[0_4px_20px_rgba(0,0,0,0.3)]');
      navbar?.classList.remove('bg-transparent');
    } else {
      navbar?.classList.remove('bg-[#061633]', 'shadow-[0_4px_20px_rgba(0,0,0,0.3)]');
      navbar?.classList.add('bg-transparent');
    }
  }
  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  function toggleMenu() {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
    }
  }

  mobileMenuButton?.addEventListener('click', toggleMenu);
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

