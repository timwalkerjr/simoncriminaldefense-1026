  @keyframes awards-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .awards-track {
      animation: none;
    }
    .awards-window {
      overflow-x: auto;
    }
  }
</style>

<script>
  import 'altcha';

  // Awards marquee pause / resume
  const awardsTrack = document.querySelector<HTMLElement>('[data-awards-track]');
  const awardsPause = document.querySelector<HTMLButtonElement>('[data-awards-pause]');
  awardsPause?.addEventListener('click', () => {
    if (!awardsTrack) return;
    const paused = awardsTrack.classList.toggle('is-paused');
    awardsPause.setAttribute('aria-pressed', String(paused));
    awardsPause.textContent = paused ? 'Resume scrolling' : 'Pause scrolling';
    awardsPause.setAttribute('aria-label', paused ? 'Resume awards scrolling' : 'Pause awards scrolling');
  });

  // Client reviews pager: three reviews per page
  const PAGE_SIZE = 3;
  const reviews = Array.from(document.querySelectorAll<HTMLElement>('#testimonials-track > article'));
  const pageCount = Math.max(1, Math.ceil(reviews.length / PAGE_SIZE));
  const position = document.getElementById('reviews-position');
  const prevBtn = document.getElementById('reviews-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('reviews-next') as HTMLButtonElement | null;
  let currentPage = 0;

  function showReviewPage(index: number) {
    currentPage = ((index % pageCount) + pageCount) % pageCount;
    reviews.forEach((card, i) => {
      card.hidden = Math.floor(i / PAGE_SIZE) !== currentPage;
    });
    if (position) position.textContent = `${currentPage + 1} / ${pageCount}`;
  }

  if (reviews.length > PAGE_SIZE) {
    showReviewPage(0);
    prevBtn?.addEventListener('click', () => showReviewPage(currentPage - 1));
    nextBtn?.addEventListener('click', () => showReviewPage(currentPage + 1));
  } else {
    reviews.forEach((card) => (card.hidden = false));
    prevBtn?.setAttribute('hidden', '');
    nextBtn?.setAttribute('hidden', '');
    if (position) position.textContent = '';
  }

  // Consultation form: sends through the platform email endpoint; success only after it confirms.
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !feedback || !submitBtn) return;

    const original = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    feedback.classList.add('hidden');

    const data = new FormData(form);
    const payload = {
      _formId: data.get('_formId'),
      subject: data.get('subject'),
      name: data.get('name'),
      phone: data.get('phone'),
      email: data.get('email'),
      chargeType: data.get('chargeType'),
      message: data.get('message'),
      altcha: data.get('altcha'),
    };

    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result?.success) {
        throw new Error(result?.error || 'Your request could not be sent. Please call (734) 887-6200.');
      }
      feedback.className = 'text-center text-[14px] mt-2 text-[#DDC582]';
      feedback.textContent = 'Thank you! Your consultation request has been sent.';
      form.reset();
    } catch (error) {
      feedback.className = 'text-center text-[14px] mt-2 text-[#F5B7B1]';
      feedback.textContent =
        error instanceof Error ? error.message : 'Your request could not be sent. Please call (734) 887-6200.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = original;
    }
  });
</script>
