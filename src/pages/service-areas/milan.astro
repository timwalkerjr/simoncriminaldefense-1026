    background-size: auto, cover;
    background-position: 0% 0%, 50% 50%;
  }

  [hidden] {
    display: none !important;
  }

  .awards {
    background: #f7f5f1;
    padding: 28px 0 34px;
    border-bottom: 1px solid #e6e2d9;
  }
  .awards-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 0 24px;
    margin-bottom: 20px;
  }
  .awards-heading h2 {
    font-family: var(--font-serif);
    font-size: 11.52px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(89, 99, 113);
    margin: 0;
  }
  .awards-pause {
    background: none;
    border: 1px solid #732521;
    color: #732521;
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 3px;
    cursor: pointer;
  }
  .awards-window {
    overflow: hidden;
    width: 100%;
  }
  .awards-track {
    display: flex;
    width: max-content;
    animation: awards-scroll 40s linear infinite;
  }
  .awards-track.is-paused {
    animation-play-state: paused;
  }
  .awards-list {
    display: flex;
    align-items: center;
    gap: 48px;
    list-style: none;
    margin: 0;
    padding: 0 24px;
  }
  .award-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 134px;
    height: 94px;
    flex: 0 0 auto;
  }
  .award-badge img {
    width: 134px;
    height: 94px;
    object-fit: contain;
