<style>
  .ypsi-hero {
    padding: 100px 0 80px;
    background-color: #061633;
    background-image:
      linear-gradient(100deg, rgba(4, 16, 38, 0.97), rgba(8, 26, 60, 0.86)),
      url("https://jas-law-astro-review.netlify.app/hero-court-1.webp");
    background-size: auto, cover;
    background-position: 0% 0%, 50% 50%;
    background-repeat: no-repeat;
    color: #fff;
  }
  .local-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .awards {
    padding: 28px 0 34px;
  }
  .awards-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 20px;
    padding: 0 24px;
  }
  .awards-heading h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 11.52px;
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 17.28px;
    text-transform: uppercase;
    color: #596371;
    text-align: center;
  }
  .awards-pause {
    font-size: 12px;
    line-height: 18px;
    color: #732521;
    background: transparent;
    border: 1px solid #732521;
    border-radius: 3px;
    padding: 4px 10px;
    cursor: pointer;
  }
  .awards-window {
    overflow: hidden;
  }
  .awards-track {
    display: flex;
    width: max-content;
    animation: awards-scroll 42s linear infinite;
  }
  .awards.is-paused .awards-track {
    animation-play-state: paused;
  }
  .awards-list {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .awards-list li {
    padding: 0 28px;
  }
  .award-badge {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .awards-list img {
    display: block;
    height: 94px;
    width: 134px;
    max-width: 160px;
    object-fit: contain;
  }
  @keyframes awards-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  .testimonial-card[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .awards-track {
      animation: none;
    }
    .awards-window {
      overflow-x: auto;
    }
  }
</style>

<script>
  import 'altcha';

  // Awards marquee pause / resume
  const awards = document.getElementById('awards');
  const pauseBtn = document.querySelector<HTMLButtonElement>('[data-awards-pause]');
  pauseBtn?.addEventListener('click', () => {
    const paused = awards?.classList.toggle('is-paused') ?? false;
    pauseBtn.setAttribute('aria-pressed', String(paused));
    pauseBtn.setAttribute('aria-label', paused ? 'Resume awards scrolling' : 'Pause awards scrolling');
    pauseBtn.textContent = paused ? 'Resume scrolling' : 'Pause scrolling';
  });

  // Client reviews pager: three reviews per page
  const track = document.getElementById('testimonials-track');
  const cards = track ? Array.from(track.querySelectorAll<HTMLElement>('[data-featured-review]')) : [];
  const position = document.getElementById('reviews-position');
  const prevBtn = document.getElementById('reviews-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('reviews-next') as HTMLButtonElement | null;
  const perPage = 3;
  const pageCount = Math.max(1, Math.ceil(cards.length / perPage));
  let page = 0;

  function renderReviews() {
    cards.forEach((card, i) => {
      card.hidden = Math.floor(i / perPage) !== page;
    });
    if (position) position.textContent = `${page + 1} / ${pageCount}`;
  }
  prevBtn?.addEventListener('click', () => {
    page = (page - 1 + pageCount) % pageCount;
    renderReviews();
  });
  nextBtn?.addEventListener('click', () => {
    page = (page + 1) % pageCount;
    renderReviews();
  });
  renderReviews();

  // Consultation form: show success only after the endpoint confirms delivery
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  function showFeedback(message: string, ok: boolean) {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className = `text-center text-[14px] mt-2 ${ok ? 'text-[#DDC582]' : 'text-[#F2B8B5]'}`;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }
    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _formId: data.get('_formId'),
          _subject: data.get('_subject'),
          subject: data.get('_subject'),
          name: data.get('name'),
          phone: data.get('phone'),
          email: data.get('email'),
          chargeType: data.get('chargeType'),
          message: data.get('message'),
          altcha: data.get('altcha'),
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Failed to send');
      }
      form.reset();
      showFeedback('Thank you. Your request has been sent.', true);
    } catch {
      showFeedback('Your request could not be sent. Please call (734) 887-6200.', false);
    } finally {
      if (feedback) feedback.classList.remove('hidden');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send My Case Details';
      }
    }
  });
</script>
