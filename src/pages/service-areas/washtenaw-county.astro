<style>
  .local-container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .local-hero {
    color: #fff;
    background:
      linear-gradient(100deg, rgba(4, 16, 38, 0.97), rgba(8, 26, 60, 0.86)),
      url("https://jas-law-astro-review.netlify.app/hero-court-1.webp") 50% center / cover;
    padding: 140px 0 70px;
  }

  .awards {
    background: #f7f5f1;
    padding: 28px 0 34px;
    border-bottom: 1px solid #e6e2d9;
  }
  .awards-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 18px;
    padding-inline: 24px;
  }
  .awards-heading h2 {
    font-size: 11.52px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(89, 99, 113);
    margin: 0;
  }
  .awards-pause {
    font-size: 12px;
    color: #732521;
    background: transparent;
    border: 0;
    border-bottom: 1px solid #732521;
    padding: 10px 4px;
    cursor: pointer;
  }
  .awards-window {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .awards-window::-webkit-scrollbar {
    display: none;
  }
  .awards-track {
    width: max-content;
    display: flex;
    animation: 65s linear 0s infinite normal none running awards-scroll;
  }
  .awards-list {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 32px;
    margin: 0;
    padding: 0 32px 0 0;
    list-style: none;
  }
  .awards-list li {
    flex: 0 0 134px;
    width: 134px;
  }
  .award-badge {
    display: block;
    width: 134px;
    height: 94px;
    border-radius: 4px;
  }
  .award-badge img {
    width: 134px;
    height: 94px;
    object-fit: contain;
    display: block;
  }
  a.award-badge:hover {
    background: #fff;
  }
  a.award-badge:focus-visible,
  .awards-pause:focus-visible {
    outline: 2px solid #732521;
    outline-offset: 4px;
  }
  .awards:hover .awards-track,
  .awards:focus-within .awards-track,
  .awards[data-paused] .awards-track {
    animation-play-state: paused;
  }
  @keyframes awards-scroll {
    100% {
      transform: translate(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .awards-track {
      animation: none;
    }
    .awards-list[aria-hidden],
    .awards-pause {
      display: none;
    }
  }

  .review-copy p {
    margin-bottom: 16px;
  }
  .review-copy a {
    color: #732521;
    text-decoration: underline;
  }
  .testimonial-card[hidden] {
    display: none;
  }
</style>

<script>
  import 'altcha';

  // Awards strip: pause/resume the CSS marquee without changing its timing.
  const awards = document.querySelector<HTMLElement>('.awards');
  const pauseBtn = document.querySelector<HTMLButtonElement>('.awards-pause');
  pauseBtn?.addEventListener('click', () => {
    const paused = pauseBtn.getAttribute('aria-pressed') === 'true';
    pauseBtn.setAttribute('aria-pressed', String(!paused));
    pauseBtn.textContent = paused ? 'Pause scrolling' : 'Resume scrolling';
    pauseBtn.setAttribute('aria-label', paused ? 'Pause awards scrolling' : 'Resume awards scrolling');
    if (paused) awards?.removeAttribute('data-paused');
    else awards?.setAttribute('data-paused', '');
  });

  // Client reviews: pages of three cards with previous/next controls.
  const reviewCards = Array.from(document.querySelectorAll<HTMLElement>('[data-featured-review]'));
  const reviewPrev = document.getElementById('reviews-prev') as HTMLButtonElement | null;
  const reviewNext = document.getElementById('reviews-next') as HTMLButtonElement | null;
  const reviewPosition = document.getElementById('reviews-position');
  const reviewPageSize = 3;
  const reviewPages = Math.max(1, Math.ceil(reviewCards.length / reviewPageSize));
  let reviewPage = 0;

  const renderReviews = () => {
    reviewCards.forEach((card, index) => {
      card.hidden = Math.floor(index / reviewPageSize) !== reviewPage;
    });
    if (reviewPosition) reviewPosition.textContent = `${reviewPage + 1} / ${reviewPages}`;
    if (reviewPrev) reviewPrev.disabled = reviewPage === 0;
    if (reviewNext) reviewNext.disabled = reviewPage >= reviewPages - 1;
  };
  reviewPrev?.addEventListener('click', () => {
    if (reviewPage > 0) {
      reviewPage -= 1;
      renderReviews();
    }
  });
  reviewNext?.addEventListener('click', () => {
    if (reviewPage < reviewPages - 1) {
      reviewPage += 1;
      renderReviews();
    }
  });
  renderReviews();

  // Consultation form: posts to the platform email endpoint; success shows only after confirmation.
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !feedback || !submitBtn) return;

    const originalLabel = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    feedback.classList.add('hidden');

    const data = new FormData(form);
    const payload = {
      _formId: data.get('_formId'),
      subject: data.get('_subject'),
      name: data.get('name'),
      phone: data.get('phone'),
      email: data.get('email'),
      chargeType: data.get('chargeType'),
      message: data.get('message'),
      altcha: data.get('altcha'),
    };

    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Your request could not be sent. Please call (734) 887-6200.');
      }
      feedback.className = 'text-center text-[14px] mt-2 text-[#DDC582]';
      feedback.textContent = 'Thank you! Your consultation request has been sent.';
      form.reset();
    } catch (error) {
      feedback.className = 'text-center text-[14px] mt-2 text-[#F5B7B1]';
      feedback.textContent = error instanceof Error ? error.message : 'Your request could not be sent. Please try again.';
    } finally {
      feedback.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = originalLabel;
    }
  });
</script>
