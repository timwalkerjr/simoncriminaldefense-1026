                  <div class="award-badge" data-ps={`src/pages/service-areas/saline.astro:r44myg-${__psIdx}`}>
                    <img src={award.src} alt={award.alt} width="200" height="140" loading="lazy" data-ps={`src/pages/service-areas/saline.astro:tmdrbo-${__psIdx}`} />
