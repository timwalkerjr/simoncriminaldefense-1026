            <h3 class="text-[24px] font-bold mb-3" data-ps="src/pages/service-areas/saline.astro:gpro2q">Our Ann Arbor Office</h3>
            <address class="not-italic text-[#C3CCDA] leading-[1.8]">1310 South Main Street, Suite 11<br />Ann Arbor, MI 48104</address>
            <a class="inline-block text-white font-bold underline mt-5" href="https://www.google.com/maps/dir/?api=1&destination=1310+South+Main+Street+Suite+11+Ann+Arbor+MI+48104" target="_blank" rel="noopener" data-ps="src/pages/service-areas/saline.astro:aaa7ei">Directions to our office →</a>
          </div>
        </div>
        <div data-ps="src/pages/service-areas/saline.astro:r44mxm">
          <h2 class="text-[#061633] text-[28px] font-bold mb-5" data-ps="src/pages/service-areas/saline.astro:21cqv0">Serving Saline</h2>
          <iframe title="Map of Saline, Michigan service area" src="https://maps.google.com/maps?q=Saline%2C%20Michigan&output=embed" width="100%" height="410" loading="lazy" class="rounded-[5px] border border-[#E6E2D9]" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <p class="text-[#596371] text-[14px] mt-3" data-ps="src/pages/service-areas/saline.astro:6b1don">Service area: Saline, Michigan. Our office is in Ann Arbor.</p>
        </div>
      </div>
    </section>

    <section id="results" class="bg-[#061633] text-white py-[90px] border-t border-white/10" data-ps="src/pages/service-areas/saline.astro:w38j0x">
      <div class="max-w-[1280px] mx-auto px-6" data-ps="src/pages/service-areas/saline.astro:r44mxl">
