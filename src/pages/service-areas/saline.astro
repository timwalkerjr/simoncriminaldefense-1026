<style>
  .local-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .local-hero {
    background-color: transparent;
    background-image:
      linear-gradient(100deg, rgba(4, 16, 38, 0.97), rgba(8, 26, 60, 0.86)),
      url("https://jas-law-astro-review.netlify.app/hero-court-1.webp");
    background-size: auto, cover;
    background-position: 0% 0%, 50% 50%;
    color: #fff;
    padding: 128px 0 88px;
  }

  .awards {
    background: #f7f5f1;
    padding: 28px 0 34px;
    border-bottom: 1px solid #e6e2d9;
  }
  .awards-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 20px;
    margin-bottom: 20px;
    padding: 0 24px;
  }
  .awards-heading h2 {
    font-family: var(--font-serif);
    font-size: 11.52px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #596371;
    margin: 0;
  }
  .awards-pause {
    font-size: 12px;
    line-height: 18px;
    color: #732521;
    background: transparent;
    border: 1px solid #732521;
    border-radius: 3px;
    padding: 4px 10px;
    cursor: pointer;
  }
  .awards-window {
    overflow: hidden;
  }
  .awards-track {
    display: flex;
    width: max-content;
    animation: awards-scroll 60s linear infinite;
  }
  .awards-track.is-paused {
    animation-play-state: paused;
  }
  .awards-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
  }
  .awards-list li {
    padding: 0 24px;
  }
  .award-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 134px;
    height: 94px;
  }
  .award-badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @keyframes awards-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .testimonial-card[hidden] {
    display: none;
  }
  .review-nav:disabled {
    opacity: 0.4;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .awards-track {
      animation: none;
    }
  }
</style>

<script>
  import 'altcha';

  // Awards ticker pause/resume
  const pauseBtn = document.querySelector<HTMLButtonElement>('.awards-pause');
  const awardsTrack = document.querySelector<HTMLElement>('.awards-track');
  pauseBtn?.addEventListener('click', () => {
    const wasPaused = pauseBtn.getAttribute('aria-pressed') === 'true';
    const nowPaused = !wasPaused;
    pauseBtn.setAttribute('aria-pressed', String(nowPaused));
    pauseBtn.textContent = nowPaused ? 'Resume scrolling' : 'Pause scrolling';
    pauseBtn.setAttribute('aria-label', nowPaused ? 'Resume awards scrolling' : 'Pause awards scrolling');
    awardsTrack?.classList.toggle('is-paused', nowPaused);
  });

  // Client review pager: 3 reviews per page, 2 pages
  const reviewCards = Array.from(document.querySelectorAll<HTMLElement>('[data-featured-review]'));
  const reviewsPerPage = 3;
  const reviewPages = Math.max(1, Math.ceil(reviewCards.length / reviewsPerPage));
  const prevBtn = document.getElementById('reviews-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('reviews-next') as HTMLButtonElement | null;
  const positionEl = document.getElementById('reviews-position');
  let reviewPage = 0;

  function renderReviews() {
    reviewCards.forEach((card, index) => {
      card.hidden = Math.floor(index / reviewsPerPage) !== reviewPage;
    });
    if (positionEl) positionEl.textContent = `${reviewPage + 1} / ${reviewPages}`;
    if (prevBtn) prevBtn.disabled = reviewPage === 0;
    if (nextBtn) nextBtn.disabled = reviewPage >= reviewPages - 1;
  }

  prevBtn?.addEventListener('click', () => {
    if (reviewPage > 0) {
      reviewPage -= 1;
      renderReviews();
    }
  });
  nextBtn?.addEventListener('click', () => {
    if (reviewPage < reviewPages - 1) {
      reviewPage += 1;
      renderReviews();
    }
  });
  renderReviews();

  // Consultation form: send through the platform endpoint; success only after confirmation
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  function showFeedback(message: string, tone: 'ok' | 'error') {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className =
      'text-center text-[14px] mt-2 ' + (tone === 'ok' ? 'text-[#DDC582]' : 'text-[#F5B7B1]');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const payload = {
      _formId: data.get('_formId'),
      subject: data.get('subject'),
      name: data.get('name'),
      phone: data.get('phone'),
      email: data.get('email'),
      chargeType: data.get('chargeType'),
      message: data.get('message'),
      altcha: data.get('altcha'),
    };

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }

    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) {
        throw new Error('not sent');
      }
      form.reset();
      showFeedback('Thank you! Your request has been sent. We will be in touch shortly.', 'ok');
    } catch {
      showFeedback('We could not send your request. Please try again or call (734) 887-6200.', 'error');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send My Case Details';
      }
    }
  });
</script>
