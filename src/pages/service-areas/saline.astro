              <div data-ps={`src/pages/service-areas/saline.astro:r44mwx-${__psIdx}`}>
                <div class="text-[12px] font-bold uppercase text-[#C9A840] tracking-wider mb-3" data-ps={`src/pages/service-areas/saline.astro:r44mww-${__psIdx}`}>{result.category}</div>
                <h3 class="text-[20px] font-bold mb-4" data-ps={`src/pages/service-areas/saline.astro:gpro2p-${__psIdx}`}>{result.title}</h3>
                <p class="text-[#C3CCDA] leading-[1.65] mb-6" data-ps={`src/pages/service-areas/saline.astro:6b1doo-${__psIdx}`}>{result.court}</p>
              </div>
              <span class="border border-[#C9A840]/40 text-[#DDC582] text-[12px] px-3 py-1 rounded-[2px] self-start" data-ps={`src/pages/service-areas/saline.astro:wzuqs3-${__psIdx}`}>{result.caseNo}</span>
            </article>
          ))}
        </div>
        <div class="text-center mt-10" data-ps="src/pages/service-areas/saline.astro:r44mwv">
          <a href="/courtroom-victories" class="border border-[#C9A840]/42 text-[#DDC582] px-6 py-3 rounded-[3px] inline-block" data-ps="src/pages/service-areas/saline.astro:aaa7eh">View all case results →</a>
          <p class="text-[13px] text-[#C3CCDA] mt-4" data-ps="src/pages/service-areas/saline.astro:6b1dop">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
        </div>
      </div>
    </section>

    <section id="testimonials" class="bg-[#F7F5F1] py-[90px] border-t border-[#E6E2D9]" data-ps="src/pages/service-areas/saline.astro:w38j0y">
