<style>
  .awards-window {
    overflow: hidden;
  }
  .awards-track {
    display: flex;
    width: max-content;
    animation: awards-scroll 45s linear infinite;
  }
  .awards.is-paused .awards-track {
    animation-play-state: paused;
  }
  .awards-list {
    display: flex;
    align-items: center;
    gap: 48px;
    list-style: none;
    margin: 0;
    padding: 0 24px;
  }
  .award-badge {
    display: block;
  }
  .award-badge img {
    display: block;
    height: 94px;
    width: auto;
    max-width: none;
    object-fit: contain;
  }
  @keyframes awards-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .awards-track {
      animation: none;
    }
    .awards-window {
      overflow-x: auto;
    }
  }
</style>

<script>
  import 'altcha';

  // Rating marquee: pause / resume.
  const awards = document.getElementById('awards');
  const pauseBtn = document.querySelector<HTMLButtonElement>('.awards-pause');
  pauseBtn?.addEventListener('click', () => {
    const paused = pauseBtn.getAttribute('aria-pressed') === 'true';
    const nowPaused = !paused;
    pauseBtn.setAttribute('aria-pressed', String(nowPaused));
    pauseBtn.textContent = nowPaused ? 'Resume scrolling' : 'Pause scrolling';
    pauseBtn.setAttribute('aria-label', nowPaused ? 'Resume awards scrolling' : 'Pause awards scrolling');
    awards?.classList.toggle('is-paused', nowPaused);
  });

  // Client reviews: two pages (3 + 2), prev/next with a position counter.
  const reviews = Array.from(document.querySelectorAll<HTMLElement>('[data-featured-review]'));
  const PAGE_SIZE = 3;
  const pageCount = Math.max(1, Math.ceil(reviews.length / PAGE_SIZE));
  const prevBtn = document.getElementById('reviews-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('reviews-next') as HTMLButtonElement | null;
  const position = document.getElementById('reviews-position');
  let reviewPage = 0;

  function renderReviews() {
    reviews.forEach((card, i) => {
      card.hidden = Math.floor(i / PAGE_SIZE) !== reviewPage;
    });
    if (position) position.textContent = `${reviewPage + 1} / ${pageCount}`;
    if (prevBtn) prevBtn.disabled = reviewPage === 0;
    if (nextBtn) nextBtn.disabled = reviewPage >= pageCount - 1;
  }
  prevBtn?.addEventListener('click', () => {
    reviewPage = Math.max(0, reviewPage - 1);
    renderReviews();
  });
  nextBtn?.addEventListener('click', () => {
    reviewPage = Math.min(pageCount - 1, reviewPage + 1);
    renderReviews();
  });
  renderReviews();

  // Consultation form: posts to the platform email endpoint; success only after confirmation.
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !feedback || !submitBtn) return;
    const data = new FormData(form);
    const originalLabel = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    feedback.className = 'text-center text-[14px] mt-2';
    feedback.textContent = '';

    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _formId: data.get('_formId'),
          subject: data.get('subject'),
          name: data.get('name'),
          phone: data.get('phone'),
          email: data.get('email'),
          chargeType: data.get('chargeType'),
          message: data.get('message'),
          altcha: data.get('altcha'),
        }),
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result?.success) {
        throw new Error(result?.error || 'Failed to send');
      }
      form.reset();
      feedback.className = 'text-center text-[14px] mt-2 text-[#DDC582]';
      feedback.textContent = 'Thank you! Your message has been sent.';
    } catch {
      feedback.className = 'text-center text-[14px] mt-2 text-[#F5B7B1]';
      feedback.textContent = 'Your message could not be sent. Please call (734) 887-6200 and try again.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalLabel;
    }
  });
</script>
