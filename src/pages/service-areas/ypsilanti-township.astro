---

<BaseLayout headerVariant="transparent" title={title} description={description}>
  <main data-ps="src/pages/service-areas/ypsilanti-township.astro:3aggpw">
    <section class="ypsi-hero relative overflow-hidden text-white" data-ps="src/pages/service-areas/ypsilanti-township.astro:geuq3e">
      <div class="relative z-10 max-w-[1280px] mx-auto px-6 pt-[150px] pb-[110px]" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs2j">
        <nav class="flex flex-wrap gap-3 text-[13px] text-[#C3CCDA] mb-8" aria-label="Breadcrumb" data-ps="src/pages/service-areas/ypsilanti-township.astro:v9xkda">
          <a href="/" class="hover:text-white" data-ps="src/pages/service-areas/ypsilanti-township.astro:if64of">Home</a>
          <span data-ps="src/pages/service-areas/ypsilanti-township.astro:lnxkq5">/</span>
          <a href="/service-areas" class="hover:text-white" data-ps="src/pages/service-areas/ypsilanti-township.astro:if64oe">Service Areas</a>
          <span data-ps="src/pages/service-areas/ypsilanti-township.astro:lnxkq4">/</span>
          <span data-ps="src/pages/service-areas/ypsilanti-township.astro:lnxkq3">Ypsilanti Township</span>
        </nav>
        <div class="text-[#C9A840] uppercase tracking-[1.8px] font-bold text-[12px] mb-5" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs2k">
          Serving Ypsilanti Township, Michigan
        </div>
        <h1 class="text-[36px] sm:text-[52px] lg:text-[62px] font-black leading-[1.1] max-w-[950px]" data-ps="src/pages/service-areas/ypsilanti-township.astro:qh3ajt">
          Criminal Defense in Ypsilanti Township
        </h1>
        <p class="text-[18px] sm:text-[21px] text-[#C3CCDA] leading-[1.75] mt-7 max-w-[900px]" data-ps="src/pages/service-areas/ypsilanti-township.astro:sygr6j">
          If you're facing DUI/OWI charges in Ypsilanti Township, trust the over 38 years of experience of local
          attorney Joseph A. Simon to protect your rights and guide you through the legal process. Contact us today.
        </p>
        <div class="flex flex-wrap gap-4 mt-9" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs2l">
          <a href="#contact" class="bg-[#732521] text-white px-7 py-4 rounded-[3px] font-bold hover:bg-[#581b19] transition" data-ps="src/pages/service-areas/ypsilanti-township.astro:if64od">
            Confidential Consultation
          </a>
          <a href="tel:+17348876200" class="border border-white/30 text-white px-7 py-4 rounded-[3px] font-bold hover:border-white/60 transition" data-ps="src/pages/service-areas/ypsilanti-township.astro:if64oc">
            (734) 887-6200
          </a>
        </div>
        <p class="text-[#C3CCDA] text-[14px] mt-6" data-ps="src/pages/service-areas/ypsilanti-township.astro:sygr6k">Ann Arbor office · Serving Ypsilanti Township</p>
      </div>
    </section>

    <section id="awards" class="bg-[#F7F5F1] pt-7 pb-[34px] border-b border-[#E6E2D9]" aria-labelledby="awards-heading" data-ps="src/pages/service-areas/ypsilanti-township.astro:geuq3d">
      <div class="max-w-[1280px] mx-auto px-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 mb-5" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs2m">
        <h2 id="awards-heading" class="font-heading text-[11.52px] font-bold uppercase tracking-[2px] text-[#596371] text-center" data-ps="src/pages/service-areas/ypsilanti-township.astro:tvlu6y">
          Recognized by third-party rating organizations
        </h2>
        <button
          type="button"
          class="awards-pause text-[12px] text-[#732521] border border-[#732521] px-3 py-1 rounded-[2px] bg-transparent cursor-pointer"
          aria-pressed="false"
          aria-label="Pause awards scrolling"
          data-awards-toggle
         data-ps="src/pages/service-areas/ypsilanti-township.astro:djomcq">
          Pause scrolling
        </button>
      </div>
      <div class="awards-window" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs2n">
        <div class="awards-track" data-awards-track data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs2o">
          <ul class="awards-list">
            {
              awards.map((a, __psIdx) => (
                <li class="awards-item" data-ps={`src/pages/service-areas/ypsilanti-township.astro:q1efjo-${__psIdx}`}>
                  {a.href ? (
                    <a class="award-badge" href={a.href} target="_blank" rel="noopener noreferrer" data-ps={`src/pages/service-areas/ypsilanti-township.astro:if64nq-${__psIdx}`}>
                      <img src={a.src} alt={a.alt} width="134" height="94" loading="lazy" class="h-[94px] w-[134px] object-contain" data-ps={`src/pages/service-areas/ypsilanti-township.astro:qxanpg-${__psIdx}`} />
                    </a>
                  ) : (
                    <div class="award-badge" data-ps={`src/pages/service-areas/ypsilanti-township.astro:tfjs2p-${__psIdx}`}>
                      <img src={a.src} alt={a.alt} width="134" height="94" loading="lazy" class="h-[94px] w-[134px] object-contain" data-ps={`src/pages/service-areas/ypsilanti-township.astro:qxanph-${__psIdx}`} />
                    </div>
                  )}
                </li>
              ))
            }
          </ul>
          <ul class="awards-list" aria-hidden="true" inert>
            {
              awards.map((a, __psIdx) => (
                <li class="awards-item" data-ps={`src/pages/service-areas/ypsilanti-township.astro:q1efjp-${__psIdx}`}>
                  {a.href ? (
                    <a class="award-badge" href={a.href} target="_blank" rel="noopener noreferrer" tabindex="-1" data-ps={`src/pages/service-areas/ypsilanti-township.astro:if64np-${__psIdx}`}>
                      <img src={a.src} alt="" width="134" height="94" loading="lazy" class="h-[94px] w-[134px] object-contain" data-ps={`src/pages/service-areas/ypsilanti-township.astro:qxanpi-${__psIdx}`} />
                    </a>
                  ) : (
                    <div class="award-badge" data-ps={`src/pages/service-areas/ypsilanti-township.astro:tfjs2q-${__psIdx}`}>
                      <img src={a.src} alt="" width="134" height="94" loading="lazy" class="h-[94px] w-[134px] object-contain" data-ps={`src/pages/service-areas/ypsilanti-township.astro:qxanpj-${__psIdx}`} />
                    </div>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="bg-[#F7F5F1] py-20 border-b border-[#E6E2D9]" id="local-practices" data-ps="src/pages/service-areas/ypsilanti-township.astro:geuq3c">
      <div class="max-w-[1280px] mx-auto px-6" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs3c">
        <div class="text-[#732521] uppercase tracking-widest font-bold text-[12px] mb-4" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs3d">Local Legal Services</div>
        <h2 class="text-[#061633] text-[32px] sm:text-[44px] font-black mb-5" data-ps="src/pages/service-areas/ypsilanti-township.astro:tvlu6z">Defense services for Ypsilanti Township</h2>
        <p class="text-[#454F5E] text-[18px] leading-[1.8] max-w-[1000px] mb-10" data-ps="src/pages/service-areas/ypsilanti-township.astro:sygr6l">
          Ford Lake and its surrounding parks are prominent features of Ypsilanti Township, including Ford Lake Park on
          South Huron River Drive and Ford Heritage Park on Textile Road. This page focuses on the township, separately
          from the City of Ypsilanti, and connects you with local DUI/OWI, assault, domestic violence, and expungement
          information.
        </p>
        <div class="grid md:grid-cols-2 gap-6" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs3e">
          {
            practiceAreas.map((p, __psIdx) => (
              <article class="bg-white border border-[#E6E2D9] rounded-[5px] p-7 sm:p-9 flex flex-col" data-ps={`src/pages/service-areas/ypsilanti-township.astro:ecxq9n-${__psIdx}`}>
                <h3 class="font-heading text-[#061633] text-[25px] font-bold mb-5" data-ps={`src/pages/service-areas/ypsilanti-township.astro:f76wza-${__psIdx}`}>{p.title}</h3>
                <p class="text-[#454F5E] text-[17px] leading-[1.8] mb-7" data-ps={`src/pages/service-areas/ypsilanti-township.astro:sygr6m-${__psIdx}`}>{p.summary}</p>
                <a href={p.href} class="text-[#732521] font-bold mt-auto" data-ps={`src/pages/service-areas/ypsilanti-township.astro:if64no-${__psIdx}`}>{p.cta}</a>
              </article>
            ))
          }
        </div>
        <a href="/practice-areas" class="inline-block mt-8 text-[#732521] font-bold underline" data-ps="src/pages/service-areas/ypsilanti-township.astro:if64nn">View all practice areas</a>
      </div>
    </section>

    <section class="bg-white py-20" data-ps="src/pages/service-areas/ypsilanti-township.astro:geuq3b">
      <div class="max-w-[1280px] mx-auto px-6 grid lg:grid-cols-2 gap-12 items-start" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs3f">
        <div data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs3g">
          <div class="text-[#732521] uppercase tracking-widest font-bold text-[12px] mb-4" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs3h">
            Law Offices of Joseph A. Simon
          </div>
          <h2 class="text-[#061633] text-[32px] sm:text-[40px] font-black mb-6" data-ps="src/pages/service-areas/ypsilanti-township.astro:tvlu70">Criminal defense is all we do.</h2>
          <p class="text-[#454F5E] text-[18px] leading-[1.8] mb-7" data-ps="src/pages/service-areas/ypsilanti-township.astro:sygr6n">
            The Law Offices of Joseph A. Simon is a full-service law firm handling only criminal defense matters,
            misdemeanor and felony, from traffic offenses to homicide cases.
          </p>
          <a href="/attorneys/joseph-a-simon" class="text-[#732521] font-bold underline" data-ps="src/pages/service-areas/ypsilanti-township.astro:if64nm">About Joseph A. Simon →</a>
          <div class="bg-[#061633] text-white p-7 rounded-[5px] mt-9" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs3i">
            <h3 class="font-heading text-[24px] font-bold mb-3" data-ps="src/pages/service-areas/ypsilanti-township.astro:f76wzb">Our Ann Arbor Office</h3>
            <address class="not-italic text-[#C3CCDA] leading-[1.8]">
              1310 South Main Street, Suite 11<br />Ann Arbor, MI 48104
            </address>
            <a
              class="inline-block text-white font-bold underline mt-5"
              href="https://www.google.com/maps/dir/?api=1&destination=1310+South+Main+Street+Suite+11+Ann+Arbor+MI+48104"
              target="_blank"
              rel="noopener"
             data-ps="src/pages/service-areas/ypsilanti-township.astro:if64nl">
              Directions to our office →
            </a>
          </div>
        </div>
        <div data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs3j">
          <h2 class="font-heading text-[#061633] text-[28px] font-bold mb-5" data-ps="src/pages/service-areas/ypsilanti-township.astro:tvlu71">Serving Ypsilanti Township</h2>
          <iframe
            title="Map of Ypsilanti Township, Michigan service area"
            src="https://maps.google.com/maps?q=Ypsilanti%20Township%2C%20Michigan&output=embed"
            width="100%"
            height="410"
            loading="lazy"
            class="rounded-[5px] border border-[#E6E2D9] w-full"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <p class="text-[#596371] text-[14px] mt-3" data-ps="src/pages/service-areas/ypsilanti-township.astro:sygr6o">
            Service area: Ypsilanti Township, Michigan. Our office is in Ann Arbor.
          </p>
        </div>
      </div>
    </section>

    <section id="results" class="bg-[#061633] text-white py-[90px] border-t border-white/10" data-ps="src/pages/service-areas/ypsilanti-township.astro:geuq3a">
      <div class="max-w-[1280px] mx-auto px-6" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs3k">
        <div class="text-[#C9A840] text-[12px] font-bold tracking-widest uppercase mb-4" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs3l">Courtroom Results</div>
        <h2 class="font-heading text-[36px] sm:text-[44px] font-black mb-10" data-ps="src/pages/service-areas/ypsilanti-township.astro:tvlu7n">Representative case results.</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs47">
          {
            cases.map((c, __psIdx) => (
              <article class="border border-white/10 p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840]/40 transition" data-ps={`src/pages/service-areas/ypsilanti-township.astro:ecxq9m-${__psIdx}`}>
                <div data-ps={`src/pages/service-areas/ypsilanti-township.astro:tfjs48-${__psIdx}`}>
                  <div class="text-[12px] font-bold uppercase text-[#C9A840] tracking-wider mb-3" set:html={c.category} />
                  <h3 class="font-heading text-[20px] font-bold mb-4" data-ps={`src/pages/service-areas/ypsilanti-township.astro:f76wzc-${__psIdx}`}>{c.title}</h3>
                  <p class="text-[#C3CCDA] leading-[1.65] mb-6" data-ps={`src/pages/service-areas/ypsilanti-township.astro:sygr6p-${__psIdx}`}>{c.court}</p>
                </div>
                <span class="border border-[#C9A840]/40 text-[#DDC582] text-[12px] px-3 py-1 rounded-[2px] self-start" data-ps={`src/pages/service-areas/ypsilanti-township.astro:lnxkq2-${__psIdx}`}>
                  {c.caseNumber}
                </span>
              </article>
            ))
          }
        </div>
        <div class="text-center mt-10" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs49">
          <a href="/courtroom-victories" class="border border-[#C9A840]/40 text-[#DDC582] px-6 py-3 rounded-[3px] inline-block hover:border-[#C9A840] transition" data-ps="src/pages/service-areas/ypsilanti-township.astro:if64nk">
            View all case results →
          </a>
          <p class="text-[13px] text-[#C3CCDA] mt-4" data-ps="src/pages/service-areas/ypsilanti-township.astro:sygr6q">
            Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.
          </p>
        </div>
      </div>
    </section>

    <section id="testimonials" class="bg-[#F7F5F1] py-[90px] border-t border-[#E6E2D9]" data-ps="src/pages/service-areas/ypsilanti-township.astro:geuq39">
      <div class="max-w-[1280px] mx-auto px-6" data-ps="src/pages/service-areas/ypsilanti-township.astro:tfjs4a">
