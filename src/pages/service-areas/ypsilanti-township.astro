<style>
  .ypsi-hero {
    background-color: #061633;
    background-image:
      linear-gradient(100deg, rgba(4, 16, 38, 0.97) 0%, rgba(8, 26, 60, 0.86) 100%),
      url('https://jas-law-astro-review.netlify.app/hero-court-1.webp');
    background-size: auto, cover;
    background-position: 0% 0%, 50% 50%;
  }

  .awards-window {
    overflow: hidden;
  }
  .awards-track {
    display: flex;
    width: max-content;
    animation: awards-scroll 40s linear infinite;
  }
  .awards-track.is-paused {
    animation-play-state: paused;
  }
  .awards-list {
    display: flex;
    gap: 48px;
    padding: 0 24px 0 0;
    margin: 0;
    list-style: none;
    align-items: center;
  }
  .awards-item {
    flex: 0 0 auto;
  }
  .award-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }
  @keyframes awards-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .awards-track {
      animation: none;
    }
    .awards-window {
      overflow-x: auto;
    }
  }

  #consultation-form input:focus-visible,
  #consultation-form select:focus-visible,
  #consultation-form textarea:focus-visible {
    outline: 2px solid #c9a840;
    outline-offset: 2px;
  }
</style>

<script>
  import 'altcha';

  // Awards marquee pause/resume
  const awardsTrack = document.querySelector<HTMLElement>('[data-awards-track]');
  const awardsToggle = document.querySelector<HTMLButtonElement>('[data-awards-toggle]');
  if (awardsTrack && awardsToggle) {
    awardsToggle.addEventListener('click', () => {
      const paused = !awardsTrack.classList.contains('is-paused');
      awardsTrack.classList.toggle('is-paused', paused);
      awardsToggle.setAttribute('aria-pressed', String(paused));
      awardsToggle.textContent = paused ? 'Resume scrolling' : 'Pause scrolling';
      awardsToggle.setAttribute('aria-label', paused ? 'Resume awards scrolling' : 'Pause awards scrolling');
    });
  }

  // Client reviews pager: two pages of up to three reviews
  const reviewCards = Array.from(document.querySelectorAll<HTMLElement>('[data-review]'));
  const perPage = 3;
  const pageCount = Math.max(1, Math.ceil(reviewCards.length / perPage));
  const prevBtn = document.getElementById('reviews-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('reviews-next') as HTMLButtonElement | null;
  const position = document.getElementById('reviews-position');
  let currentPage = 0;

  function showReviewPage(page: number) {
    currentPage = (page + pageCount) % pageCount;
    reviewCards.forEach((card, i) => {
      const start = currentPage * perPage;
      card.hidden = i < start || i >= start + perPage;
    });
    if (position) position.textContent = `${currentPage + 1} / ${pageCount}`;
  }

  if (reviewCards.length && prevBtn && nextBtn) {
    prevBtn.addEventListener('click', () => showReviewPage(currentPage - 1));
    nextBtn.addEventListener('click', () => showReviewPage(currentPage + 1));
    showReviewPage(0);
  }

  // Consultation form: posts to the platform email handler; success only after the endpoint confirms
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  function showFeedback(message: string, tone: 'success' | 'error') {
    if (!feedback) return;
    feedback.className =
      tone === 'success'
        ? 'text-center text-[14px] mt-2 text-green-300'
        : 'text-center text-[14px] mt-2 text-red-300';
    feedback.textContent = message;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const originalLabel = submitBtn?.textContent ?? 'Send My Case Details';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }
    if (feedback) feedback.classList.remove('hidden');

    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _formId: data.get('_formId'),
          subject: data.get('subject'),
          name: data.get('name'),
          phone: data.get('phone'),
          email: data.get('email'),
          chargeType: data.get('chargeType'),
          message: data.get('message'),
          altcha: data.get('altcha'),
        }),
      });
      const result = await response.json().catch(() => null);
      if (!response.ok || !result?.success) {
        throw new Error(result?.error || 'Your message could not be sent. Please call (734) 887-6200.');
      }
      showFeedback('Thank you! Your message has been sent.', 'success');
      form.reset();
    } catch (err) {
      showFeedback(
        err instanceof Error ? err.message : 'Your message could not be sent. Please call (734) 887-6200.',
        'error',
      );
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    }
  });
</script>
