<style>
  .local-hero {
    background-image: linear-gradient(100deg, rgba(4, 16, 38, 0.97), rgba(8, 26, 60, 0.86)),
      url('https://jas-law-astro-review.netlify.app/hero-court-1.webp');
    background-size: auto, cover;
    background-position: 0% 0%, 50% 50%;
    background-color: #061532;
  }
  .local-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .awards-window {
    overflow: hidden;
  }
  .awards-track {
    display: flex;
    width: max-content;
    animation: awards-scroll 45s linear infinite;
  }
  .awards[data-paused='true'] .awards-track {
    animation-play-state: paused;
  }
  .awards-list {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0 12px;
  }
  .award-badge {
    display: block;
    width: 134px;
    height: 94px;
  }
  .award-badge img {
    width: 134px;
    height: 94px;
    object-fit: contain;
  }
  @keyframes awards-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .awards-track {
      animation: none;
    }
    .awards-window {
      overflow-x: auto;
    }
  }
</style>

<script>
  import 'altcha';

  // Awards strip: pause / resume the scrolling row.
  const awardsSection = document.getElementById('awards');
  const pauseButton = document.querySelector<HTMLButtonElement>('.awards-pause');
  pauseButton?.addEventListener('click', () => {
    const paused = pauseButton.getAttribute('aria-pressed') === 'true';
    pauseButton.setAttribute('aria-pressed', String(!paused));
    pauseButton.setAttribute('aria-label', paused ? 'Pause awards scrolling' : 'Resume awards scrolling');
    pauseButton.textContent = paused ? 'Pause scrolling' : 'Resume scrolling';
    awardsSection?.setAttribute('data-paused', String(!paused));
  });

  // Client reviews: two pages of up to three reviews.
  const reviewCards = Array.from(document.querySelectorAll<HTMLElement>('#testimonials-track > article'));
  const reviewPages = [
    [0, 1, 2],
    [3, 4],
  ];
  const reviewPosition = document.getElementById('reviews-position');
  let reviewPage = 0;
  const renderReviews = () => {
    const visible = reviewPages[reviewPage];
    reviewCards.forEach((card, index) => {
      card.hidden = !visible.includes(index);
    });
    if (reviewPosition) reviewPosition.textContent = `${reviewPage + 1} / ${reviewPages.length}`;
  };
  document.getElementById('reviews-prev')?.addEventListener('click', () => {
    reviewPage = (reviewPage - 1 + reviewPages.length) % reviewPages.length;
    renderReviews();
  });
  document.getElementById('reviews-next')?.addEventListener('click', () => {
    reviewPage = (reviewPage + 1) % reviewPages.length;
    renderReviews();
  });
  renderReviews();

  // Consultation form: posts to the platform email handler; success shows only after the endpoint confirms.
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  const showFeedback = (message: string, ok: boolean) => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className = `text-center text-[14px] mt-2 ${ok ? 'text-[#DDC582]' : 'text-[#F2B8B5]'}`;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }
    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _formId: data.get('_formId'),
          subject: data.get('subject'),
          name: data.get('name'),
          email: data.get('email'),
          phone: data.get('phone'),
          chargeType: data.get('chargeType'),
          message: data.get('message'),
          altcha: data.get('altcha'),
        }),
      });
      const result = await response.json().catch(() => null);
      if (response.ok && result?.success) {
        form.reset();
        showFeedback('Thank you. Your consultation request has been sent.', true);
      } else {
        throw new Error('send failed');
      }
    } catch {
      showFeedback('We could not send your request. Please call (734) 887-6200.', false);
    } finally {
      if (feedback) feedback.classList.remove('hidden');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send My Case Details';
      }
    }
  });
</script>
