        <p data-local-info class="text-[#454F5E] text-[18px] leading-[1.8] max-w-[1000px] mb-10" data-ps="src/pages/service-areas/pittsfield-township.astro:tyosk1">
          Pittsfield Township’s community spaces include Lillie Park on Platt Road, with trails, picnic areas, playgrounds, and soccer fields. The guides below focus specifically on criminal defense matters in Pittsfield Township, including DUI/OWI, assault, domestic violence, and OWI/DUI expungements. The firm serves township clients from its office on South Main Street in Ann Arbor.
        </p>
        <div class="grid md:grid-cols-2 gap-6" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvws">
          {practiceAreas.map((area, __psIdx) => (
            <article class="bg-white border border-[#E6E2D9] rounded-[5px] p-7 sm:p-9 flex flex-col" data-ps={`src/pages/service-areas/pittsfield-township.astro:b6aqrl-${__psIdx}`}>
              <h3 class="text-[#061633] text-[25px] font-bold mb-5" data-ps={`src/pages/service-areas/pittsfield-township.astro:3suqo8-${__psIdx}`}>{area.title}</h3>
              <p class="text-[#454F5E] text-[17px] leading-[1.8] mb-7" data-local-summary data-ps={`src/pages/service-areas/pittsfield-township.astro:tyosk0-${__psIdx}`}>{area.summary}</p>
              <a href={area.href} class="text-[#732521] font-bold mt-auto hover:underline" data-ps={`src/pages/service-areas/pittsfield-township.astro:1tzat4-${__psIdx}`}>{area.cta}</a>
            </article>
          ))}
        </div>
        <a href="/practice-areas" class="inline-block mt-8 text-[#732521] font-bold underline" data-ps="src/pages/service-areas/pittsfield-township.astro:1tzat5">View all practice areas</a>
      </div>
    </section>

    <!-- Office and service area map -->
    <section class="bg-white py-20" data-ps="src/pages/service-areas/pittsfield-township.astro:94dqyi">
      <div class="local-container grid lg:grid-cols-2 gap-12 items-start" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvwt">
        <div data-ps="src/pages/service-areas/pittsfield-township.astro:efvvwu">
          <div class="text-[#732521] uppercase tracking-widest font-bold text-[12px] mb-4" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvwv">Law Offices of Joseph A. Simon</div>
          <h2 class="text-[#061633] text-[32px] sm:text-[40px] font-black mb-6" data-ps="src/pages/service-areas/pittsfield-township.astro:ih9nvy">Criminal defense is all we do.</h2>
          <p class="text-[#454F5E] text-[18px] leading-[1.8] mb-7" data-ps="src/pages/service-areas/pittsfield-township.astro:tyosjz">
            The Law Offices of Joseph A. Simon is a full-service law firm handling only criminal defense matters, misdemeanor and felony, from traffic offenses to homicide cases.
          </p>
          <a href="/attorneys/joseph-a-simon" class="text-[#732521] font-bold underline" data-ps="src/pages/service-areas/pittsfield-township.astro:1tzat6">About Joseph A. Simon →</a>
          <div class="bg-[#061633] text-white p-7 rounded-[5px] mt-9" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvww">
            <h3 class="text-[24px] font-bold mb-3" data-ps="src/pages/service-areas/pittsfield-township.astro:3suqo9">Our Ann Arbor Office</h3>
            <address class="not-italic text-[#C3CCDA] leading-[1.8]">
              1310 South Main Street, Suite 11<br />
              Ann Arbor, MI 48104
            </address>
            <a class="inline-block text-white font-bold underline mt-5" href="https://www.google.com/maps/dir/?api=1&destination=1310+South+Main+Street+Suite+11+Ann+Arbor+MI+48104" target="_blank" rel="noopener" data-ps="src/pages/service-areas/pittsfield-township.astro:1tzat7">Directions to our office →</a>
          </div>
        </div>
        <div data-ps="src/pages/service-areas/pittsfield-township.astro:efvvwx">
          <h2 class="text-[#061633] text-[28px] font-bold mb-5" data-ps="src/pages/service-areas/pittsfield-township.astro:ih9nvz">Serving Pittsfield Township</h2>
          <iframe
            title="Map of Pittsfield Township, Michigan service area"
            src="https://maps.google.com/maps?q=Pittsfield%20Township%2C%20Michigan&output=embed"
            width="100%"
            height="410"
            loading="lazy"
            class="rounded-[5px] border border-[#E6E2D9] w-full h-[410px]"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
          <p class="text-[#596371] text-[14px] mt-3" data-ps="src/pages/service-areas/pittsfield-township.astro:tyosjy">Service area: Pittsfield Township, Michigan. Our office is in Ann Arbor.</p>
        </div>
      </div>
    </section>

    <!-- Case results -->
    <section id="results" class="bg-[#061633] text-white py-[90px] border-t border-white/10" data-ps="src/pages/service-areas/pittsfield-township.astro:94dqyj">
      <div class="max-w-[1280px] mx-auto px-6" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvwy">
        <div class="text-[#C9A840] text-[12px] font-bold tracking-widest uppercase mb-4" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvwz">Courtroom Results</div>
        <h2 class="text-[36px] sm:text-[44px] font-black mb-10" data-ps="src/pages/service-areas/pittsfield-township.astro:ih9nw0">Representative case results.</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvx0">
          {cases.map((item, __psIdx) => (
            <article class="border border-white/10 p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840]/40 transition" data-ps={`src/pages/service-areas/pittsfield-township.astro:b6aqs7-${__psIdx}`}>
              <div data-ps={`src/pages/service-areas/pittsfield-township.astro:efvvxm-${__psIdx}`}>
                <div class="text-[12px] font-bold uppercase text-[#C9A840] tracking-wider mb-3" data-ps={`src/pages/service-areas/pittsfield-township.astro:efvvxn-${__psIdx}`}>{item.category}</div>
                <h3 class="text-[20px] font-bold mb-4" data-ps={`src/pages/service-areas/pittsfield-township.astro:3suqoa-${__psIdx}`}>{item.title}</h3>
                <p class="text-[#C3CCDA] leading-[1.65] mb-6" data-ps={`src/pages/service-areas/pittsfield-township.astro:tyosjx-${__psIdx}`}>{item.court}</p>
              </div>
              <span class="border border-[#C9A840]/40 text-[#DDC582] text-[12px] px-3 py-1 rounded-[2px] self-start" data-ps={`src/pages/service-areas/pittsfield-township.astro:xye84i-${__psIdx}`}>{item.caseNo}</span>
            </article>
          ))}
        </div>
        <div class="text-center mt-10" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvxo">
          <a href="/courtroom-victories" class="border border-[#C9A840]/40 text-[#DDC582] px-6 py-3 rounded-[3px] inline-block hover:border-[#C9A840] transition" data-ps="src/pages/service-areas/pittsfield-township.astro:1tzat8">View all case results →</a>
          <p class="text-[13px] text-[#C3CCDA] mt-4" data-ps="src/pages/service-areas/pittsfield-township.astro:tyosjw">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section id="testimonials" class="bg-[#F7F5F1] py-[90px] border-t border-[#E6E2D9]" data-ps="src/pages/service-areas/pittsfield-township.astro:94dqyk">
      <div class="max-w-[1280px] mx-auto px-6" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvxp">
        <div class="text-center mb-10" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvxq">
          <div class="text-[#732521] text-[12px] font-bold uppercase tracking-widest mb-3" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvxr">Client Testimonials</div>
          <h2 class="text-[#061633] text-[36px] sm:text-[44px] font-black mb-5" data-ps="src/pages/service-areas/pittsfield-township.astro:ih9nwm">Client Reviews</h2>
          <a href="/reviews" class="text-[#732521] font-bold underline" data-ps="src/pages/service-areas/pittsfield-township.astro:1tzat9">Read all client reviews →</a>
        </div>
