---

<BaseLayout
  title="Pittsfield Township Criminal Defense | Law Offices of Joseph A. Simon"
  description="Facing a DUI/OWI charge in Pittsfield Township? Trust the over 38 years of experience of local attorney Joseph A. Simon to protect your rights and guide you through the legal process. Contact us today."
  headerVariant="transparent"
>
  <div class="pt-[130px]" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvvw">
    <!-- Hero -->
    <section class="local-hero text-white pb-20 pt-10 sm:pb-24" data-service-area="pittsfield-township" data-ps="src/pages/service-areas/pittsfield-township.astro:94dqyf">
      <div class="local-container" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvvx">
        <nav class="flex flex-wrap gap-3 text-[13px] text-[#C3CCDA] mb-8" aria-label="Breadcrumb" data-ps="src/pages/service-areas/pittsfield-township.astro:ga9o62">
          <a href="/" class="hover:text-white" data-ps="src/pages/service-areas/pittsfield-township.astro:1tzasd">Home</a>
          <span data-ps="src/pages/service-areas/pittsfield-township.astro:xye84f">/</span>
          <a href="/service-areas" class="hover:text-white" data-ps="src/pages/service-areas/pittsfield-township.astro:1tzase">Service Areas</a>
          <span data-ps="src/pages/service-areas/pittsfield-township.astro:xye84g">/</span>
          <span data-ps="src/pages/service-areas/pittsfield-township.astro:xye84h">Pittsfield Township</span>
        </nav>
        <div class="text-[#C9A840] uppercase tracking-[1.8px] font-bold text-[12px] mb-5" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvvy">Serving Pittsfield Township, Michigan</div>
        <h1 class="text-[36px] sm:text-[52px] lg:text-[62px] font-black leading-[1.1] max-w-[950px]" data-ps="src/pages/service-areas/pittsfield-township.astro:x5ol49">Criminal Defense in Pittsfield Township</h1>
        <p class="text-[18px] sm:text-[21px] text-[#C3CCDA] leading-[1.75] mt-7 max-w-[900px]" data-local-intro data-ps="src/pages/service-areas/pittsfield-township.astro:5gvphb">
          Facing a DUI/OWI charge in Pittsfield Township? Trust the over 38 years of experience of local attorney Joseph A. Simon to protect your rights and guide you through the legal process. Contact us today.
        </p>
        <div class="flex flex-wrap gap-4 mt-9" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvvz">
          <a href="#contact" class="bg-[#732521] text-white px-7 py-4 rounded-[3px] font-bold hover:bg-[#581b19] transition" data-ps="src/pages/service-areas/pittsfield-township.astro:1tzasf">Confidential Consultation</a>
          <a href="tel:+17348876200" class="border border-white/30 text-white px-7 py-4 rounded-[3px] font-bold hover:border-white/60 transition" data-ps="src/pages/service-areas/pittsfield-township.astro:1tzasg">(734) 887-6200</a>
        </div>
        <p class="text-[#C3CCDA] text-[14px] mt-6" data-ps="src/pages/service-areas/pittsfield-township.astro:tyosk2">Ann Arbor office · Serving Pittsfield Township</p>
      </div>
    </section>

    <!-- Awards strip -->
    <section id="awards" class="awards bg-[#F7F5F1] py-7 border-b border-[#E6E2D9]" aria-labelledby="awards-heading" data-paused="false" data-ps="src/pages/service-areas/pittsfield-township.astro:94dqyg">
      <div class="awards-heading flex flex-col items-center gap-3 px-6 mb-5 sm:flex-row sm:justify-center sm:gap-6" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvw0">
        <h2 id="awards-heading" class="text-[#596371] text-[11.5px] font-bold uppercase tracking-[2px] text-center" data-ps="src/pages/service-areas/pittsfield-township.astro:ih9nvw">Recognized by third-party rating organizations</h2>
        <button type="button" class="awards-pause text-[12px] text-[#732521] border border-[#732521] px-3 py-1 rounded-[3px]" aria-pressed="false" aria-label="Pause awards scrolling" data-ps="src/pages/service-areas/pittsfield-township.astro:19ldcu">Pause scrolling</button>
      </div>
      <div class="awards-window" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvw1">
        <div class="awards-track" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvw2">
          <ul class="awards-list">
            {awards.map((award, __psIdx) => (
              <li data-ps={`src/pages/service-areas/pittsfield-township.astro:ruh9xc-${__psIdx}`}>
                {award.href ? (
                  <a class="award-badge" href={award.href} target="_blank" rel="noopener noreferrer" data-ps={`src/pages/service-areas/pittsfield-township.astro:1tzash-${__psIdx}`}>
                    <img src={award.src} alt={award.alt} width="200" height="140" loading="lazy" data-ps={`src/pages/service-areas/pittsfield-township.astro:bxmriu-${__psIdx}`} />
                  </a>
                ) : (
                  <div class="award-badge" data-ps={`src/pages/service-areas/pittsfield-township.astro:efvvw3-${__psIdx}`}>
                    <img src={award.src} alt={award.alt} width="200" height="140" loading="lazy" data-ps={`src/pages/service-areas/pittsfield-township.astro:bxmriv-${__psIdx}`} />
                  </div>
                )}
              </li>
            ))}
          </ul>
          <ul class="awards-list" aria-hidden="true" inert>
            {awards.map((award, __psIdx) => (
              <li data-ps={`src/pages/service-areas/pittsfield-township.astro:ruh9xd-${__psIdx}`}>
                {award.href ? (
                  <a class="award-badge" href={award.href} target="_blank" rel="noopener noreferrer" tabindex="-1" data-ps={`src/pages/service-areas/pittsfield-township.astro:1tzat3-${__psIdx}`}>
                    <img src={award.src} alt="" width="200" height="140" loading="lazy" data-ps={`src/pages/service-areas/pittsfield-township.astro:bxmriw-${__psIdx}`} />
                  </a>
                ) : (
                  <div class="award-badge" data-ps={`src/pages/service-areas/pittsfield-township.astro:efvvw4-${__psIdx}`}>
                    <img src={award.src} alt="" width="200" height="140" loading="lazy" data-ps={`src/pages/service-areas/pittsfield-township.astro:bxmrix-${__psIdx}`} />
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Local practice areas -->
    <section class="bg-[#F7F5F1] py-20 border-b border-[#E6E2D9]" id="local-practices" data-ps="src/pages/service-areas/pittsfield-township.astro:94dqyh">
      <div class="local-container" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvw5">
        <div class="text-[#732521] uppercase tracking-widest font-bold text-[12px] mb-4" data-ps="src/pages/service-areas/pittsfield-township.astro:efvvwr">Local Legal Services</div>
