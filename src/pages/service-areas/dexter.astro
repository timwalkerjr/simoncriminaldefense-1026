    background-size: auto, cover;
    background-position: 0% 0%, 50% 50%;
    background-color: #061633;
  }

  .awards-track {
    animation: awards-scroll 40s linear infinite;
  }
  .awards-track.is-paused {
    animation-play-state: paused;
  }
  @keyframes awards-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .awards-track {
      animation: none;
    }
    .awards-window {
      overflow-x: auto;
    }
  }
</style>

<script>
  import 'altcha';

  // Awards strip: pause / resume the scrolling track.
  const pauseBtn = document.querySelector<HTMLButtonElement>('[data-awards-pause]');
  const awardsTrack = document.querySelector<HTMLElement>('[data-awards-track]');
  pauseBtn?.addEventListener('click', () => {
    const paused = pauseBtn.getAttribute('aria-pressed') === 'true';
    const nowPaused = !paused;
    pauseBtn.setAttribute('aria-pressed', String(nowPaused));
    pauseBtn.setAttribute('aria-label', nowPaused ? 'Resume awards scrolling' : 'Pause awards scrolling');
    pauseBtn.textContent = nowPaused ? 'Resume scrolling' : 'Pause scrolling';
    awardsTrack?.classList.toggle('is-paused', nowPaused);
  });

  // Client reviews: pages of three cards, wrapping with previous/next.
  const reviews = Array.from(document.querySelectorAll<HTMLElement>('[data-featured-review]'));
  const pageSize = 3;
  const pageCount = Math.max(1, Math.ceil(reviews.length / pageSize));
  const prevBtn = document.getElementById('reviews-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('reviews-next') as HTMLButtonElement | null;
  const position = document.getElementById('reviews-position');
  let reviewPage = 0;

  function renderReviews() {
    reviews.forEach((card, index) => {
      card.hidden = Math.floor(index / pageSize) !== reviewPage;
    });
    if (position) position.textContent = `${reviewPage + 1} / ${pageCount}`;
  }
  prevBtn?.addEventListener('click', () => {
    reviewPage = (reviewPage - 1 + pageCount) % pageCount;
    renderReviews();
  });
  nextBtn?.addEventListener('click', () => {
    reviewPage = (reviewPage + 1) % pageCount;
    renderReviews();
  });
  renderReviews();

  // Consultation form: posts to the platform endpoint; success is shown only after confirmation.
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  function showFeedback(message: string, ok: boolean) {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className = `text-center text-[14px] mt-2 ${ok ? 'text-[#DDC582]' : 'text-[#f5b5b1]'}`;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submitBtn) return;
    const data = new FormData(form);
    submitBtn.disabled = true;
    const label = submitBtn.textContent;
    submitBtn.textContent = 'Sending...';
    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _formId: data.get('_formId'),
          subject: 'JAS Law website consultation request',
          name: data.get('name'),
          phone: data.get('phone'),
          email: data.get('email'),
          chargeType: data.get('chargeType'),
          message: data.get('message'),
          altcha: data.get('altcha'),
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Your message could not be sent. Please call 734-887-6200.');
      }
      showFeedback('Thank you! Your request has been sent.', true);
      form.reset();
    } catch (err) {
      showFeedback(err instanceof Error ? err.message : 'Your message could not be sent. Please try again.', false);
    } finally {
      feedback?.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = label;
    }
  });
</script>
