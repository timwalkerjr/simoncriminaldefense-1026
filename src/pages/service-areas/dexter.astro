---
import BaseLayout from '@/layouts/BaseLayout.astro';

const awards = [
  { href: 'http://www.leadinglawyers.com/atty_profile.cfm?TOCUID=30027701', src: 'https://pagesmith-cdn.com/ee60f2da/images/2023-leading-lawyers-peer-selected-10b63b-288.webp', alt: '2023 Leading Lawyers Peer Selected' },
  { href: 'https://www.top100criminaldefenseattorneys.com/', src: 'https://pagesmith-cdn.com/ee60f2da/images/americas-top-100-criminal-defense-attorneys-b3a7c1-1536.webp', alt: "America's Top 100 Criminal Defense Attorneys" },
  { href: 'https://www.martindale.com/attorney/joseph-a-simon-701141/#profile-peer-reviews', src: 'https://pagesmith-cdn.com/ee60f2da/images/av-preeminent-5fd67f-150.webp', alt: 'Av Preeminent' },
  { href: 'https://www.avvo.com/attorneys/48104-mi-joseph-simon-760453.html', src: 'https://pagesmith-cdn.com/ee60f2da/images/avvo-clients-choice-award-06efac-620.webp', alt: "Avvo Clients' Choice Award 2026 - Joseph A. Simon" },
  { href: '', src: 'https://pagesmith-cdn.com/ee60f2da/images/avvo-reviews-71f5a0.svg', alt: 'AVVO Reviews' },
  { href: 'https://www.avvo.com/attorneys/48104-mi-joseph-simon-760453.html', src: 'https://pagesmith-cdn.com/ee60f2da/images/avvo-top-attorney-847684-150.webp', alt: 'AVVO Top Attorney' },
  { href: 'https://bestlawyers.com/lawyers/joseph-a-simon/32940', src: 'https://pagesmith-cdn.com/ee60f2da/images/best-lawyers-d9b11b-152.webp', alt: 'Best Lawyers' },
  { href: 'https://www.leadinglawyers.com/', src: 'https://pagesmith-cdn.com/ee60f2da/images/leading-lawyers-top-10-2020-831118-288.webp', alt: 'Leading Lawyers Top 10 2020' },
  { href: 'https://profiles.superlawyers.com/michigan/ann-arbor/lawyer/joseph-joe-simon/1f4a883a-12c6-42b5-bb39-ee3cdb87ae30.html', src: 'https://pagesmith-cdn.com/ee60f2da/images/super-lawyers-10-years-7de9e4-189.webp', alt: 'Super Lawyers 15 Years' },
  { href: '', src: 'https://pagesmith-cdn.com/ee60f2da/images/2024-10-best-attorneys-020401-455.webp', alt: '2024 10 Best Attorneys' },
];

const serviceAreas = [
  ['Ann Arbor', '/service-areas/ann-arbor'],
  ['Chelsea', '/service-areas/chelsea'],
  ['Milan', '/service-areas/milan'],
  ['Saline', '/service-areas/saline'],
  ['Ypsilanti', '/service-areas/ypsilanti'],
  ['Ypsilanti Township', '/service-areas/ypsilanti-township'],
  ['Pittsfield Township', '/service-areas/pittsfield-township'],
  ['Washtenaw County', '/service-areas/washtenaw-county'],
];
---

<BaseLayout
  headerVariant="transparent"
  title="Dexter Criminal Defense | Law Offices of Joseph A. Simon"
  description="If you're facing DUI/OWI charges in Dexter, turn to the Law Offices of Joseph A. Simon, a local firm with over 38 years of successful OWI defenses."
>
  <main data-ps="src/pages/service-areas/dexter.astro:wy9vbw">
    <!-- Hero -->
    <section class="local-hero text-white pt-[150px] pb-[100px] lg:pt-[170px]" data-service-area="dexter" data-ps="src/pages/service-areas/dexter.astro:ljyc7y">
      <div class="mx-auto max-w-[1280px] px-6" data-ps="src/pages/service-areas/dexter.astro:un8m5p">
        <nav class="flex flex-wrap gap-3 text-[13px] text-[#C3CCDA] mb-8" aria-label="Breadcrumb" data-ps="src/pages/service-areas/dexter.astro:ujx60p">
          <a href="/" class="hover:text-white" data-ps="src/pages/service-areas/dexter.astro:71q246">Home</a>
          <span data-ps="src/pages/service-areas/dexter.astro:nn58a9">/</span>
          <a href="/service-areas" class="hover:text-white" data-ps="src/pages/service-areas/dexter.astro:71q23k">Service Areas</a>
          <span data-ps="src/pages/service-areas/dexter.astro:nn58a8">/</span>
          <span data-ps="src/pages/service-areas/dexter.astro:nn589m">Dexter</span>
        </nav>
        <div class="text-[#C9A840] uppercase tracking-[1.8px] font-bold text-[12px] mb-5" data-ps="src/pages/service-areas/dexter.astro:un8m5o">Serving Dexter, Michigan</div>
        <h1 class="text-[36px] sm:text-[52px] lg:text-[62px] font-black leading-[1.1] max-w-[950px]" data-ps="src/pages/service-areas/dexter.astro:muaf7u">Criminal Defense in Dexter</h1>
        <p class="text-[18px] sm:text-[21px] text-[#C3CCDA] leading-[1.75] mt-7 max-w-[900px]" data-local-intro data-ps="src/pages/service-areas/dexter.astro:ecl2ch">If you're facing DUI/OWI charges in Dexter, turn to the Law Offices of Joseph A. Simon, a local firm with over 38 years of successful OWI defenses.</p>
        <div class="flex flex-wrap gap-4 mt-9" data-ps="src/pages/service-areas/dexter.astro:un8m5n">
          <a href="#contact" class="bg-[#732521] text-white px-7 py-4 rounded-[3px] font-bold hover:bg-[#581b19] transition" data-ps="src/pages/service-areas/dexter.astro:71q23j">Confidential Consultation</a>
          <a href="tel:+17348876200" class="border border-white/30 text-white px-7 py-4 rounded-[3px] font-bold hover:border-white transition" data-ps="src/pages/service-areas/dexter.astro:71q23i">(734) 887-6200</a>
        </div>
        <p class="text-[#C3CCDA] text-[14px] mt-6" data-ps="src/pages/service-areas/dexter.astro:ecl2cg">Ann Arbor office · Serving Dexter</p>
      </div>
    </section>

    <!-- Awards strip -->
    <section id="awards" class="awards bg-[#F7F5F1] pt-7 pb-[34px] border-b border-[#E6E2D9]" aria-labelledby="awards-heading" data-ps="src/pages/service-areas/dexter.astro:ljyc8k">
      <div class="awards-heading flex flex-wrap items-center justify-center gap-x-6 gap-y-3 px-6 mb-5" data-ps="src/pages/service-areas/dexter.astro:un8m51">
        <h2 id="awards-heading" class="text-[11.52px] font-bold uppercase tracking-[2px] text-[#596371] text-center" data-ps="src/pages/service-areas/dexter.astro:5zvufy">Recognized by third-party rating organizations</h2>
        <button type="button" class="awards-pause text-[12px] text-[#732521] border border-[#732521] px-3 py-1 rounded-[3px] hover:bg-[#732521] hover:text-white transition" aria-pressed="false" aria-label="Pause awards scrolling" data-awards-pause data-ps="src/pages/service-areas/dexter.astro:a13tbl">Pause scrolling</button>
      </div>
      <div class="awards-window overflow-hidden" data-ps="src/pages/service-areas/dexter.astro:un8m50">
        <div class="awards-track flex w-max" data-awards-track data-ps="src/pages/service-areas/dexter.astro:un8m4z">
          <ul class="awards-list flex items-center gap-12 pr-12 list-none m-0 p-0">
            {awards.map((award, __psIdx) => (
              <li class="shrink-0" data-ps={`src/pages/service-areas/dexter.astro:h865gt-${__psIdx}`}>
                {award.href ? (
                  <a class="award-badge block" href={award.href} target="_blank" rel="noopener noreferrer" data-ps={`src/pages/service-areas/dexter.astro:71q23h-${__psIdx}`}>
                    <img src={award.src} alt={award.alt} width="200" height="140" loading="lazy" class="w-[134px] h-[94px] object-contain" data-ps={`src/pages/service-areas/dexter.astro:xaovxd-${__psIdx}`} />
                  </a>
                ) : (
                  <div class="award-badge block" data-ps={`src/pages/service-areas/dexter.astro:un8m4y-${__psIdx}`}>
                    <img src={award.src} alt={award.alt} width="200" height="140" loading="lazy" class="w-[134px] h-[94px] object-contain" data-ps={`src/pages/service-areas/dexter.astro:xaovwr-${__psIdx}`} />
                  </div>
                )}
              </li>
            ))}
          </ul>
          <ul class="awards-list flex items-center gap-12 pr-12 list-none m-0 p-0" aria-hidden="true" inert>
            {awards.map((award, __psIdx) => (
              <li class="shrink-0" data-ps={`src/pages/service-areas/dexter.astro:h865gu-${__psIdx}`}>
                {award.href ? (
                  <a class="award-badge block" href={award.href} target="_blank" rel="noopener noreferrer" tabindex="-1" data-ps={`src/pages/service-areas/dexter.astro:71q23g-${__psIdx}`}>
                    <img src={award.src} alt="" width="200" height="140" loading="lazy" class="w-[134px] h-[94px] object-contain" data-ps={`src/pages/service-areas/dexter.astro:xaovwq-${__psIdx}`} />
                  </a>
                ) : (
                  <div class="award-badge block" data-ps={`src/pages/service-areas/dexter.astro:un8m4x-${__psIdx}`}>
                    <img src={award.src} alt="" width="200" height="140" loading="lazy" class="w-[134px] h-[94px] object-contain" data-ps={`src/pages/service-areas/dexter.astro:xaovwp-${__psIdx}`} />
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Local practice guides -->
    <section class="bg-[#F7F5F1] py-20 border-b border-[#E6E2D9]" id="local-practices" data-ps="src/pages/service-areas/dexter.astro:ljyc8l">
      <div class="mx-auto max-w-[1280px] px-6" data-ps="src/pages/service-areas/dexter.astro:un8m4w">
        <div class="text-[#732521] uppercase tracking-widest font-bold text-[12px] mb-4" data-ps="src/pages/service-areas/dexter.astro:un8m4v">Local Legal Services</div>
        <h2 class="text-[#061633] text-[32px] sm:text-[44px] font-black mb-5" data-ps="src/pages/service-areas/dexter.astro:5zvufx">Defense services for Dexter</h2>
        <p class="text-[#454F5E] text-[18px] leading-[1.8] max-w-[1000px] mb-10" data-local-info data-ps="src/pages/service-areas/dexter.astro:ecl2cf">Dexter sits where Mill Creek meets the Huron River. Mill Creek Park connects the Main Street area with riverside paths, and trails extend toward Hudson Mills Metropark. The local guides below cover DUI/OWI, assault charges, domestic violence, and OWI/DUI expungements for people seeking criminal defense representation in Dexter.</p>
        <div class="grid md:grid-cols-2 gap-6" data-ps="src/pages/service-areas/dexter.astro:un8m4u">
          <article class="bg-white border border-[#E6E2D9] rounded-[5px] p-7 sm:p-9 flex flex-col" data-ps="src/pages/service-areas/dexter.astro:liuzo4">
            <h3 class="text-[#061633] text-[25px] font-bold mb-5" data-ps="src/pages/service-areas/dexter.astro:yu244z">OWI - DUI Expungements in Dexter MI</h3>
            <p class="text-[#454F5E] text-[17px] leading-[1.8] mb-7" data-local-summary data-ps="src/pages/service-areas/dexter.astro:ecl2ce">Learn how Joseph A. Simon's over 35 years of experience can help you expunge your criminal conviction(s) and secure a fresh start—contact us today for guidance and support.</p>
            <a href="/practice-area/owi-dui-expungements-in-dexter-mi" class="text-[#732521] font-bold mt-auto" data-ps="src/pages/service-areas/dexter.astro:71q23f">Explore OWI - DUI Expungements in Dexter MI →</a>
          </article>
          <article class="bg-white border border-[#E6E2D9] rounded-[5px] p-7 sm:p-9 flex flex-col" data-ps="src/pages/service-areas/dexter.astro:liuzo5">
            <h3 class="text-[#061633] text-[25px] font-bold mb-5" data-ps="src/pages/service-areas/dexter.astro:yu244d">Dexter Drunk Driving DUI/OWI</h3>
            <p class="text-[#454F5E] text-[17px] leading-[1.8] mb-7" data-local-summary data-ps="src/pages/service-areas/dexter.astro:ecl2cd">If you're facing DUI/OWI charges in Dexter, turn to the Law Offices of Joseph A. Simon, a local firm with over 38 years of successful OWI defenses.</p>
            <a href="/practice-area/dexter-drunk-driving-dui-owi" class="text-[#732521] font-bold mt-auto" data-ps="src/pages/service-areas/dexter.astro:71q23e">Explore Dexter Drunk Driving DUI/OWI →</a>
          </article>
          <article class="bg-white border border-[#E6E2D9] rounded-[5px] p-7 sm:p-9 flex flex-col" data-ps="src/pages/service-areas/dexter.astro:liuzo6">
            <h3 class="text-[#061633] text-[25px] font-bold mb-5" data-ps="src/pages/service-areas/dexter.astro:yu244c">Dexter, MI Domestic Violence</h3>
            <p class="text-[#454F5E] text-[17px] leading-[1.8] mb-7" data-local-summary data-ps="src/pages/service-areas/dexter.astro:ecl2cc">If you're facing Domestic Violence charges in Dexter, turn to the Law Offices of Joseph A. Simon, a local firm with over 38 years of successful Domestic Violence defenses.</p>
            <a href="/practice-area/dexter-mi-domestic-violence" class="text-[#732521] font-bold mt-auto" data-ps="src/pages/service-areas/dexter.astro:71q23d">Explore Dexter, MI Domestic Violence →</a>
          </article>
          <article class="bg-white border border-[#E6E2D9] rounded-[5px] p-7 sm:p-9 flex flex-col" data-ps="src/pages/service-areas/dexter.astro:liuzo7">
            <h3 class="text-[#061633] text-[25px] font-bold mb-5" data-ps="src/pages/service-areas/dexter.astro:yu244b">Dexter Assault Charges</h3>
            <p class="text-[#454F5E] text-[17px] leading-[1.8] mb-7" data-local-summary data-ps="src/pages/service-areas/dexter.astro:ecl2cb">Joseph A. Simon has provided successful defenses in Dexter assault cases for over 35 years. Contact us for a free consultation.</p>
            <a href="/practice-area/dexter-assault-charges" class="text-[#732521] font-bold mt-auto" data-ps="src/pages/service-areas/dexter.astro:71q23c">Explore Dexter Assault Charges →</a>
          </article>
        </div>
        <a href="/practice-areas" class="inline-block mt-8 text-[#732521] font-bold underline" data-ps="src/pages/service-areas/dexter.astro:71q23b">View all practice areas</a>
      </div>
    </section>

    <!-- Office and map -->
    <section class="bg-white py-20" data-ps="src/pages/service-areas/dexter.astro:ljyc8m">
      <div class="mx-auto max-w-[1280px] px-6 grid lg:grid-cols-2 gap-12 items-start" data-ps="src/pages/service-areas/dexter.astro:un8m4t">
        <div data-ps="src/pages/service-areas/dexter.astro:un8m4s">
          <div class="text-[#732521] uppercase tracking-widest font-bold text-[12px] mb-4" data-ps="src/pages/service-areas/dexter.astro:un8m46">Law Offices of Joseph A. Simon</div>
          <h2 class="text-[#061633] text-[32px] sm:text-[40px] font-black mb-6" data-ps="src/pages/service-areas/dexter.astro:5zvufw">Criminal defense is all we do.</h2>
          <p class="text-[#454F5E] text-[18px] leading-[1.8] mb-7" data-ps="src/pages/service-areas/dexter.astro:ecl2ca">The Law Offices of Joseph A. Simon is a full-service law firm handling only criminal defense matters, misdemeanor and felony, from traffic offenses to homicide cases.</p>
          <a href="/attorneys/joseph-a-simon" class="text-[#732521] font-bold underline" data-ps="src/pages/service-areas/dexter.astro:71q22p">About Joseph A. Simon →</a>
          <div class="bg-[#061633] text-white p-7 rounded-[5px] mt-9" data-ps="src/pages/service-areas/dexter.astro:un8m45">
            <h3 class="text-[24px] font-bold mb-3" data-ps="src/pages/service-areas/dexter.astro:yu244a">Our Ann Arbor Office</h3>
            <address class="not-italic text-[#C3CCDA] leading-[1.8]">1310 South Main Street, Suite 11<br />Ann Arbor, MI 48104</address>
            <a class="inline-block text-white font-bold underline mt-5" href="https://www.google.com/maps/dir/?api=1&destination=1310+South+Main+Street+Suite+11+Ann+Arbor+MI+48104" target="_blank" rel="noopener" data-ps="src/pages/service-areas/dexter.astro:71q22o">Directions to our office →</a>
          </div>
        </div>
        <div data-ps="src/pages/service-areas/dexter.astro:un8m44">
          <h2 class="text-[#061633] text-[28px] font-bold mb-5" data-ps="src/pages/service-areas/dexter.astro:5zvufv">Serving Dexter</h2>
          <iframe title="Map of Dexter, Michigan service area" src="https://maps.google.com/maps?q=Dexter%2C%20Michigan&output=embed" width="100%" height="410" loading="lazy" class="rounded-[5px] border border-[#E6E2D9] w-full" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <p class="text-[#596371] text-[14px] mt-3" data-ps="src/pages/service-areas/dexter.astro:ecl2c9">Service area: Dexter, Michigan. Our office is in Ann Arbor.</p>
        </div>
      </div>
    </section>

    <!-- Case results -->
    <section id="results" class="bg-[#061633] text-white py-[90px] border-t border-white/10" data-ps="src/pages/service-areas/dexter.astro:ljyc8n">
      <div class="max-w-[1280px] mx-auto px-6" data-ps="src/pages/service-areas/dexter.astro:un8m43">
        <div class="text-[#C9A840] text-[12px] font-bold tracking-widest uppercase mb-4" data-ps="src/pages/service-areas/dexter.astro:un8m42">Courtroom Results</div>
        <h2 class="text-[36px] sm:text-[44px] font-black mb-10" data-ps="src/pages/service-areas/dexter.astro:5zvufu">Representative case results.</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/service-areas/dexter.astro:un8m41">
          <article class="border border-white/10 p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840]/40 transition" data-ps="src/pages/service-areas/dexter.astro:liuzo8">
            <div data-ps="src/pages/service-areas/dexter.astro:un8m40">
              <div class="text-[12px] font-bold uppercase text-[#C9A840] tracking-wider mb-3" data-ps="src/pages/service-areas/dexter.astro:un8m3z">Assault &amp; Reckless Driving</div>
              <h3 class="text-[20px] font-bold mb-4" data-ps="src/pages/service-areas/dexter.astro:yu2449">Cases Dismissed at Trial</h3>
              <p class="text-[#C3CCDA] leading-[1.65] mb-6" data-ps="src/pages/service-areas/dexter.astro:ecl2c8">14-B District Court</p>
            </div>
            <span class="border border-[#C9A840]/40 text-[#DDC582] text-[12px] px-3 py-1 rounded-[2px] self-start" data-ps="src/pages/service-areas/dexter.astro:nn589l">Case 19-FB-1405-FY</span>
          </article>
          <article class="border border-white/10 p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840]/40 transition" data-ps="src/pages/service-areas/dexter.astro:nlvc1j">
            <div data-ps="src/pages/service-areas/dexter.astro:un8m3y">
              <div class="text-[12px] font-bold uppercase text-[#C9A840] tracking-wider mb-3" data-ps="src/pages/service-areas/dexter.astro:un8m3x">Assault &amp; Battery</div>
              <h3 class="text-[20px] font-bold mb-4" data-ps="src/pages/service-areas/dexter.astro:yu2448">Charges Dismissed</h3>
              <p class="text-[#C3CCDA] leading-[1.65] mb-6" data-ps="src/pages/service-areas/dexter.astro:ecl2bm">14-B District Court</p>
            </div>
            <span class="border border-[#C9A840]/40 text-[#DDC582] text-[12px] px-3 py-1 rounded-[2px] self-start" data-ps="src/pages/service-areas/dexter.astro:nn589k">Case 19S-00414-SM</span>
          </article>
          <article class="border border-white/10 p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840]/40 transition" data-ps="src/pages/service-areas/dexter.astro:nlvc1k">
            <div data-ps="src/pages/service-areas/dexter.astro:un8m3b">
              <div class="text-[12px] font-bold uppercase text-[#C9A840] tracking-wider mb-3" data-ps="src/pages/service-areas/dexter.astro:un8m3a">Child Abuse</div>
              <h3 class="text-[20px] font-bold mb-4" data-ps="src/pages/service-areas/dexter.astro:yu2447">Not Guilty Verdict at Trial</h3>
              <p class="text-[#C3CCDA] leading-[1.65] mb-6" data-ps="src/pages/service-areas/dexter.astro:ecl2bl">14-B District Court</p>
            </div>
            <span class="border border-[#C9A840]/40 text-[#DDC582] text-[12px] px-3 py-1 rounded-[2px] self-start" data-ps="src/pages/service-areas/dexter.astro:nn589j">Case 19S-0042SM</span>
          </article>
          <article class="border border-white/10 p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840]/40 transition" data-ps="src/pages/service-areas/dexter.astro:nlvc1l">
            <div data-ps="src/pages/service-areas/dexter.astro:un8m39">
              <div class="text-[12px] font-bold uppercase text-[#C9A840] tracking-wider mb-3" data-ps="src/pages/service-areas/dexter.astro:un8m38">Assault with a Dangerous Weapon (Felonious Assault), Aggravated Domestic Violence</div>
              <h3 class="text-[20px] font-bold mb-4" data-ps="src/pages/service-areas/dexter.astro:yu2446">Charges Dismissed</h3>
              <p class="text-[#C3CCDA] leading-[1.65] mb-6" data-ps="src/pages/service-areas/dexter.astro:ecl2bk">22nd Circuit Court and 15th District Court</p>
            </div>
            <span class="border border-[#C9A840]/40 text-[#DDC582] text-[12px] px-3 py-1 rounded-[2px] self-start" data-ps="src/pages/service-areas/dexter.astro:nn589i">Case 20F5-5103-FY</span>
          </article>
          <article class="border border-white/10 p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840]/40 transition" data-ps="src/pages/service-areas/dexter.astro:nlvc1m">
            <div data-ps="src/pages/service-areas/dexter.astro:un8m37">
              <div class="text-[12px] font-bold uppercase text-[#C9A840] tracking-wider mb-3" data-ps="src/pages/service-areas/dexter.astro:un8m36">Criminal Sexual Conduct, Third Degree, Assault with Intent to Do Great Bodily Harm Less Than Murder or By Strangulation, Domestic Violence</div>
              <h3 class="text-[20px] font-bold mb-4" data-ps="src/pages/service-areas/dexter.astro:yu2445">All Charges Dismissed at Preliminary Examination</h3>
              <p class="text-[#C3CCDA] leading-[1.65] mb-6" data-ps="src/pages/service-areas/dexter.astro:ecl2bj">22nd Circuit Court</p>
            </div>
            <span class="border border-[#C9A840]/40 text-[#DDC582] text-[12px] px-3 py-1 rounded-[2px] self-start" data-ps="src/pages/service-areas/dexter.astro:nn589h">Case 21F5-5123-FY</span>
          </article>
