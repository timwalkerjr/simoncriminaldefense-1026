<script>
  import 'altcha';

  // Awards strip: pause/resume the continuous scroll.
  const pauseBtn = document.getElementById('awards-pause') as HTMLButtonElement | null;
  const awardsTrack = document.getElementById('awards-track');
  pauseBtn?.addEventListener('click', () => {
    const paused = pauseBtn.getAttribute('aria-pressed') === 'true';
    pauseBtn.setAttribute('aria-pressed', paused ? 'false' : 'true');
    pauseBtn.textContent = paused ? 'Pause scrolling' : 'Resume scrolling';
    pauseBtn.setAttribute('aria-label', paused ? 'Pause awards scrolling' : 'Resume awards scrolling');
    awardsTrack?.classList.toggle('is-paused', !paused);
  });

  // Client reviews: show three per page.
  const PAGE_SIZE = 3;
  const reviewCards = Array.from(document.querySelectorAll<HTMLElement>('#testimonials-track [data-review-index]'));
  const prevBtn = document.getElementById('reviews-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('reviews-next') as HTMLButtonElement | null;
  const position = document.getElementById('reviews-position');
  const pageCount = Math.max(1, Math.ceil(reviewCards.length / PAGE_SIZE));
  let page = 0;

  function renderReviews() {
    const start = page * PAGE_SIZE;
    reviewCards.forEach((card, i) => {
      card.hidden = i < start || i >= start + PAGE_SIZE;
    });
    if (position) position.textContent = `${page + 1} / ${pageCount}`;
    if (prevBtn) prevBtn.disabled = page === 0;
    if (nextBtn) nextBtn.disabled = page >= pageCount - 1;
  }

  prevBtn?.addEventListener('click', () => {
    if (page > 0) {
      page -= 1;
      renderReviews();
    }
  });
  nextBtn?.addEventListener('click', () => {
    if (page < pageCount - 1) {
      page += 1;
      renderReviews();
    }
  });
  renderReviews();

  // Consultation form: posts to the platform email endpoint with the ALTCHA solution.
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  function showFeedback(message: string, type: 'success' | 'error') {
    if (!feedback) return;
    feedback.hidden = false;
    feedback.textContent = message;
    feedback.className = `form-feedback ${type === 'success' ? 'is-success' : 'is-error'}`;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }

    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _formId: data.get('_formId'),
          subject: 'JAS Law website consultation request',
          name: data.get('name'),
          email: data.get('email'),
          phone: data.get('phone'),
          chargeType: data.get('chargeType'),
          message: data.get('message'),
          altcha: data.get('altcha'),
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Your request could not be sent. Please try again or call (734) 887-6200.');
      }
      form.reset();
      showFeedback('Thank you! Your consultation request has been sent.', 'success');
    } catch (err) {
      showFeedback(err instanceof Error ? err.message : 'Your request could not be sent. Please try again.', 'error');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send My Case Details';
      }
    }
  });
</script>
