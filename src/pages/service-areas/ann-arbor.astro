---
import '@/styles/global.css';
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Ann Arbor Criminal Defense | Law Offices of Joseph A. Simon';
const pageDescription =
  'If you’re facing DUI/OWI charges in Ann Arbor, trust the over 38 years of experience of Ann Arbor attorney Joseph A. Simon to protect your rights and guide you through the legal process. Contact us today.';

const awards = [
  { href: 'http://www.leadinglawyers.com/atty_profile.cfm?TOCUID=30027701', src: 'https://pagesmith-cdn.com/ee60f2da/images/2023-leading-lawyers-peer-selected-10b63b-288.webp', alt: '2023 Leading Lawyers Peer Selected' },
  { href: 'https://www.top100criminaldefenseattorneys.com/', src: 'https://pagesmith-cdn.com/ee60f2da/images/americas-top-100-criminal-defense-attorneys-b3a7c1-1536.webp', alt: "America's Top 100 Criminal Defense Attorneys" },
  { href: 'https://www.martindale.com/attorney/joseph-a-simon-701141/#profile-peer-reviews', src: 'https://pagesmith-cdn.com/ee60f2da/images/av-preeminent-5fd67f-150.webp', alt: 'Av Preeminent' },
  { href: 'https://www.avvo.com/attorneys/48104-mi-joseph-simon-760453.html', src: 'https://pagesmith-cdn.com/ee60f2da/images/avvo-clients-choice-award-06efac-620.webp', alt: "Avvo Clients' Choice Award 2026 - Joseph A. Simon" },
  { href: '', src: 'https://pagesmith-cdn.com/ee60f2da/images/avvo-reviews-71f5a0.svg', alt: 'AVVO Reviews' },
  { href: 'https://www.avvo.com/attorneys/48104-mi-joseph-simon-760453.html', src: 'https://pagesmith-cdn.com/ee60f2da/images/avvo-top-attorney-847684-150.webp', alt: 'AVVO Top Attorney' },
  { href: 'https://bestlawyers.com/lawyers/joseph-a-simon/32940', src: 'https://pagesmith-cdn.com/ee60f2da/images/best-lawyers-d9b11b-152.webp', alt: 'Best Lawyers' },
  { href: 'https://www.leadinglawyers.com/', src: 'https://pagesmith-cdn.com/ee60f2da/images/leading-lawyers-top-10-2020-831118-288.webp', alt: 'Leading Lawyers Top 10 2020' },
  { href: 'https://profiles.superlawyers.com/michigan/ann-arbor/lawyer/joseph-joe-simon/1f4a883a-12c6-42b5-bb39-ee3cdb87ae30.html', src: 'https://pagesmith-cdn.com/ee60f2da/images/super-lawyers-10-years-7de9e4-189.webp', alt: 'Super Lawyers 15 Years' },
  { href: '', src: 'https://pagesmith-cdn.com/ee60f2da/images/2024-10-best-attorneys-020401-455.webp', alt: '2024 10 Best Attorneys' },
];

const practiceCards = [
  { title: 'OWI - DUI Expungements in Ann Arbor MI', body: "First offense OWI convictions can now be expunged! Let Joseph A. Simon's over 35 years of experience help you secure a fresh start. Contact us today to see if you qualify.", href: '/practice-area/owi-dui-expungements-in-ann-arbor-mi', link: 'Explore OWI - DUI Expungements in Ann Arbor MI →' },
  { title: 'Ann Arbor Assault Charges', body: 'Facing an assault charge in Ann Arbor? Turn to the over 38 years of experience of local attorney Joseph A. Simon to defend your rights and protect your future. Contact us today.', href: '/practice-area/ann-arbor-assault-crimes', link: 'Explore Ann Arbor Assault Charges →' },
  { title: 'Ann Arbor Domestic Violence', body: "If you're facing domestic violence charges in Ann Arbor, turn to the over 38 years of experience of local attorney Joseph A. Simon to defend your rights and protect your future. Contact us today.", href: '/practice-area/ann-arbor-domestic-violence', link: 'Explore Ann Arbor Domestic Violence →' },
  { title: 'Ann Arbor Drunk Driving DUI/OWI', body: 'If you’re facing DUI/OWI charges in Ann Arbor, trust the over 38 years of experience of Ann Arbor attorney Joseph A. Simon to protect your rights and guide you through the legal process. Contact us today.', href: '/practice-area/ann-arbor-dui-defense', link: 'Explore Ann Arbor Drunk Driving DUI/OWI →' },
];

const cases = [
  { category: 'Assault & Reckless Driving', title: 'Cases Dismissed at Trial', court: '14-B District Court', caseNo: 'Case 19-FB-1405-FY' },
  { category: 'Assault & Battery', title: 'Charges Dismissed', court: '14-B District Court', caseNo: 'Case 19S-00414-SM' },
  { category: 'Child Abuse', title: 'Not Guilty Verdict at Trial', court: '14-B District Court', caseNo: 'Case 19S-0042SM' },
  { category: 'Assault with a Dangerous Weapon (Felonious Assault), Aggravated Domestic Violence', title: 'Charges Dismissed', court: '22nd Circuit Court and 15th District Court', caseNo: 'Case 20F5-5103-FY' },
  { category: 'Criminal Sexual Conduct, Third Degree, Assault with Intent to Do Great Bodily Harm Less Than Murder or By Strangulation, Domestic Violence', title: 'All Charges Dismissed at Preliminary Examination', court: '22nd Circuit Court', caseNo: 'Case 21F5-5123-FY' },
];

const reviews = [
  { rating: 'Rating: 5.0 stars', text: 'Joe went into the courtroom totally prepared which made me feel very fortunate and confident. It was fascinating to watch him be so creative. Joe is an amazing attorney.' },
  { rating: 'Rating: Five Stars', text: 'I would highly recommend him to anyone who has the misfortune of having a criminal matter befall them. I clearly understand why he is billed as one of the top criminal defense attorneys in the State of Michigan.' },
  { rating: 'Rating: 5', text: 'Joe is an amazing individual and lawyer...' },
  { rating: 'Rating: 5.0 stars', text: 'Miracle worker… Satisfied is an understatement…' },
  { rating: 'Rating: 5.0 stars', text: 'Joe worked tirelessly going over every bit of information relating to the case and submerged himself into understanding every little detail...' },
];

const serviceAreas = [
  { name: 'Chelsea', href: '/service-areas/chelsea' },
  { name: 'Dexter', href: '/service-areas/dexter' },
  { name: 'Milan', href: '/service-areas/milan' },
  { name: 'Saline', href: '/service-areas/saline' },
  { name: 'Ypsilanti', href: '/service-areas/ypsilanti' },
  { name: 'Ypsilanti Township', href: '/service-areas/ypsilanti-township' },
  { name: 'Pittsfield Township', href: '/service-areas/pittsfield-township' },
  { name: 'Washtenaw County', href: '/service-areas/washtenaw-county' },
];

const chargeTypes = [
  { value: 'DUI / OWI', label: 'DUI / OWI' },
  { value: 'Drug Crimes', label: 'Drug Crime' },
  { value: 'Assault / Battery', label: 'Assault / Battery' },
  { value: 'Domestic Violence', label: 'Domestic Violence' },
  { value: 'Criminal Sexual Conduct', label: 'Sex Crime / CSC' },
  { value: 'Home Invasion', label: 'Home Invasion' },
  { value: 'Computer Crimes', label: 'Computer Crime' },
  { value: 'College / Campus Crimes', label: 'College / Campus Crime' },
  { value: 'Expungements', label: 'Expungement' },
  { value: 'Other', label: 'Other' },
];
---

<BaseLayout headerVariant="transparent" title={pageTitle} description={pageDescription}>
  <main data-ps="src/pages/service-areas/ann-arbor.astro:5udr97">
    <section class="local-hero" data-service-area="ann-arbor" data-ps="src/pages/service-areas/ann-arbor.astro:9z56bp">
      <div class="local-container" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0w6">
        <nav class="breadcrumb" aria-label="Breadcrumb" data-ps="src/pages/service-areas/ann-arbor.astro:og18m0">
          <a href="/" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0r4">Home</a><span data-ps="src/pages/service-areas/ann-arbor.astro:mmcxe6">/</span><a href="/service-areas" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0r3">Service Areas</a><span data-ps="src/pages/service-areas/ann-arbor.astro:mmcxe5">/</span><span data-ps="src/pages/service-areas/ann-arbor.astro:mmcxe4">Ann Arbor</span>
        </nav>
        <div class="hero-eyebrow" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0w5">Serving Ann Arbor, Michigan</div>
        <h1 class="hero-title" data-ps="src/pages/service-areas/ann-arbor.astro:2v92">Criminal Defense in Ann Arbor</h1>
        <p class="hero-intro" data-ps="src/pages/service-areas/ann-arbor.astro:fpc10s">If you’re facing DUI/OWI charges in Ann Arbor, trust the over 38 years of experience of Ann Arbor attorney Joseph A. Simon to protect your rights and guide you through the legal process. Contact us today.</p>
        <div class="hero-actions" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0w4">
          <a href="#contact" class="hero-btn-primary" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0r2">Confidential Consultation</a>
          <a href="tel:+17348876200" class="hero-btn-outline" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0r1">(734) 887-6200</a>
        </div>
        <p class="hero-note" data-ps="src/pages/service-areas/ann-arbor.astro:ta3mnv">Ann Arbor office · Serving Ann Arbor</p>
      </div>
    </section>

    <section id="awards" class="awards" aria-labelledby="awards-heading" data-ps="src/pages/service-areas/ann-arbor.astro:9z56bq">
      <div class="awards-heading" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0w3">
        <h2 id="awards-heading" data-ps="src/pages/service-areas/ann-arbor.astro:eoc1zb">Recognized by third-party rating organizations</h2>
        <button type="button" class="awards-pause" id="awards-pause" aria-pressed="false" aria-label="Pause awards scrolling" data-ps="src/pages/service-areas/ann-arbor.astro:uu81yt">Pause scrolling</button>
      </div>
      <div class="awards-window" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0w2">
        <div class="awards-track" id="awards-track" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0w1">
          <ul class="awards-list">
            {awards.map((award, __psIdx) => (
              <li data-ps={`src/pages/service-areas/ann-arbor.astro:5jn8a5-${__psIdx}`}>
                {award.href ? (
                  <a class="award-badge" href={award.href} target="_blank" rel="noopener noreferrer" data-ps={`src/pages/service-areas/ann-arbor.astro:8eh0r0-${__psIdx}`}>
                    <img src={award.src} alt={award.alt} width="200" height="140" loading="lazy" data-ps={`src/pages/service-areas/ann-arbor.astro:sso599-${__psIdx}`} />
                  </a>
                ) : (
                  <div class="award-badge" data-ps={`src/pages/service-areas/ann-arbor.astro:qaf0w0-${__psIdx}`}>
                    <img src={award.src} alt={award.alt} width="200" height="140" loading="lazy" data-ps={`src/pages/service-areas/ann-arbor.astro:sso598-${__psIdx}`} />
                  </div>
                )}
              </li>
            ))}
          </ul>
          <ul class="awards-list" aria-hidden="true" inert>
            {awards.map((award, __psIdx) => (
              <li data-ps={`src/pages/service-areas/ann-arbor.astro:5jn8a4-${__psIdx}`}>
                {award.href ? (
                  <a class="award-badge" href={award.href} target="_blank" rel="noopener noreferrer" tabindex="-1" data-ps={`src/pages/service-areas/ann-arbor.astro:8eh0qe-${__psIdx}`}>
                    <img src={award.src} alt="" width="200" height="140" loading="lazy" data-ps={`src/pages/service-areas/ann-arbor.astro:sso597-${__psIdx}`} />
                  </a>
                ) : (
                  <div class="award-badge" data-ps={`src/pages/service-areas/ann-arbor.astro:qaf0vz-${__psIdx}`}>
                    <img src={award.src} alt="" width="200" height="140" loading="lazy" data-ps={`src/pages/service-areas/ann-arbor.astro:sso596-${__psIdx}`} />
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="local-practices" id="local-practices" data-ps="src/pages/service-areas/ann-arbor.astro:9z56br">
      <div class="local-container" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0vy">
        <div class="eyebrow-maroon" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0vc">Local Legal Services</div>
        <h2 class="section-h2" data-ps="src/pages/service-areas/ann-arbor.astro:eoc1za">Defense services for Ann Arbor</h2>
        <p class="section-intro" data-ps="src/pages/service-areas/ann-arbor.astro:ta3mnw">Ann Arbor brings together the University of Michigan campus, the Main Street and State Street downtown districts, and neighborhoods along the Huron River. Our office is on South Main Street in Ann Arbor. The guides below address local DUI/OWI defense, assault charges, domestic violence, and OWI/DUI expungements.</p>
        <div class="practice-grid" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0vb">
          {practiceCards.map((card, __psIdx) => (
            <article class="practice-card" data-ps={`src/pages/service-areas/ann-arbor.astro:c1265g-${__psIdx}`}>
              <h3 data-ps={`src/pages/service-areas/ann-arbor.astro:tcqz6z-${__psIdx}`}>{card.title}</h3>
              <p data-ps={`src/pages/service-areas/ann-arbor.astro:ta3mnx-${__psIdx}`}>{card.body}</p>
              <a href={card.href} class="practice-link" data-ps={`src/pages/service-areas/ann-arbor.astro:8eh0qd-${__psIdx}`}>{card.link}</a>
            </article>
          ))}
        </div>
        <a href="/practice-areas" class="view-practices" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0qc">View all practice areas</a>
      </div>
    </section>

    <section class="office-section" data-ps="src/pages/service-areas/ann-arbor.astro:9z56bs">
      <div class="local-container office-grid" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0va">
        <div data-ps="src/pages/service-areas/ann-arbor.astro:qaf0v9">
          <div class="eyebrow-maroon" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0v8">Law Offices of Joseph A. Simon</div>
          <h2 class="office-h2" data-ps="src/pages/service-areas/ann-arbor.astro:eoc1z9">Criminal defense is all we do.</h2>
          <p class="office-body" data-ps="src/pages/service-areas/ann-arbor.astro:ta3mny">The Law Offices of Joseph A. Simon is a full-service law firm handling only criminal defense matters, misdemeanor and felony, from traffic offenses to homicide cases.</p>
          <a href="/attorneys/joseph-a-simon" class="about-link" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0qb">About Joseph A. Simon →</a>
          <div class="office-card" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0v7">
            <h3 data-ps="src/pages/service-areas/ann-arbor.astro:tcqz6y">Our Ann Arbor Office</h3>
            <address>1310 South Main Street, Suite 11<br />Ann Arbor, MI 48104</address>
            <a class="directions-link" href="https://www.google.com/maps/dir/?api=1&amp;destination=1310+South+Main+Street+Suite+11+Ann+Arbor+MI+48104" target="_blank" rel="noopener" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0qa">Directions to our office →</a>
          </div>
        </div>
        <div data-ps="src/pages/service-areas/ann-arbor.astro:qaf0v6">
          <h2 class="map-h2" data-ps="src/pages/service-areas/ann-arbor.astro:eoc1z8">Serving Ann Arbor</h2>
          <iframe
            title="Map of Ann Arbor, Michigan service area"
            src="https://maps.google.com/maps?q=Ann%20Arbor%2C%20Michigan&amp;output=embed"
            width="100%"
            height="410"
            loading="lazy"
            class="map-frame"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
          <p class="map-caption" data-ps="src/pages/service-areas/ann-arbor.astro:ta3mnz">Service area: Ann Arbor, Michigan. Our office is in Ann Arbor.</p>
        </div>
      </div>
    </section>

    <section id="results" class="results-section" data-ps="src/pages/service-areas/ann-arbor.astro:9z56bt">
      <div class="local-container" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0v5">
        <div class="eyebrow-gold" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0v4">Courtroom Results</div>
        <h2 class="results-h2" data-ps="src/pages/service-areas/ann-arbor.astro:eoc1z7">Representative case results.</h2>
        <div class="case-grid" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0v3">
          {cases.map((c, __psIdx) => (
            <article class="case-card" data-ps={`src/pages/service-areas/ann-arbor.astro:c1265h-${__psIdx}`}>
              <div data-ps={`src/pages/service-areas/ann-arbor.astro:qaf0uh-${__psIdx}`}>
                <div class="case-category" data-ps={`src/pages/service-areas/ann-arbor.astro:qaf0ug-${__psIdx}`}>{c.category}</div>
                <h3 data-ps={`src/pages/service-areas/ann-arbor.astro:tcqz6x-${__psIdx}`}>{c.title}</h3>
                <p data-ps={`src/pages/service-areas/ann-arbor.astro:ta3mo0-${__psIdx}`}>{c.court}</p>
              </div>
              <span class="case-number" data-ps={`src/pages/service-areas/ann-arbor.astro:mmcxe3-${__psIdx}`}>{c.caseNo}</span>
            </article>
          ))}
        </div>
        <div class="results-footer" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0uf">
          <a href="/courtroom-victories" class="results-btn" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0q9">View all case results →</a>
          <p data-ps="src/pages/service-areas/ann-arbor.astro:ta3mo1">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
        </div>
      </div>
    </section>

    <section id="testimonials" class="testimonials-section" data-ps="src/pages/service-areas/ann-arbor.astro:9z56bu">
      <div class="local-container" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0ue">
        <div class="testimonials-head" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0ud">
          <div class="eyebrow-maroon" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0uc">Client Testimonials</div>
          <h2 class="reviews-h2" data-ps="src/pages/service-areas/ann-arbor.astro:eoc1yl">Client Reviews</h2>
          <a href="/reviews" class="reviews-link" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0q8">Read all client reviews →</a>
        </div>
        <div id="testimonials-track" class="review-grid" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0ub">
          {reviews.map((review, i) => (
            <article class="review-card" data-review-index={i} hidden={i >= 3 ? true : undefined} data-ps={`src/pages/service-areas/ann-arbor.astro:c1265i-${i}`}>
              <div data-ps={`src/pages/service-areas/ann-arbor.astro:qaf0ua-${i}`}>
                <div class="review-rating" data-ps={`src/pages/service-areas/ann-arbor.astro:qaf0u9-${i}`}>{review.rating}</div>
                <div class="review-copy" data-ps={`src/pages/service-areas/ann-arbor.astro:qaf0u8-${i}`}>{review.text}</div>
              </div>
              <div class="review-meta" data-ps={`src/pages/service-areas/ann-arbor.astro:qaf0tm-${i}`}><strong>Verified Client Review</strong></div>
            </article>
          ))}
        </div>
        <div class="review-pager" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0tl">
          <button type="button" id="reviews-prev" class="pager-btn" aria-label="Previous reviews" data-ps="src/pages/service-areas/ann-arbor.astro:uu81yu">‹</button>
          <span id="reviews-position" class="pager-count" aria-live="polite" data-ps="src/pages/service-areas/ann-arbor.astro:mmcxe2">1 / 2</span>
          <button type="button" id="reviews-next" class="pager-btn" aria-label="Next reviews" data-ps="src/pages/service-areas/ann-arbor.astro:uu81yv">›</button>
        </div>
      </div>
    </section>

    <section class="service-areas-section" data-ps="src/pages/service-areas/ann-arbor.astro:9z56bv">
      <div class="local-container" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0tk">
        <h2 class="service-h2" data-ps="src/pages/service-areas/ann-arbor.astro:eoc1yk">Explore Our Service Areas</h2>
        <div class="service-pills" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0tj">
          {serviceAreas.map((area, __psIdx) => (
            <a class="service-pill" href={area.href} data-ps={`src/pages/service-areas/ann-arbor.astro:8eh0q7-${__psIdx}`}>{area.name}</a>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section" data-ps="src/pages/service-areas/ann-arbor.astro:9z56ch">
      <div class="contact-container" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0ti">
        <div class="contact-grid" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0th">
          <div data-ps="src/pages/service-areas/ann-arbor.astro:qaf0tg">
            <div class="contact-eyebrow" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0tf"><span class="contact-rule" data-ps="src/pages/service-areas/ann-arbor.astro:mmcxe1"></span><span data-ps="src/pages/service-areas/ann-arbor.astro:mmcxe0">CONFIDENTIAL CONSULTATION</span></div>
            <h2 class="contact-h2" data-ps="src/pages/service-areas/ann-arbor.astro:eoc1yj">Contact us for a Free Confidential Consultation</h2>
            <p class="contact-intro" data-ps="src/pages/service-areas/ann-arbor.astro:ta3mo2">Located in Ann Arbor, Michigan, the Law Offices of Joseph A. Simon handles all criminal defense matters primarily in Washtenaw County but also service all surrounding counties. Contact us to receive a free, confidential consultation with one of our attorneys at <a href="tel:+17348876200" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0q6">734-887-6200</a> or email Mr. Simon at <a href="mailto:joe@simoncriminaldefense.com" class="break-words" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0q5">joe@simoncriminaldefense.com</a>.</p>
            <div class="contact-details" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0te">
              <div class="contact-detail" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0td">
                <div class="detail-icon" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0sr"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"></path></svg></div>
                <div data-ps="src/pages/service-areas/ann-arbor.astro:qaf0sq">
                  <div class="detail-label" data-ps="src/pages/service-areas/ann-arbor.astro:qaf0sp">CALL ANYTIME</div>
                  <a href="tel:+17348876200" class="detail-phone" data-ps="src/pages/service-areas/ann-arbor.astro:8eh0pj">(734) 887-6200</a>
