  <section class="bg-[#F7F5F1] py-[100px]" data-ps="src/pages/reviews.astro:wlfwka">
    <div class="max-w-[1280px] mx-auto px-6" data-ps="src/pages/reviews.astro:18bikv">
      <div class="text-center mb-12" data-ps="src/pages/reviews.astro:18biku">
        <div class="mb-4" data-ps="src/pages/reviews.astro:6ww4a2">
          <span class="inline-flex items-center text-[12px] font-bold uppercase tracking-[1.8px] text-[#732521]" data-ps="src/pages/reviews.astro:z5g4jv"><span class="w-[28px] h-[2px] bg-[#C9A840] inline-block mr-3" data-ps="src/pages/reviews.astro:z5g4jw"></span>In Their Own Words</span>
        </div>
        <h2 class="text-[44px] font-black leading-[1.14] tracking-[-0.53px] text-[#061633] mb-4 max-w-[820px] mx-auto" data-ps="src/pages/reviews.astro:wgygs">Reviews from clients &amp; families.</h2>
        <p class="text-[18.08px] leading-[31px] text-[#454F5E] max-w-[680px] mx-auto" data-ps="src/pages/reviews.astro:nx7zlg">What clients and their families have shared, in their own words, about working with Joseph A. Simon.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/reviews.astro:6ww4a1">
        {reviews.map((rv, __psIdx) => (
          <article class="bg-white border border-[#E6E2D9] rounded-[10px] p-7 text-left shadow-sm flex flex-col min-w-0" data-ps={`src/pages/reviews.astro:yncwe1-${__psIdx}`}>
            <div class="text-[#C9A840] text-[16px] mb-3" data-ps={`src/pages/reviews.astro:6ww4a0-${__psIdx}`}>Rating: {rv.r}</div>
