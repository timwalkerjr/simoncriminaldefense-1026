---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import AwardLogos from '@/components/home/AwardLogos.astro';
import PracticeAreas from '@/components/home/PracticeAreas.astro';
import AttorneyBio from '@/components/home/AttorneyBio.astro';
import ServiceAreas from '@/components/home/ServiceAreas.astro';
import CaseResults from '@/components/home/CaseResults.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import ArrestFaq from '@/components/home/ArrestFaq.astro';
import StatsBanner from '@/components/home/StatsBanner.astro';
import ContactForm from '@/components/home/ContactForm.astro';
import { SITE } from '@/config/site';


---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
>
  <Hero />
  <AwardLogos />
  <PracticeAreas />
  <AttorneyBio />
  <ServiceAreas />
  <CaseResults />
  <Testimonials />
  <ArrestFaq />
  <StatsBanner />
  <ContactForm />
</BaseLayout>
