---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Awards from '@/components/home/Awards.astro';
import PracticeAreas from '@/components/home/PracticeAreas.astro';
import About from '@/components/home/About.astro';
import ServiceAreas from '@/components/home/ServiceAreas.astro';
import CaseResults from '@/components/home/CaseResults.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import FaqSection from '@/components/home/FaqSection.astro';
import StatsBanner from '@/components/home/StatsBanner.astro';
import ContactForm from '@/components/home/ContactForm.astro';
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: new URL(Astro.url.pathname, SITE.url).toString(),
    sameAs: Object.values(SITE.socials),
  }}
>
  <Hero />
  <Awards />
  <PracticeAreas />
  <About />
  <ServiceAreas />
  <CaseResults />
  <Testimonials />
  <FaqSection />
  <StatsBanner />
  <ContactForm />
</BaseLayout>
