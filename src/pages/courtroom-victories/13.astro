---
import BaseLayout from '@/layouts/BaseLayout.astro';

const cases = [
  { id: '10-317-sd', caseNo: '10-317 SD', charges: 'Reckless Driving', result: 'Reduced to Civil Infraction', court: '14A-3 District Court' },
  { id: '10-298', caseNo: '10-298', charges: 'Operating While Intoxicated', result: 'Charge Reduced to Careless Driving', court: '14A-1 District Court' },
  { id: '10-282', caseNo: '10-282', charges: 'Indecent Exposure', result: 'Charge Dismissed', court: '14A-4 District Court' },
  { id: '10-262-od', caseNo: '10-262 OD', charges: 'Operating While Intoxicated', result: 'Charge Reduced to Careless Driving', court: '14A-2' },
  { id: '10-1887', caseNo: '10-1887', charges: 'OWI', result: 'Charge reduced to non-alcohol offense', court: '14A-1 District Court' },
  { id: '10-14602-fh', caseNo: '10-14602-FH', charges: 'CSC 3rd Degree', result: 'Charge reduced to Assault and Battery', court: '39th Circuit Court' },
