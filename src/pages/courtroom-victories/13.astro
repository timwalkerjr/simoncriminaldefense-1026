  { id: '10-1073-fh', caseNo: '10-1073-FH', charges: 'Home Invasion 1st Degree; Home Invasion 3rd Degree; Resisting and Obstructing Police Officer', result: 'Charges Dismissed', court: '22nd Circuit Court' },
  { id: '10-1028', caseNo: '10-1028', charges: 'Assault and Battery (2 Counts)', result: 'Not Guilty Verdict', court: '14A-1 District Court' },
  { id: '10-1026-fc', caseNo: '10-1026-FC', charges: 'Armed Robbery, Conspiracy to Commit Armed Robbery', result: 'Case Dismissed', court: '22nd Circuit Court' },
  { id: '10-0952', caseNo: '10-0952', charges: 'Reckless Driving, Driving While License Suspended, Leaving the Scene of a Property Damage Accident', result: 'Not Guilty Verdict', court: '15th District Court' },
  { id: '10-0851', caseNo: '10-0851', charges: 'Retail Fraud 3rd Degree', result: 'Charge Dismissed', court: '15th District Court' },
  { id: '10-0127', caseNo: '10-0127', charges: 'Operating While Intoxicated', result: 'Reduced to Civil Infraction', court: '15th District Court' },
  { id: '10-006121', caseNo: '10-006121', charges: 'OWI Superdrunk', result: 'Not Guilty Verdict; Convicted of Lesser Charge', court: '52-1 District Court' },
  { id: '09-jc36631a', caseNo: '09-JC36631A', charges: 'Operating While Intoxicated', result: 'Charges reduced to civil infraction following Motion to Suppress Evidence', court: '12th District Court' },
  { id: '09-870-sd', caseNo: '09-870 SD', charges: 'Reckless Driving', result: 'Reduced to Civil Infraction', court: '14A-4 District Court' },
  { id: '09-786-fc', caseNo: '09-786 FC', charges: 'Kidnapping', result: 'Case Dismissed at Preliminary Examination', court: '22nd Circuit Court' },
  { id: '09-733', caseNo: '09-733', charges: 'Aggravated Assault', result: 'Case Dismissed', court: '14A-1 District Court' },
  { id: '09-559-fh', caseNo: '09-559-FH', charges: 'Allowing Intoxicated Person to Operate Causing Death, Contributing to Delinquency of Minors, and Furnishing Alcohol to Minors', result: 'Not Guilty Verdict', court: '22nd Circuit Court' },
  { id: '09-542-fc', caseNo: '09-542-FC', charges: 'Criminal Sexual Conduct First Degree; Assault with Intent to Commit Sexual Penetration; Aggravated Domestic Violence', result: 'Case Dismissed', court: '22nd Circuit Court' },
  { id: '09-527-fh', caseNo: '09-527 FH', charges: 'Felony Possession', result: 'Case Dismissed', court: '22nd Circuit Court' },
  { id: '09-446-sd', caseNo: '09-446 SD', charges: 'Operating While Intoxicated', result: 'Not Guilty Verdict', court: '14A-4 District Court' },
  { id: '09-395', caseNo: '09-395', charges: 'Retail Fraud', result: 'Case Dismissed', court: '22nd Circuit Court' },
