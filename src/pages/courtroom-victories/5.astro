---
import BaseLayout from '@/layouts/BaseLayout.astro';

const cases = [
  { id: '22f4-0093-fy-2', caseId: '22F4-0093-FY', charges: 'Assault With Intent to do Great Bodily Harm - Strangulation', result: 'Case Dismissed at Preliminary Examination', court: '22nd Circuit Court - 14A-4 District Court' },
  { id: '213-0337-ot', caseId: '213-0337-OT', charges: 'Failure to Stop and Provide Information Following an Accident', result: 'Charges Dismissed', court: '14A-3 District Court' },
  { id: '22f4-0093-fy', caseId: '22F4-0093-FY', charges: 'Domestic Assault with Intent to do Great Bodily Harm Less Than Murder or By Strangulation', result: 'Charges Dismissed at Preliminary Examination', court: '22nd Circuit Court; 14A-4 District Court' },
  { id: '21f5-5123-fy', caseId: '21F5-5123-FY', charges: 'Criminal Sexual Conduct, Third Degree, Assault with Intent to Do Great Bodily Harm Less Than Murder or By Strangulation, Domestic Violence', result: 'All Charges Dismissed at Preliminary Examination', court: '22nd Circuit Court' },
  { id: '211-0945-sm', caseId: '211-0945-SM', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '14A-1 District Court' },
  { id: '20-000612-fh', caseId: '20-000612-FH', charges: 'Felonious Assault - Assault with a Dangerous Weapon', result: 'Charges Dismissed at Trial', court: '22nd Circuit Court' },
  { id: '201-1183-sm', caseId: '201-1183-SM', charges: 'Aggravated Assault', result: 'Charges Dismissed', court: '14A-1 District Court' },
  { id: '17fb-1720-fy', caseId: '17FB-1720-FY', charges: 'Delivery/Manufacture Marijuana', result: 'Charges Dismissed at Preliminary Examination', court: '22nd Circuit Court' },
  { id: '20f5-5103-fy', caseId: '20F5-5103-FY', charges: 'Assault with a Dangerous Weapon (Felonious Assault), Aggravated Domestic Violence', result: 'Charges Dismissed', court: '22nd Circuit Court and 15th District Court' },
  { id: '21f2-0777-fy', caseId: '21F2-0777-FY', charges: 'Criminal Sexual Conduct, Third Degree', result: 'Charges Dismissed Following Preliminary Examination', court: '22nd Circuit Court' },
  { id: '21-0293-sm', caseId: '21-0293-SM', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '15th District Court' },
  { id: '21f4-0098-fy', caseId: '21F4-0098-FY', charges: 'Unlawful Driving Away an Automobile', result: 'Charges Dismissed at Preliminary Examination', court: '22nd Circuit Court' },
  { id: '201-0698-sd', caseId: '201-0698-SD', charges: 'OWI - Operating While Intoxicated', result: 'Charges Dismissed', court: '14-A1 District Court' },
  { id: '213-0165-sm', caseId: '213-0165-SM', charges: 'Aggravated Assault', result: 'Charges Dismissed', court: '14A-3 District Court' },
  { id: '211-0252-sm', caseId: '211-0252-SM', charges: 'Assault and Battery', result: 'Charges Dismissed', court: '14A-1 District Court' },
  { id: '162-1835-sm', caseId: '162-1835-SM', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '14A-2 District Court' },
  { id: '20-1562-fy', caseId: '20-1562-FY', charges: 'Felonious Assault - Assault with a Dangerous Weapon', result: 'Charges Dismissed at Preliminary Examination', court: '34th District Court' },
  { id: '21f5-5542-fy', caseId: '21F5-5542-FY', charges: 'Malicious Destruction of a Building - $1,000 or More but Less Than $20,000.00', result: 'Charges Dismissed at Preliminary Examination', court: '22nd Circuit Court/15th District Court' },
  { id: '21-056-sm', caseId: '21-056-SM', charges: 'Domestic Violence, Malicious Destruction of Property', result: 'Charges Dismissed', court: '15th District Court' },
  { id: '203-0446-sd', caseId: '203-0446-SD', charges: 'OWI - Operating While Intoxicated', result: 'Charge Reduced to Civil Infraction of Careless Driving', court: '14A-3 District Court' },
  { id: '18f5-5812-fy', caseId: '18F5-5812-FY', charges: 'Controlled Substance- Delivery/Manufacture Marijuana/Synthetic Equivalent', result: 'Charges Dismissed at Preliminary Examination', court: '22nd Circuit Court/15th District Court' },
  { id: '20-00416-sm', caseId: '20-00416-SM', charges: 'Assault and/or Assault and Battery', result: 'Charges Dismissed at Trial', court: '14-B Ditrict Court' },
  { id: '191-1835-sm', caseId: '191-1835-SM', charges: 'Assault or Assault & Battery', result: 'Not Guilty Verdict at Trial', court: '14A-1 District Court' },
  { id: '21f5-5524-fy', caseId: '21F5-5524-FY', charges: 'Felonious Assault - Assault with a Dangerous Weapon', result: 'Charges Dismissed at Preliminary Examination', court: '15th District Court - 22nd Circuit Court' },
];

const pageLinkBase = 'inline-flex items-center justify-center min-w-[44px] h-[44px] px-3 border border-[#E6E2D9] bg-white rounded-[3px] text-[15px] font-semibold text-[#061633] no-underline hover:border-[#732521] hover:text-[#732521] transition';
---

<BaseLayout
  title="Case Results — Page 5 | Law Offices of Joseph A. Simon"
  description="Real outcomes from cases handled by the Law Offices of Joseph A. Simon. Every case is different, and past results do not guarantee a similar outcome."
>
  <style is:global>
    /* Source header is solid navy on this page; the shared header is transparent by default. */
    #navbar {
      background-color: #061633;
    }
    /* Current pagination item: filled burgundy, overrides the idle white background. */
    a.page-current,
    a.page-current:hover {
      background-color: #732521;
      border-color: #732521;
      color: #ffffff;
    }
  </style>
  <main data-ps="src/pages/courtroom-victories/5.astro:wkmzk4">
    <section id="results" class="bg-[#F7F5F1] text-[#061633] pt-[150px] pb-[90px] lg:pb-[100px] border-t border-[#E6E2D9]" data-ps="src/pages/courtroom-victories/5.astro:8rfq7a">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/courtroom-victories/5.astro:6muywz">
        <div class="mb-12" data-ps="src/pages/courtroom-victories/5.astro:6muyx0">
          <div class="flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#732521] mb-3" data-ps="src/pages/courtroom-victories/5.astro:6muyx1">
            <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/courtroom-victories/5.astro:4rz7d1"></span>
            <span data-ps="src/pages/courtroom-victories/5.astro:4rz7d0">COURTROOM RESULTS</span>
          </div>
          <h1 class="font-heading font-black leading-[1.14] tracking-[-0.53px] mb-4 text-[36px] sm:text-[44px]" data-ps="src/pages/courtroom-victories/5.astro:wjksfv">Representative case results.</h1>
          <p class="text-[17px] sm:text-[18.08px] text-[#454F5E] leading-[1.65] max-w-[840px]" data-ps="src/pages/courtroom-victories/5.astro:fuhcsl">Real outcomes from cases handled by the firm. Every case is different, and past results do not guarantee a similar outcome.</p>
        </div>

        <div class="flex flex-wrap justify-between items-center gap-3 mb-6 text-[14px] text-[#454F5E]" data-ps="src/pages/courtroom-victories/5.astro:6muyx2">
          <p data-ps="src/pages/courtroom-victories/5.astro:fuhcsk">Showing 97–120 of 358 case results</p>
          <p data-ps="src/pages/courtroom-victories/5.astro:fuhcsj">Page 5 of 15</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/courtroom-victories/5.astro:6muyx3">
          {cases.map((c, __psIdx) => (
            <article data-case-id={c.id} id={c.id} class="bg-white border border-[#E6E2D9] p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840] transition min-w-0 break-words" data-ps={`src/pages/courtroom-victories/5.astro:ejtnm8-${__psIdx}`}>
              <div data-ps={`src/pages/courtroom-victories/5.astro:6muyx4-${__psIdx}`}>
                <div data-field="charges" class="text-[12px] font-bold uppercase text-[#732521] tracking-wider mb-2" data-ps={`src/pages/courtroom-victories/5.astro:6muyx5-${__psIdx}`}>{c.charges}</div>
                <h2 data-field="result" class="font-heading font-bold text-[#061633] leading-snug mb-3 text-[18.88px] whitespace-pre-line" data-ps={`src/pages/courtroom-victories/5.astro:hv5v8a-${__psIdx}`}>{c.result}</h2>
                <p data-field="court" class="text-[15px] text-[#454F5E] leading-[1.6] mb-6" data-ps={`src/pages/courtroom-victories/5.astro:fuhcsi-${__psIdx}`}>{c.court}</p>
              </div>
              <div class="border border-[#C9A840]/50 bg-[#F7F5F1] text-[#655018] text-[11.68px] font-bold px-3 py-1 rounded-[2px] tracking-wide self-start" data-ps={`src/pages/courtroom-victories/5.astro:6muyx6-${__psIdx}`}>
                Case <span data-field="name" data-ps={`src/pages/courtroom-victories/5.astro:4rz7cz-${__psIdx}`}>{c.caseId}</span>
              </div>
            </article>
          ))}
        </div>

        <nav aria-label="Case results pagination" class="flex flex-wrap items-center justify-center gap-2 mt-10" data-ps="src/pages/courtroom-victories/5.astro:5kab2v">
          <a rel="prev" class={`${pageLinkBase} px-5`} href="/courtroom-victories/4" data-ps="src/pages/courtroom-victories/5.astro:8qjg4a">← Previous</a>
          <a class={pageLinkBase} href="/courtroom-victories" aria-label="Page 1" data-ps="src/pages/courtroom-victories/5.astro:8qjg49">1</a>
          <span class="px-1 text-[#454F5E]" aria-hidden="true" data-ps="src/pages/courtroom-victories/5.astro:4rz7cy">…</span>
          <a class={pageLinkBase} href="/courtroom-victories/4" aria-label="Page 4" data-ps="src/pages/courtroom-victories/5.astro:8qjg48">4</a>
          <a class={`${pageLinkBase} page-current`} href="/courtroom-victories/5" aria-label="Page 5" aria-current="page" data-ps="src/pages/courtroom-victories/5.astro:8qjg3m">5</a>
          <a class={pageLinkBase} href="/courtroom-victories/6" aria-label="Page 6" data-ps="src/pages/courtroom-victories/5.astro:8qjg3l">6</a>
          <span class="px-1 text-[#454F5E]" aria-hidden="true" data-ps="src/pages/courtroom-victories/5.astro:4rz7cx">…</span>
          <a class={pageLinkBase} href="/courtroom-victories/15" aria-label="Page 15" data-ps="src/pages/courtroom-victories/5.astro:8qjg3k">15</a>
          <a rel="next" class={`${pageLinkBase} px-5`} href="/courtroom-victories/6" data-ps="src/pages/courtroom-victories/5.astro:8qjg3j">Next →</a>
        </nav>

        <p class="text-center text-[13px] text-[#454F5E] mt-8" data-ps="src/pages/courtroom-victories/5.astro:fuhcsh">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
        <div class="text-center mt-6" data-ps="src/pages/courtroom-victories/5.astro:6muyx7">
          <a href="/#contact" class="text-[#732521] font-bold underline underline-offset-4" data-ps="src/pages/courtroom-victories/5.astro:8qjg3i">Request a confidential consultation →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
