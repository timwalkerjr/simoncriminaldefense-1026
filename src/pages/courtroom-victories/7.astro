---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Case Results — Page 7 | Law Offices of Joseph A. Simon';
const pageDescription =
  'Real outcomes from cases handled by the Law Offices of Joseph A. Simon. Every case is different, and past results do not guarantee a similar outcome.';

const cases = [
  { id: '19s-0042sm', caseId: '66aa4f5d078bef17fc3fa4bf', charges: 'Child Abuse', result: 'Not Guilty Verdict at Trial', court: '14-B District Court', name: '19S-0042SM' },
  { id: '19s-00414-sm', caseId: '66aa4f5d078bef17fc3fa4be', charges: 'Assault & Battery', result: 'Charges Dismissed', court: '14-B District Court', name: '19S-00414-SM' },
  { id: '19-fb-1405-fy', caseId: '66aa4f5d078bef17fc3fa4ae', charges: 'Assault & Reckless Driving', result: 'Cases Dismissed at Trial', court: '14-B District Court', name: '19-FB-1405-FY' },
  { id: '19f5-5651-fy', caseId: '66aa4f5d078bef17fc3fa4bc', charges: 'Criminal Sexual Conduct, First Degree, 4 Counts; Criminal Sexual Conduct, Second Degree, Four Counts', result: 'Cases Dismissed Following Preliminary Examination', court: '22nd Circuit Court', name: '19F5-5651-FY' },
  { id: '19f5-5180-fy', caseId: '66aa4f5d078bef17fc3fa4bb', charges: 'Assault with a Dangerous Weapon & Assault or Assault and Battery', result: 'Charges Dismissed Following Preliminary Examination', court: '22nd Circuit Court', name: '19F5-5180-FY' },
  { id: '19f2-1343-fy', caseId: '66aa4f5d078bef17fc3fa4ba', charges: 'Resisting & Opposing Police', result: 'Case dismissed at Preliminary Examination', court: '22nd Circuit Court', name: '19F2-1343-FY' },
  { id: '19f1-0261-fy', caseId: '66aa4f5d078bef17fc3fa4b9', charges: 'Felonious Assault', result: 'Case Dismissed at Preliminary Examination', court: '14-A1 District Court', name: '19F1-0261-FY' },
  { id: '19b-1405-fy', caseId: '66aa4f5d078bef17fc3fa4b8', charges: 'Felonious Assault', result: 'Case Dismissed Following Preliminary Examination', court: '14-A1 District Court', name: '19B-1405-FY' },
  { id: '193-0277-sm', caseId: '66aa4f5d078bef17fc3fa4b7', charges: 'Domestic Violence', result: 'Not Guilty Verdict at Trial', court: '14-A3 District Court', name: '193-0277-SM' },
  { id: '193-0036-sd', caseId: '66aa4f5d078bef17fc3fa4b6', charges: 'Operating While Intoxicated (OWI)', result: 'Not Guilty Verdict at Trial', court: '14-A3 District Court', name: '193-0036-SD' },
  { id: '192-0093-sm', caseId: '66aa4f5d078bef17fc3fa4b4', charges: 'Reckless Discharge of a Firearm', result: 'Not Guilty Verdict at Trial', court: '14-2 District Court', name: '192-0093-SM' },
  { id: '191-1737-od', caseId: '66aa4f5d078bef17fc3fa4b2', charges: 'OWI - Operating While Intoxicated', result: 'OWI Charges Dismissed in favor of plea to civil infraction of Careless Driving following Defense Motion to Suppress Evidence.', court: '14A-1 District Court', name: '191-1737-OD' },
  { id: '191-1284-sm', caseId: '66aa4f5d078bef17fc3fa4b0', charges: 'Domestic Violence (Two Counts)', result: 'Not Guilty Verdicts at Trial', court: '14A-1 District Court', name: '191-1284-SM' },
  { id: '191-0254-st', caseId: '66aa4f5d078bef17fc3fa4af', charges: 'Failure to Stop After a Collision', result: 'Case Dismissed at Trial', court: '14A-1 District Court', name: '191-0254-ST' },
  { id: '19-0510-sm', caseId: '66aa4f5d078bef17fc3fa4ac', charges: 'Larceny - Less Than $200.00; Assault & Battery', result: 'Not Guilty Verdicts at Trial', court: '15th District Court', name: '19-0510-SM' },
  { id: '19-000054-fh', caseId: '66aa4f5d078bef17fc3fa4a8', charges: 'Carrying Concealed Weapon', result: 'Not Guilty Verdict at Trial', court: '22nd Circuit Court', name: '19-000054-FH' },
  { id: '18fb-1871-fy', caseId: '66aa4f5d078bef17fc3fa4a7', charges: 'Felonious Domestic Assault', result: 'Case Dismissed at Preliminary Examination', court: '22nd Circuit Court', name: '18FB-1871-FY' },
  { id: '18f5-5120-fy', caseId: '66aa4f5d078bef17fc3fa4a5', charges: 'Criminal Sexual Conduct, Third Degree', result: 'Case dismissed at Preliminary Examination', court: '22nd Circuit Court', name: '18F5-5120-FY' },
  { id: '18f5-5035-fy', caseId: '66aa4f5d078bef17fc3fa4a4', charges: 'Criminal Sexual Conduct - 3rd Degree', result: 'Criminal Sexual Conduct Charge Dismissed Following Preliminary Examination', court: '22nd Circuit Court', name: '18F5-5035 FY' },
  { id: '18-683-fh', caseId: '66aa4f5d078bef17fc3fa49d', charges: 'Felonious Assault', result: 'Case Dismissed At Trial', court: '22nd Circuit Court', name: '18-683-FH' },
  { id: '183-0477-sm', caseId: '66aa4f5d078bef17fc3fa4a3', charges: 'Assault and Battery', result: 'Not Guilty Verdict at Trial', court: '14-A3 District Court', name: '183-0477 SM' },
  { id: '183-0403-sm', caseId: '66aa4f5d078bef17fc3fa4a2', charges: 'Unauthorized Use of LEIN Data', result: 'Not Guilty Verdict at Trial', court: '14-A3 District Court', name: '183-0403 SM' },
  { id: '183-0010-sm', caseId: '66aa4f5d078bef17fc3fa4a1', charges: 'Possession of a Firearm While Under the Influence', result: 'Not Guilty Verdict at Trial', court: '14-A3 District Court', name: '183-0010-SM' },
  { id: '18-24997-fh', caseId: '66aa4f5d078bef17fc3fa49c', charges: 'Uttering and Publishing (6 Counts)', result: 'Charges Dismissed Following Defense Investigation', court: '44th Circuit Court', name: '18-24997-FH' },
];

const pageLinkClass =
  'page-link inline-flex items-center justify-center min-w-[44px] h-[44px] px-3 border border-[#E6E2D9] bg-white text-[#061633] font-bold text-[15px] rounded-[3px] hover:border-[#732521] hover:text-[#732521] transition';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section id="results" class="bg-[#F7F5F1] text-[#061633] pt-[150px] pb-[90px] lg:pb-[100px] border-t border-[#E6E2D9]" data-ps="src/pages/courtroom-victories/7.astro:b3467c">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/courtroom-victories/7.astro:wwis01">
      <div class="mb-12" data-ps="src/pages/courtroom-victories/7.astro:wwis02">
        <div class="flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#732521] mb-3" data-ps="src/pages/courtroom-victories/7.astro:wwis03">
          <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/courtroom-victories/7.astro:8qtu7y"></span>
          <span data-ps="src/pages/courtroom-victories/7.astro:8qtu7z">COURTROOM RESULTS</span>
        </div>
        <h1 class="font-heading font-black leading-[1.14] tracking-[-0.53px] mb-4 text-[36px] sm:text-[44px]" data-ps="src/pages/courtroom-victories/7.astro:llm85e">Representative case results.</h1>
        <p class="text-[17px] sm:text-[18.08px] text-[#454F5E] leading-[1.65] max-w-[840px]" data-ps="src/pages/courtroom-victories/7.astro:vie9q">Real outcomes from cases handled by the firm. Every case is different, and past results do not guarantee a similar outcome.</p>
      </div>

      <div class="flex flex-wrap justify-between items-center gap-3 mb-6 text-[14px] text-[#454F5E]" data-ps="src/pages/courtroom-victories/7.astro:wwis04">
        <p data-ps="src/pages/courtroom-victories/7.astro:vie9r">Showing 145–168 of 358 case results</p>
        <p data-ps="src/pages/courtroom-victories/7.astro:vie9s">Page 7 of 15</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/courtroom-victories/7.astro:wwis05">
        {cases.map((c, __psIdx) => (
          <article data-case-id={c.caseId} id={c.id} class="bg-white border border-[#E6E2D9] p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840] transition min-w-0 break-words" data-ps={`src/pages/courtroom-victories/7.astro:divxjm-${__psIdx}`}>
            <div data-ps={`src/pages/courtroom-victories/7.astro:wwis06-${__psIdx}`}>
              <div data-field="charges" class="text-[12px] font-bold uppercase text-[#732521] tracking-wider mb-2" data-ps={`src/pages/courtroom-victories/7.astro:wwis07-${__psIdx}`}>{c.charges}</div>
              <h2 data-field="result" class="font-heading font-bold text-[#061633] leading-snug mb-3 text-[18.88px] whitespace-pre-line" data-ps={`src/pages/courtroom-victories/7.astro:yr2wm5-${__psIdx}`}>{c.result}</h2>
              <p data-field="court" class="text-[15px] text-[#454F5E] leading-[1.6] mb-6" data-ps={`src/pages/courtroom-victories/7.astro:vie9t-${__psIdx}`}>{c.court}</p>
            </div>
            <div class="border border-[#C9A840]/50 bg-[#F7F5F1] text-[#655018] text-[11.68px] font-bold px-3 py-1 rounded-[2px] tracking-wide self-start" data-ps={`src/pages/courtroom-victories/7.astro:wwis08-${__psIdx}`}>
              Case <span data-field="name" data-ps={`src/pages/courtroom-victories/7.astro:8qtu80-${__psIdx}`}>{c.name}</span>
            </div>
          </article>
        ))}
      </div>

      <nav aria-label="Case results pagination" class="flex flex-wrap items-center justify-center gap-2 mt-10" data-ps="src/pages/courtroom-victories/7.astro:rez4tn">
        <a rel="prev" class={pageLinkClass} href="/courtroom-victories/6" data-ps="src/pages/courtroom-victories/7.astro:7zgay1">← Previous</a>
        <a class={pageLinkClass} href="/courtroom-victories" aria-label="Page 1" data-ps="src/pages/courtroom-victories/7.astro:7zgay2">1</a>
        <span class="px-1 text-[#454F5E]" aria-hidden="true" data-ps="src/pages/courtroom-victories/7.astro:8qtu81">…</span>
        <a class={pageLinkClass} href="/courtroom-victories/6" aria-label="Page 6" data-ps="src/pages/courtroom-victories/7.astro:7zgayo">6</a>
        <a class="inline-flex items-center justify-center min-w-[44px] h-[44px] px-3 border border-[#732521] bg-[#732521] text-white font-bold text-[15px] rounded-[3px]" href="/courtroom-victories/7" aria-label="Page 7" aria-current="page" data-ps="src/pages/courtroom-victories/7.astro:7zgayp">7</a>
        <a class={pageLinkClass} href="/courtroom-victories/8" aria-label="Page 8" data-ps="src/pages/courtroom-victories/7.astro:7zgayq">8</a>
        <span class="px-1 text-[#454F5E]" aria-hidden="true" data-ps="src/pages/courtroom-victories/7.astro:8qtu8n">…</span>
        <a class={pageLinkClass} href="/courtroom-victories/15" aria-label="Page 15" data-ps="src/pages/courtroom-victories/7.astro:7zgayr">15</a>
        <a rel="next" class={pageLinkClass} href="/courtroom-victories/8" data-ps="src/pages/courtroom-victories/7.astro:7zgays">Next →</a>
      </nav>

      <p class="text-center text-[13px] text-[#454F5E] mt-8" data-ps="src/pages/courtroom-victories/7.astro:vie9u">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
      <div class="text-center mt-6" data-ps="src/pages/courtroom-victories/7.astro:wwis09">
        <a href="/#contact" class="text-[#732521] font-bold underline underline-offset-4" data-ps="src/pages/courtroom-victories/7.astro:7zgayt">Request a confidential consultation →</a>
      </div>
    </div>
  </section>
</BaseLayout>
