---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Case Results — Page 12 | Law Offices of Joseph A. Simon';
const description =
  'Real outcomes from cases handled by the Law Offices of Joseph A. Simon. Every case is different, and past results do not guarantee a similar outcome.';

const cases = [
  { id: '11-11-fc', charges: 'Armed Robbery', result: 'Charge dismissed', court: '22nd Circuit Court', name: '11-11-FC' },
  { id: '11-1155-sd', charges: 'Operating While Intoxicated With a High Blood Alcohol Content', result: 'Acquitted of High Blood Alcohol Charge at Non-Jury Trial', court: '14A1', name: '11-1155 SD' },
  { id: '11-1103-sm', charges: 'Domestic Violence', result: 'Case Dismissed Following Further Investigation by Prosecutor on Information Supplied by Defense', court: '12th District Court', name: '11-1103 SM' },
  { id: '11-1069', charges: 'OWI', result: 'Charge reduced to Minor in Possession of Alcohol', court: '34th District Court', name: '11-1069' },
  { id: '11-0987-od', charges: 'Operating While Intoxicated', result: 'Reduced to Careless Driving', court: '15th District Court', name: '11-0987 OD' },
  { id: '11-0391-od', charges: 'Operating While Intoxicated', result: 'Case Dismissed Following Evidentiary Hearing', court: '15th District Court', name: '11-0391 OD' },
  { id: '11-0381-sm', charges: 'Assault and Battery', result: 'Case Dismissed Following Further Investigation by Prosecutor on Information Supplied by Defense', court: '15th District Court', name: '11-0381 SM' },
  { id: '11-0236', charges: 'Retail Fraud 3rd Degree', result: 'Charge Dismissed on Defense Motion', court: '15th District Court', name: '11-0236' },
  { id: '11-0067', charges: 'Domestic Violence (2 Counts)', result: 'Not Guilty Verdict', court: '15th District Court', name: '11-0067' },
  { id: '11-0056', charges: 'OWI', result: 'Charge reduced to Careless Driving', court: '15th District Court', name: '11-0056' },
  { id: '10we08149', charges: 'Possession of Marijuana', result: 'Case Dismissed', court: '18th District Court', name: '10WE08149' },
  { id: '10-s-225477-a', charges: 'Failure to Stop After Property Damage Accident', result: 'Charges Dismissed', court: '35th District Court', name: '10-S-225477-A' },
  { id: '10-962-sm', charges: 'Embezzlement', result: 'Charge Dismissed on Defense Motion', court: '14A-3 District Court', name: '10-962 SM' },
  { id: '10-952', charges: 'Domestic Violence', result: 'Charge Dismissed on Defense Motion', court: '14A-2 District Court', name: '10-952' },
  { id: '10-849-sm', charges: 'Aggravated Domestic Assault', result: 'Charge Dismissed', court: '14A-3 District Court', name: '10-849 SM' },
  { id: '10-831', charges: 'Retail Fraud 3rd Degree', result: 'Charge Dismissed', court: '22nd Circuit Court', name: '10-831' },
  { id: '10-815-fh', charges: 'Child Abuse 1st Degree, Child Abuse 2nd Degree', result: 'Charges Dismissed at Preliminary Examination', court: '22nd Circuit Court', name: '10-815-FH' },
  { id: '10-73-fh', charges: 'Possession with Intent to Deliver Cocaine', result: 'Charges Dismissed following Motion to Suppress Evidence', court: '22nd Circuit Court', name: '10-73-FH' },
  { id: '10-66-sd', charges: 'Driving While License Suspended', result: 'Case Dismissed', court: '15th District Court', name: '10-66 SD' },
  { id: '10-650-sm', charges: 'Domestic Violence', result: 'Not Guilty Verdict', court: '14A-2 District Court', name: '10-650 SM' },
  { id: '10-540-sd', charges: 'Operating While Intoxicated', result: 'Charges Dismissed following Evidentiary Hearing', court: '14A-3 District Court', name: '10-540 SD' },
  { id: '10-501-sm', charges: 'Aggravated Assault', result: 'Case Dismissed', court: '14A-2 District Court', name: '10-501 SM' },
  { id: '10-402', charges: 'Possession of Marijuana', result: 'Charges Dismissed', court: '22nd Circuit Court', name: '10-402' },
  { id: '10-325', charges: 'Assault and Battery; Minor in Possession', result: 'Case Dismissed', court: '15th District Court', name: '10-325' },
];

const pages = [
  { label: '←  Previous', href: '/courtroom-victories/11', rel: 'prev' },
  { label: '1', href: '/courtroom-victories' },
  { label: '…', href: null },
  { label: '11', href: '/courtroom-victories/11' },
  { label: '12', href: '/courtroom-victories/12', current: true },
  { label: '13', href: '/courtroom-victories/13' },
  { label: '…', href: null },
  { label: '15', href: '/courtroom-victories/15' },
  { label: 'Next →', href: '/courtroom-victories/13', rel: 'next' },
];
---

<BaseLayout title={title} description={description} headerVariant="solid">
  <main data-ps="src/pages/courtroom-victories/12.astro:yy50g">
    <section id="results" class="bg-[#F7F5F1] text-[#061633] pt-[150px] pb-[90px] lg:pb-[100px] border-t border-[#E6E2D9]" data-ps="src/pages/courtroom-victories/12.astro:bfpqye">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/courtroom-victories/12.astro:vfbt5r">
        <div class="mb-12" data-ps="src/pages/courtroom-victories/12.astro:vfbt5s">
          <div class="flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#732521] mb-3" data-ps="src/pages/courtroom-victories/12.astro:vfbt5t">
            <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/courtroom-victories/12.astro:srlx7k"></span>
            <span data-ps="src/pages/courtroom-victories/12.astro:srlx7l">COURTROOM RESULTS</span>
          </div>
          <h1 class="font-heading font-black leading-[1.14] tracking-[-0.53px] mb-4 text-[36px] sm:text-[44px]" data-ps="src/pages/courtroom-victories/12.astro:jlfwin">Representative case results.</h1>
          <p class="text-[17px] sm:text-[18.08px] text-[#454F5E] leading-[1.65] max-w-[840px]" data-ps="src/pages/courtroom-victories/12.astro:tojwrl">Real outcomes from cases handled by the firm. Every case is different, and past results do not guarantee a similar outcome.</p>
        </div>

        <div class="flex flex-wrap justify-between items-center gap-3 mb-6 text-[14px] text-[#454F5E]" data-ps="src/pages/courtroom-victories/12.astro:vfbt5u">
          <p data-ps="src/pages/courtroom-victories/12.astro:tojwrk">Showing 265–288 of 358 case results</p>
          <p data-ps="src/pages/courtroom-victories/12.astro:tojwrj">Page 12 of 15</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/courtroom-victories/12.astro:vfbt5v">
          {cases.map((c, __psIdx) => (
            <article id={c.id} class="bg-white border border-[#E6E2D9] p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840] transition min-w-0 break-words" data-ps={`src/pages/courtroom-victories/12.astro:1fixpw-${__psIdx}`}>
              <div data-ps={`src/pages/courtroom-victories/12.astro:vfbt5w-${__psIdx}`}>
                <div class="text-[12px] font-bold uppercase text-[#732521] tracking-wider mb-2" data-ps={`src/pages/courtroom-victories/12.astro:vfbt5x-${__psIdx}`}>{c.charges}</div>
                <h2 class="font-heading font-bold text-[#061633] leading-snug mb-3 text-[18.88px]" data-ps={`src/pages/courtroom-victories/12.astro:4x0zb2-${__psIdx}`}>{c.result}</h2>
                <p class="text-[15px] text-[#454F5E] leading-[1.6] mb-6" data-ps={`src/pages/courtroom-victories/12.astro:tojwri-${__psIdx}`}>{c.court}</p>
              </div>
              <div class="border border-[#C9A840]/50 bg-[#F7F5F1] text-[#655018] text-[11.68px] font-bold px-3 py-1 rounded-[2px] tracking-wide self-start" data-ps={`src/pages/courtroom-victories/12.astro:vfbt5y-${__psIdx}`}>
                Case <span data-ps={`src/pages/courtroom-victories/12.astro:srlx7m-${__psIdx}`}>{c.name}</span>
              </div>
            </article>
          ))}
        </div>

        <nav aria-label="Case results pagination" class="flex flex-wrap items-center justify-center gap-2 mt-10" data-ps="src/pages/courtroom-victories/12.astro:ie0v8z">
          {pages.map((p) =>
            p.href ? (
              <a
                href={p.href}
                rel={p.rel}
                aria-current={p.current ? 'page' : undefined}
                class={
                  p.current
                    ? 'min-w-[44px] text-center px-3 py-2 border border-[#732521] bg-[#732521] text-white font-bold rounded-[3px]'
                    : 'min-w-[44px] text-center px-3 py-2 border border-[#E6E2D9] bg-white text-[#732521] font-bold rounded-[3px] hover:border-[#C9A840] transition'
                }
               data-ps="src/pages/courtroom-victories/12.astro:mkm02i">
                {p.label}
              </a>
            ) : (
              <span class="px-1 text-[#454F5E]" aria-hidden="true" data-ps="src/pages/courtroom-victories/12.astro:srlx7n">{p.label}</span>
            ),
          )}
        </nav>

        <p class="text-center text-[13px] text-[#454F5E] mt-8" data-ps="src/pages/courtroom-victories/12.astro:tojwrh">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
        <div class="text-center mt-6" data-ps="src/pages/courtroom-victories/12.astro:vfbt5z">
          <a href="/#contact" class="text-[#732521] font-bold underline underline-offset-4" data-ps="src/pages/courtroom-victories/12.astro:mkm02h">Request a confidential consultation →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
