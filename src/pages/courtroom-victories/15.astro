---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Case Results — Page 15 | Law Offices of Joseph A. Simon';
const description =
  'Real outcomes from cases handled by the Law Offices of Joseph A. Simon. Every case is different, and past results do not guarantee a similar outcome.';

const cases = [
  { id: '08-2050-sm', charges: 'Domestic Violence', result: 'Not Guilty Verdict', court: '14A-2 District Court', name: '08-2050 SM' },
  { id: '08-1465-sd', charges: 'Domestic Violence', result: 'Directed Verdict Granted, Case Dismissed', court: '14A-3 District Court', name: '08-1465 SD' },
  { id: '08-1276-sm', charges: 'Aggravated Assault; Domestic Violence', result: 'Case Dismissed at Trial', court: '14A-2 District Court', name: '08-1276 SM' },
  { id: '08-1273-ot', charges: 'Failure to Stop; Property Damage Accident', result: 'Case Dismissed', court: '14A-1 District Court', name: '08-1273 OT' },
  { id: '08-120-sm', charges: 'Domestic Violence', result: 'Case Dismissed at Trial', court: '14A-2 District Court', name: '08-120 SM' },
  { id: '08-1095-sm', charges: 'Assault and Battery', result: 'Dismissed at trial', court: '15th District Court', name: '08-1095 SM' },
  { id: '08-1067-sm', charges: 'MDOP/Disorderly Person', result: 'Not Guilty Verdict', court: '15th District Court', name: '08-1067 SM' },
  { id: '08-0801', charges: 'Assault and Battery', result: 'Not Guilty Verdict', court: '15th District Court', name: '08-0801' },
  { id: '08-0777-fh', charges: 'Felonious Assault, Assault with a Dangerous Weapon, Domestic Violence, OWI', result: 'Violation of Probation Allegation Dismissed at hearing', court: '22nd Circuit Court', name: '08-0777 FH' },
  { id: '08-0686', charges: 'Illegal Entry', result: 'Directed Verdict Granted, Case Dismissed', court: '15th District Court', name: '08-0686' },
  { id: '08-0678', charges: 'Domestic Violence', result: 'Case Dismissed', court: '15th District Court', name: '08-0678' },
  { id: '08-0558-sm', charges: 'Assault', result: 'Not Guilty Verdict', court: '15th District Court', name: '08-0558 SM' },
  { id: '07-905-om', charges: 'Possession of Drug Paraphernalia', result: 'Motion to Suppress Evidence granted, felony charges dismissed', court: '14B District Court', name: '07-905 OM' },
  { id: '07-2419-sm', charges: 'Domestic Violence', result: 'Not Guilty Verdict', court: '14A-2 District Court', name: '07-2419 SM' },
  { id: '07-2380-sm', charges: 'Domestic Violence', result: 'Not Guilty Verdict', court: '14A-2 District Court', name: '07-2380 SM' },
  { id: '07-1803', charges: 'Restricting and Obstructing an Officer', result: 'Case Dismissed', court: '3rd Circuit Court', name: '07-1803' },
  { id: '07-13509', charges: 'Domestic Violence', result: 'Dismissed at jury trial', court: '15th District Court', name: '07-13509' },
  { id: '07-1216', charges: 'Operating While Intoxicated 2nd Offense', result: 'Charge Dismissed at Non-Jury Trial', court: '14A-2 District Court', name: '07-1216' },
  { id: '06s-00032-sm', charges: 'Computer Fraud Larceny Under $200.00', result: 'Dismissed at Non-Jury Trial', court: '14B District Court', name: '06S-00032 SM' },
  { id: '05-873-fh', charges: 'Ethnic Intimidation; Assault and Battery', result: 'Dismissed at Preliminary Examination', court: '22nd Circuit Court', name: '05-873 FH' },
  { id: '04-829-sm', charges: 'Possession of Marijuana', result: 'Case Dismissed', court: '15th District Court', name: '04-829 SM' },
  { id: '01-403-sm', charges: 'Retail Fraud 3rd Degree', result: 'Dismissed at Non-Jury Trial', court: '14A-3 District Court', name: '01-403 SM' },
];
---

<BaseLayout headerVariant="solid" title={title} description={description}>
  <main data-ps="src/pages/courtroom-victories/15.astro:l95pdv">
    <section id="results" class="bg-[#F7F5F1] text-[#061633] pt-[150px] pb-[90px] lg:pb-[100px] border-t border-[#E6E2D9]" data-ps="src/pages/courtroom-victories/15.astro:rkcy19">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/courtroom-victories/15.astro:zb9hss">
        <div class="mb-12" data-ps="src/pages/courtroom-victories/15.astro:zb9hst">
          <div class="flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#732521] mb-3" data-ps="src/pages/courtroom-victories/15.astro:zb9hsu">
            <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/courtroom-victories/15.astro:lzake5"></span>
            <span data-ps="src/pages/courtroom-victories/15.astro:lzake4">COURTROOM RESULTS</span>
          </div>
          <h1 class="font-heading font-black leading-[1.14] tracking-[-0.53px] mb-4 text-[36px] sm:text-[44px]" data-ps="src/pages/courtroom-victories/15.astro:q3sldq">Representative case results.</h1>
          <p class="text-[17px] sm:text-[18.08px] text-[#454F5E] leading-[1.65] max-w-[840px]" data-ps="src/pages/courtroom-victories/15.astro:4lka66">Real outcomes from cases handled by the firm. Every case is different, and past results do not guarantee a similar outcome.</p>
        </div>

        <div class="flex flex-wrap justify-between items-center gap-3 mb-6 text-[14px] text-[#454F5E]" data-ps="src/pages/courtroom-victories/15.astro:zb9hsv">
          <p data-ps="src/pages/courtroom-victories/15.astro:4lka65">Showing 337–358 of 358 case results</p>
          <p data-ps="src/pages/courtroom-victories/15.astro:4lka64">Page 15 of 15</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/courtroom-victories/15.astro:zb9hsw">
          {cases.map((c, __psIdx) => (
            <article id={c.id} class="bg-white border border-[#E6E2D9] p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840] transition min-w-0 break-words" data-ps={`src/pages/courtroom-victories/15.astro:3vne1-${__psIdx}`}>
              <div data-ps={`src/pages/courtroom-victories/15.astro:zb9hsx-${__psIdx}`}>
                <div data-field="charges" class="text-[12px] font-bold uppercase text-[#732521] tracking-wider mb-2" data-ps={`src/pages/courtroom-victories/15.astro:zb9hsy-${__psIdx}`}>{c.charges}</div>
                <h2 data-field="result" class="font-heading font-bold text-[#061633] leading-snug mb-3 text-[18.88px] whitespace-pre-line" data-ps={`src/pages/courtroom-victories/15.astro:u8wjdt-${__psIdx}`}>{c.result}</h2>
                <p data-field="court" class="text-[15px] text-[#454F5E] leading-[1.6] mb-6" data-ps={`src/pages/courtroom-victories/15.astro:4lka63-${__psIdx}`}>{c.court}</p>
              </div>
              <div class="border border-[#C9A840]/50 bg-[#F7F5F1] text-[#655018] text-[11.68px] font-bold px-3 py-1 rounded-[2px] tracking-wide self-start" data-ps={`src/pages/courtroom-victories/15.astro:zb9hsz-${__psIdx}`}>
                Case <span data-field="name" data-ps={`src/pages/courtroom-victories/15.astro:lzake3-${__psIdx}`}>{c.name}</span>
              </div>
            </article>
          ))}
        </div>

        <nav aria-label="Case results pagination" class="flex flex-wrap items-center justify-center gap-2 mt-10" data-ps="src/pages/courtroom-victories/15.astro:v2vals">
          <a rel="prev" class="page-link" href="/courtroom-victories/14" data-ps="src/pages/courtroom-victories/15.astro:2idmiw">← Previous</a>
          <a class="page-link" href="/courtroom-victories" aria-label="Page 1" data-ps="src/pages/courtroom-victories/15.astro:2idmix">1</a>
          <span class="px-1 text-[#454F5E]" aria-hidden="true" data-ps="src/pages/courtroom-victories/15.astro:lzake2">…</span>
          <a class="page-link" href="/courtroom-victories/14" aria-label="Page 14" data-ps="src/pages/courtroom-victories/15.astro:2idmiy">14</a>
          <a class="page-link" href="/courtroom-victories/15" aria-label="Page 15" aria-current="page" data-ps="src/pages/courtroom-victories/15.astro:bjcpfn">15</a>
        </nav>

        <p class="text-center text-[13px] text-[#454F5E] mt-8" data-ps="src/pages/courtroom-victories/15.astro:4lka62">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
        <div class="text-center mt-6" data-ps="src/pages/courtroom-victories/15.astro:zb9ht0">
          <a href="/#contact" class="text-[#732521] font-bold underline underline-offset-4" data-ps="src/pages/courtroom-victories/15.astro:bjcpfo">Request a confidential consultation →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0 14px;
    border: 1px solid #e6e2d9;
    border-radius: 3px;
    background: #ffffff;
    color: #061633;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .page-link:hover {
    border-color: #c9a840;
  }
  .page-link[rel='prev'] {
    color: #732521;
  }
  .page-link[aria-current='page'] {
    background: #732521;
    border-color: #732521;
    color: #ffffff;
  }
</style>
