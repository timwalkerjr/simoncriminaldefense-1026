  { id: '19fb-1638-fy', charges: 'Embezzlement - Agent or Trustee - $1000 or More But Less Than $20,000', result: 'Case Dismissed at Probable Cause Conference', court: '14-B District Court - 22nd Circuit Court', name: '19FB-1638-FY' },
