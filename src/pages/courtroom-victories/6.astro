---

<BaseLayout
  title="Case Results — Page 6 | Law Offices of Joseph A. Simon"
  description="Real outcomes from cases handled by the Law Offices of Joseph A. Simon. Every case is different, and past results do not guarantee a similar outcome."
  headerVariant="solid"
>
  <section id="results" class="bg-[#F7F5F1] text-[#061633] pt-[150px] pb-[90px] lg:pb-[100px] border-t border-[#E6E2D9]" data-ps="src/pages/courtroom-victories/6.astro:pla2s9">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/courtroom-victories/6.astro:fqv5j2">
      <div class="mb-12" data-ps="src/pages/courtroom-victories/6.astro:fqv5j1">
        <div class="flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#732521] mb-3" data-ps="src/pages/courtroom-victories/6.astro:fqv5j0">
          <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/courtroom-victories/6.astro:1zfbfh"></span>
          <span data-ps="src/pages/courtroom-victories/6.astro:1zfbfi">COURTROOM RESULTS</span>
        </div>
        <h1 class="font-heading font-black leading-[1.14] tracking-[-0.53px] mb-4 text-[36px] sm:text-[44px]" data-ps="src/pages/courtroom-victories/6.astro:u1kqub">Representative case results.</h1>
        <p class="text-[17px] sm:text-[18.08px] text-[#454F5E] leading-[1.65] max-w-[840px]" data-ps="src/pages/courtroom-victories/6.astro:7hhh9f">Real outcomes from cases handled by the firm. Every case is different, and past results do not guarantee a similar outcome.</p>
      </div>

      <div class="flex flex-wrap justify-between items-center gap-3 mb-6 text-[14px] text-[#454F5E]" data-ps="src/pages/courtroom-victories/6.astro:fqv5iz">
        <p data-ps="src/pages/courtroom-victories/6.astro:7hhh9e">Showing 121–144 of 358 case results</p>
        <p data-ps="src/pages/courtroom-victories/6.astro:7hhh9d">Page 6 of 15</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/courtroom-victories/6.astro:fqv5iy">
        {cases.map((c, __psIdx) => (
          <article id={c.id} class="bg-white border border-[#E6E2D9] p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840] transition min-w-0 break-words" data-ps={`src/pages/courtroom-victories/6.astro:e1cskx-${__psIdx}`}>
            <div data-ps={`src/pages/courtroom-victories/6.astro:fqv5ix-${__psIdx}`}>
              <div data-field="charges" class="text-[12px] font-bold uppercase text-[#732521] tracking-wider mb-2" data-ps={`src/pages/courtroom-victories/6.astro:fqv5iw-${__psIdx}`}>{c.charges}</div>
              <h2 data-field="result" class="font-heading font-bold text-[#061633] leading-snug mb-3 text-[18.88px] whitespace-pre-line" data-ps={`src/pages/courtroom-victories/6.astro:qb4dx8-${__psIdx}`}>{c.result}</h2>
              <p data-field="court" class="text-[15px] text-[#454F5E] leading-[1.6] mb-6" data-ps={`src/pages/courtroom-victories/6.astro:7hhh9c-${__psIdx}`}>{c.court}</p>
            </div>
            <div class="border border-[#C9A840]/50 bg-[#F7F5F1] text-[#655018] text-[11.68px] font-bold px-3 py-1 rounded-[2px] tracking-wide self-start" data-ps={`src/pages/courtroom-victories/6.astro:fqv5iv-${__psIdx}`}>
              Case <span data-field="name" data-ps={`src/pages/courtroom-victories/6.astro:1zfbfj-${__psIdx}`}>{c.name}</span>
            </div>
          </article>
        ))}
      </div>

      <nav aria-label="Case results pagination" class="flex flex-wrap items-center justify-center gap-2 mt-10" data-ps="src/pages/courtroom-victories/6.astro:axceve">
        <a rel="prev" class="page-link" href="/courtroom-victories/5" data-ps="src/pages/courtroom-victories/6.astro:djkkg">← Previous</a>
        <a class="page-link" href="/courtroom-victories" aria-label="Page 1" data-ps="src/pages/courtroom-victories/6.astro:djkkf">1</a>
        <span class="px-1 text-[#454F5E]" aria-hidden="true" data-ps="src/pages/courtroom-victories/6.astro:1zfbfk">…</span>
        <a class="page-link" href="/courtroom-victories/5" aria-label="Page 5" data-ps="src/pages/courtroom-victories/6.astro:djkke">5</a>
        <a class="page-link" href="/courtroom-victories/6" aria-label="Page 6" aria-current="page" data-ps="src/pages/courtroom-victories/6.astro:djkkd">6</a>
        <a class="page-link" href="/courtroom-victories/7" aria-label="Page 7" data-ps="src/pages/courtroom-victories/6.astro:djkkc">7</a>
        <span class="px-1 text-[#454F5E]" aria-hidden="true" data-ps="src/pages/courtroom-victories/6.astro:1zfbg6">…</span>
        <a class="page-link" href="/courtroom-victories/15" aria-label="Page 15" data-ps="src/pages/courtroom-victories/6.astro:dqhkmg">15</a>
        <a rel="next" class="page-link" href="/courtroom-victories/7" data-ps="src/pages/courtroom-victories/6.astro:dqhkmh">Next →</a>
      </nav>

      <p class="text-center text-[13px] text-[#454F5E] mt-8" data-ps="src/pages/courtroom-victories/6.astro:7hhh9b">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
      <div class="text-center mt-6" data-ps="src/pages/courtroom-victories/6.astro:fqv5iu">
        <a href="/#contact" class="text-[#732521] font-bold underline underline-offset-4" data-ps="src/pages/courtroom-victories/6.astro:dqhkmi">Request a confidential consultation →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid #e6e2d9;
    border-radius: 3px;
    background: #ffffff;
    color: #061633;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .page-link:hover {
    border-color: #c9a840;
  }
  .page-link[aria-current="page"] {
    background: #732521;
    border-color: #732521;
    color: #ffffff;
  }
</style>
