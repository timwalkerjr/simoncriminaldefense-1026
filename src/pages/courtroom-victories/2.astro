  { id: '25-0287-sm', caseId: '68936d575a8942dba9db3fa3', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '15th District Court', name: '25-0287-SM' },
  { id: '252-0453-st', caseId: '6892498f5dcf40f7cbb39e32', charges: 'Reckless Driving', result: 'Charges reduced to civil infraction', court: '14A-2 District Court', name: '252-0453-ST' },
  { id: '252-0435-sd', caseId: '6892494d579ce83032e0f1a7', charges: 'OWI - Operating While Intoxicated; Operating a Motor Vehicle Without Security; Operating an Unregistered Vehicle', result: 'Charges Dismissed in favor of a Careless Driving Civil Infraction', court: '14A-2 District Court', name: '252-0435-SD' },
  { id: 'no-254-0181-sm', caseId: '689248e00ae9f09aff3c2a77', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '14A-4 District Court', name: 'No. 254-0181-SM' },
  { id: 'no-254-0179-sm', caseId: '689248ae0ae9f09aff3c1204', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '14A-4 District Court', name: 'No: 254-0179-SM' },
  { id: '25f4-0118-fy', caseId: '683f529657510a7be127f387', charges: 'Assault With Intent to Commit Great Bodily Harm (Strangulation); Interference with an Electronic Communications Device; Malicious Destruction of Property $200-$1,000', result: 'Charges Dismissed', court: '22nd Circuit Court - 14A-3 District Court', name: '25F4-0118-FY' },
  { id: '00f5-0751-ft', caseId: '6819018bfdf65704207ae552', charges: 'Motor Vehicle Fraudulent Title', result: 'Charges Dismissed', court: '15th District Court - 22nd Circuit Court', name: '00F5-0751-FT' },
  { id: '25-0106-sm', caseId: '68139462a55e6ab82c7dab6f', charges: 'Assault or Assault and Battery', result: 'Charges Dismissed', court: '15th District Court', name: '25-0106-SM' },
  { id: '25-0037-sm', caseId: '68139414ea3e9cbf891810c3', charges: 'Aggravated Assault', result: 'Charges Dismissed', court: '15th District Court', name: '25-0037-SM' },
  { id: '25f5-5021-fy', caseId: '681392fb398d593f5896da44', charges: 'Assault With a Dangerous Weapon/Felonious Assault; Domestic Violence', result: 'Charges Dismissed', court: '15th District Court - 22nd District Court', name: '25F5-5021-FY' },
