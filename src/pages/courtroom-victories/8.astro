---
import BaseLayout from '@/layouts/BaseLayout.astro';

const cases = [
  { id: '182-0305-st', charges: 'Reckless Driving', result: 'Charge Dismissed at Trial', court: '14-A2 District Court', name: '182-0305 ST' },
  { id: '182-0204-sm', charges: 'Domestic Violence', result: 'Not Guilty Verdict at Trial', court: '14-A2 District Court', name: '182-0204 SM' },
  { id: '18-1462-od', charges: 'Operating While Intoxicated and Drag Racing', result: 'Criminal Charges Dismissed and Resolved to Civil Infraction', court: '2A District Court', name: '18-1462 OD' },
  { id: '181-2429-sm', charges: 'Domestic Violence', result: 'Case Dismissed at Trial', court: '14-A1 District Court', name: '181-2429-SM' },
  { id: '18-1133-od', charges: 'Operating While Intoxicated (OWI)', result: 'Dismissed and resolved to Civil Infractions', court: '2A District Court', name: '18-1133- OD' },
  { id: '18-1001-sd', charges: 'Operating While Intoxicated (OWI)', result: 'Dismissed and resolved to Civil Infractions', court: '2A District Court', name: '18-1001 SD' },
  { id: '18-0753-sm', charges: 'Retail Fraud, Third Degree', result: 'Not Guilty Verdict at Trial', court: '15th District Court', name: '18-0753-SM' },
  { id: '18-0415-sm', charges: 'Assault and Battery', result: 'Case dismissed at trial', court: '15th District Court', name: '18-0415-SM' },
  { id: '18-000705-ar', charges: 'Prosecutor Appeal of Motion to Suppress Evidence', result: "Appeal dismissed on Defendant's Motion", court: '22nd Circuit Court', name: '18-000705-AR' },
  { id: '17s-00451-sm', charges: 'Malicious Destruction of Property', result: 'Charges dismissed after defense investigation', court: '14-B District Court', name: '17S-00451-SM' },
  { id: '17fb-1666-fy', charges: 'Assault with Intent to do Great Bodily Harm Less Than Murder', result: 'Charges Dismissed on Motion after Preliminary Examination', court: '22nd Circuit Court', name: '17FB-1666 FY' },
  { id: '174-0027-sm', charges: 'Abandoning/Cruelty to 2 or 3 Animals', result: 'Not Guilty Verdict at Non-Jury Trial', court: '14-A4 District Court', name: '174-0027 SM' },
  { id: '173-0260-sd', charges: 'Operating While Intoxicated', result: 'Case Dismissed After Successful Defense Motion to Suppress Evidence', court: '14-A3 District Court', name: '173-0260 SD' },
  { id: '173-0258-sm', charges: 'Domestic Violence - Second Offense', result: 'Not Guilty Verdict at Non-Jury Trial', court: '14-A3 District Court', name: '173-0258 SM' },
  { id: '172-1129-sd', charges: 'Operating While Intoxicated', result: 'Case Dismissed After Successful Defense Motion to Suppress Evidence', court: '14-A2 District Court', name: '172-1129 SD' },
  { id: '171-0936-sm', charges: 'Assault and Battery', result: 'Not Guilty Verdict at Non-Jury Trial', court: '14-A1 District Court', name: '171-0936 SM' },
  { id: '17-0303-fy', charges: 'Felon in Possession of a Firearm and Felony Firearm', result: 'All Charges Dismissed after Preliminary Examination Hearing', court: '34th District Court', name: '17-0303 FY' },
  { id: '164-0284-sm', charges: 'Operating While Intoxicated - Second Offense', result: 'Not Guilty Verdict at Non-Jury Trial', court: '14A4 District Court', name: '164-0284 SM' },
  { id: '164-0200-sm', charges: 'Assault and Battery', result: 'Not Guilty Verdict at Trial', court: '14A4 District Court', name: '164-0200 SM' },
  { id: '163-0850-sm', charges: 'Domestic Violence', result: 'Not guilty Verdict at Non-Jury Trial', court: '14A3 District Court', name: '163-0850 SM' },
  { id: '163-0350-sm', charges: 'Domestic Violence', result: 'Case Dismissed at Pretrial', court: '14A3 District Court', name: '163-0350 SM' },
  { id: '161-2111-sm', charges: 'Aggravated Domestic Violence', result: 'Not Guilty Verdict at Non-Jury Trial', court: '14A1 District Court', name: '161-2111 SM' },
  { id: '16-0535-sd', charges: 'Operating While Intoxicated', result: 'Case Dismissed After Successful Defense Motion to Suppress Evidence', court: '15th District Court', name: '16-0535 SD' },
  { id: '16-001055-fh', charges: 'Felony Assault By Strangulation', result: 'Not Guilty Verdict at Jury Trial', court: '22nd Circuit Court', name: '16-001055 FH' },
];

const pageLinkBase = 'inline-flex items-center justify-center min-w-[44px] h-[44px] px-4 border border-[#E6E2D9] bg-white text-[15px] font-semibold text-[#061633] rounded-[3px] transition hover:border-[#732521] hover:text-[#732521]';
const pageLinkCurrent = 'inline-flex items-center justify-center min-w-[44px] h-[44px] px-4 border border-[#732521] bg-[#732521] text-white text-[15px] font-bold rounded-[3px]';
const ellipsis = 'px-1 text-[#454F5E]';
---

<BaseLayout
  title="Case Results — Page 8 | Law Offices of Joseph A. Simon"
  description="Real outcomes from cases handled by the Law Offices of Joseph A. Simon. Every case is different, and past results do not guarantee a similar outcome."
  headerVariant="solid"
>
  <section id="results" class="bg-[#F7F5F1] text-[#061633] pt-[150px] pb-[90px] lg:pb-[100px] border-t border-[#E6E2D9]" data-ps="src/pages/courtroom-victories/8.astro:n9lms7">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/courtroom-victories/8.astro:aisnk0">
      <div class="mb-12" data-ps="src/pages/courtroom-victories/8.astro:aisnk1">
        <div class="flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#732521] mb-3" data-ps="src/pages/courtroom-victories/8.astro:aisnk2">
          <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/courtroom-victories/8.astro:fi8d0f"></span>
          <span data-ps="src/pages/courtroom-victories/8.astro:fi8d0g">COURTROOM RESULTS</span>
        </div>
        <h1 class="font-heading font-black leading-[1.14] tracking-[-0.53px] mb-4 text-[36px] sm:text-[44px]" data-ps="src/pages/courtroom-victories/8.astro:d5npgh">Representative case results.</h1>
        <p class="text-[17px] sm:text-[18.08px] text-[#454F5E] leading-[1.65] max-w-[840px]" data-ps="src/pages/courtroom-victories/8.astro:98i9sv">Real outcomes from cases handled by the firm. Every case is different, and past results do not guarantee a similar outcome.</p>
      </div>

      <div class="flex flex-wrap justify-between items-center gap-3 mb-6 text-[14px] text-[#454F5E]" data-ps="src/pages/courtroom-victories/8.astro:aisnk3">
        <p data-ps="src/pages/courtroom-victories/8.astro:98i9sw">Showing 169–192 of 358 case results</p>
        <p data-ps="src/pages/courtroom-victories/8.astro:98i9sx">Page 8 of 15</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/courtroom-victories/8.astro:aisnk4">
        {cases.map((c, __psIdx) => (
          <article id={c.id} class="bg-white border border-[#E6E2D9] p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840] transition min-w-0 break-words" data-ps={`src/pages/courtroom-victories/8.astro:d0f2ib-${__psIdx}`}>
            <div data-ps={`src/pages/courtroom-victories/8.astro:aisnk5-${__psIdx}`}>
              <div class="text-[12px] font-bold uppercase text-[#732521] tracking-wider mb-2" data-ps={`src/pages/courtroom-victories/8.astro:aisnk6-${__psIdx}`}>{c.charges}</div>
              <h2 class="font-heading font-bold text-[#061633] leading-snug mb-3 text-[18.88px] whitespace-pre-line" data-ps={`src/pages/courtroom-victories/8.astro:ru2mo2-${__psIdx}`}>{c.result}</h2>
              <p class="text-[15px] text-[#454F5E] leading-[1.6] mb-6" data-ps={`src/pages/courtroom-victories/8.astro:98i9sy-${__psIdx}`}>{c.court}</p>
            </div>
            <div class="border border-[#C9A840]/50 bg-[#F7F5F1] text-[#655018] text-[11.68px] font-bold px-3 py-1 rounded-[2px] tracking-wide self-start" data-ps={`src/pages/courtroom-victories/8.astro:aisnk7-${__psIdx}`}>
              Case <span data-ps={`src/pages/courtroom-victories/8.astro:fi8d0h-${__psIdx}`}>{c.name}</span>
            </div>
          </article>
        ))}
      </div>

      <nav aria-label="Case results pagination" class="flex flex-wrap items-center justify-center gap-2 mt-10" data-ps="src/pages/courtroom-victories/8.astro:r4i778">
        <a rel="prev" class={pageLinkBase} href="/courtroom-victories/7" data-ps="src/pages/courtroom-victories/8.astro:gcg6h6">← Previous</a>
        <a class={pageLinkBase} href="/courtroom-victories" aria-label="Page 1" data-ps="src/pages/courtroom-victories/8.astro:gcg6h7">1</a>
        <span class={ellipsis} aria-hidden="true" data-ps="src/pages/courtroom-victories/8.astro:fi8d0i">…</span>
        <a class={pageLinkBase} href="/courtroom-victories/7" aria-label="Page 7" data-ps="src/pages/courtroom-victories/8.astro:gcg6ht">7</a>
        <a class={pageLinkCurrent} href="/courtroom-victories/8" aria-label="Page 8" aria-current="page" data-ps="src/pages/courtroom-victories/8.astro:gcg6hu">8</a>
        <a class={pageLinkBase} href="/courtroom-victories/9" aria-label="Page 9" data-ps="src/pages/courtroom-victories/8.astro:gcg6hv">9</a>
        <span class={ellipsis} aria-hidden="true" data-ps="src/pages/courtroom-victories/8.astro:fi8d14">…</span>
        <a class={pageLinkBase} href="/courtroom-victories/15" aria-label="Page 15" data-ps="src/pages/courtroom-victories/8.astro:gcg6hw">15</a>
        <a rel="next" class={pageLinkBase} href="/courtroom-victories/9" data-ps="src/pages/courtroom-victories/8.astro:gcg6hx">Next →</a>
      </nav>

      <p class="text-center text-[13px] text-[#454F5E] mt-8" data-ps="src/pages/courtroom-victories/8.astro:98i9sz">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
      <div class="text-center mt-6" data-ps="src/pages/courtroom-victories/8.astro:aisnk8">
        <a href="/#contact" class="text-[#732521] font-bold underline underline-offset-4" data-ps="src/pages/courtroom-victories/8.astro:gcg6hy">Request a confidential consultation →</a>
      </div>
    </div>
  </section>
  <style is:global>
    /* Source header is a solid navy bar on this page (captured background rgb(6, 22, 51)). */
    #navbar {
      background-color: #061633;
    }
  </style>
</BaseLayout>
