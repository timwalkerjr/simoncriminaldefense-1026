const pages = [
  { label: '1', href: '/courtroom-victories' },
  { label: '2', href: '/courtroom-victories/2' },
  { label: '3', href: '/courtroom-victories/3', current: true },
  { label: '4', href: '/courtroom-victories/4' },
];
---

<BaseLayout
  title="Case Results — Page 3 | Law Offices of Joseph A. Simon"
  description="Real outcomes from cases handled by the Law Offices of Joseph A. Simon. Every case is different, and past results do not guarantee a similar outcome."
>
  <div class="relative" data-ps="src/pages/courtroom-victories/3.astro:jmsu5w">
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-[80px] bg-[#061633] z-20" data-ps="src/pages/courtroom-victories/3.astro:jmsu5v"></div>
  <section id="results" class="relative z-10 bg-[#F7F5F1] text-[#061633] pt-[150px] pb-[90px] lg:pb-[100px] border-t border-[#E6E2D9]" data-ps="src/pages/courtroom-victories/3.astro:6fra78">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/courtroom-victories/3.astro:jmsu63">
      <div class="mb-12" data-ps="src/pages/courtroom-victories/3.astro:jmsu62">
        <div class="flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#732521] mb-3" data-ps="src/pages/courtroom-victories/3.astro:jmsu61">
          <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/courtroom-victories/3.astro:ias8xx"></span>
          <span data-ps="src/pages/courtroom-victories/3.astro:ias8xw">COURTROOM RESULTS</span>
        </div>
        <h1 class="font-heading font-black leading-[1.14] tracking-[-0.53px] mb-4 text-[36px] sm:text-[44px]" data-ps="src/pages/courtroom-victories/3.astro:fnnr22">Representative case results.</h1>
        <p class="text-[17px] sm:text-[18.08px] text-[#454F5E] leading-[1.65] max-w-[840px]" data-ps="src/pages/courtroom-victories/3.astro:wkh3uu">Real outcomes from cases handled by the firm. Every case is different, and past results do not guarantee a similar outcome.</p>
      </div>

      <div class="flex flex-wrap justify-between items-center gap-3 mb-6 text-[14px] text-[#454F5E]" data-ps="src/pages/courtroom-victories/3.astro:jmsu60">
        <p data-ps="src/pages/courtroom-victories/3.astro:wkh3ut">Showing 49–72 of 358 case results</p>
        <p data-ps="src/pages/courtroom-victories/3.astro:wkh3us">Page 3 of 15</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/courtroom-victories/3.astro:jmsu5z">
        {cases.map((c, __psIdx) => (
          <article id={c.id} class="bg-white border border-[#E6E2D9] p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840] transition min-w-0 break-words" data-ps={`src/pages/courtroom-victories/3.astro:fkrdou-${__psIdx}`}>
            <div data-ps={`src/pages/courtroom-victories/3.astro:jmsu5y-${__psIdx}`}>
              <div data-field="charges" class="text-[12px] font-bold uppercase text-[#732521] tracking-wider mb-2" data-ps={`src/pages/courtroom-victories/3.astro:jmsu5x-${__psIdx}`}>{c.charges}</div>
              <h2 data-field="result" class="font-heading font-bold text-[#061633] leading-snug mb-3 text-[18.88px] whitespace-pre-line" data-ps={`src/pages/courtroom-victories/3.astro:z8tuh-${__psIdx}`}>{c.result}</h2>
              <p data-field="court" class="text-[15px] text-[#454F5E] leading-[1.6] mb-6" data-ps={`src/pages/courtroom-victories/3.astro:wkh3ur-${__psIdx}`}>{c.court}</p>
            </div>
            <div class="border border-[#C9A840]/50 bg-[#F7F5F1] text-[#655018] text-[11.68px] font-bold px-3 py-1 rounded-[2px] tracking-wide self-start" data-ps={`src/pages/courtroom-victories/3.astro:jmsu5w-${__psIdx}`}>
              Case <span data-field="name" data-ps={`src/pages/courtroom-victories/3.astro:ias8xv-${__psIdx}`}>{c.name}</span>
            </div>
          </article>
        ))}
      </div>

      <nav aria-label="Case results pagination" class="flex flex-wrap items-center justify-center gap-2 mt-10" data-ps="src/pages/courtroom-victories/3.astro:whkazr">
        <a rel="prev" href="/courtroom-victories/2" class="px-4 py-2 border border-[#E6E2D9] bg-white rounded-[3px] text-[14px] font-bold text-[#732521] hover:border-[#C9A840] transition" data-ps="src/pages/courtroom-victories/3.astro:pgj75u">← Previous</a>
        {pages.map((p, __psIdx) => (
          <a href={p.href} aria-label={`Page ${p.label}`} aria-current={p.current ? 'page' : undefined}
            class={p.current
              ? 'min-w-[40px] text-center px-3 py-2 border border-[#732521] bg-[#732521] text-white rounded-[3px] text-[14px] font-bold'
              : 'min-w-[40px] text-center px-3 py-2 border border-[#E6E2D9] bg-white rounded-[3px] text-[14px] font-bold text-[#061633] hover:border-[#C9A840] transition'} data-ps={`src/pages/courtroom-victories/3.astro:pgj75t-${__psIdx}`}>
            {p.label}
          </a>
        ))}
        <span class="px-1 text-[#454F5E]" aria-hidden="true" data-ps="src/pages/courtroom-victories/3.astro:ias8x9">…</span>
        <a href="/courtroom-victories/15" aria-label="Page 15" class="min-w-[40px] text-center px-3 py-2 border border-[#E6E2D9] bg-white rounded-[3px] text-[14px] font-bold text-[#061633] hover:border-[#C9A840] transition" data-ps="src/pages/courtroom-victories/3.astro:pgj75s">15</a>
        <a rel="next" href="/courtroom-victories/4" class="px-4 py-2 border border-[#E6E2D9] bg-white rounded-[3px] text-[14px] font-bold text-[#732521] hover:border-[#C9A840] transition" data-ps="src/pages/courtroom-victories/3.astro:pgj75r">Next →</a>
      </nav>

      <p class="text-center text-[13px] text-[#454F5E] mt-8" data-ps="src/pages/courtroom-victories/3.astro:wkh3uq">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
      <div class="text-center mt-6" data-ps="src/pages/courtroom-victories/3.astro:jmsu5v">
        <a href="/#contact" class="text-[#732521] font-bold underline underline-offset-4" data-ps="src/pages/courtroom-victories/3.astro:pgj75q">Request a confidential consultation →</a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>
