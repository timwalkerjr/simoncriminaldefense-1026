---
import BaseLayout from '@/layouts/BaseLayout.astro';

const cases = [
  { id: '24-0932-om', charges: 'Filing a False Police Report', result: 'Charges Reduced to Civil Infraction', court: '34th District Court', name: '24-0932-OM' },
  { id: '24-0501-sm', charges: 'Assault & Battery', result: 'Charges Dismissed', court: '15th District Court', name: '24-0501-SM' },
