  { id: '244-0043-sm', charges: 'Domestic Violence', result: 'Charges Dismissed With Prejudice In Trial', court: '14A-4 District Court', name: '244-0043-SM' },
  { id: '24-0229-sm', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '15th District Court', name: '24-0229-SM' },
  { id: '24-0201', charges: 'OWI/DUI', result: 'Charges Dismissed Following Defense Intervention', court: '15th District Court', name: '24-0201' },
  { id: '241-0169-sm', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '14A-1 District Court', name: '241-0169-SM' },
  { id: '24-0088-sm', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '15th District Court', name: '24-0088-SM' },
  { id: '24f3-0110-fy', charges: 'Uttering and Publishing Forged Document', result: 'Dismissal Following Defense Investigation', court: '22nd Circuit Court/14A-3 District Court', name: '24F3-0110-FY' },
  { id: '23f4-1797-fy', charges: 'Home Invasion - First Degree', result: 'Charges Dismissed', court: '22nd Circuit Court/15th District Court', name: '23F4-1797-FY' },
  { id: '23f5-5176-fy', charges: 'Assault With Intent to Commit Great Bodily Harm - Strangulation', result: 'Charges Dismissed', court: '22nd Circuit Court/15th District Court', name: '23F5-5176-FY' },
  { id: '23f5-5627-fy', charges: 'Criminal Sexual Conduct, Fourth Degree', result: 'Charges Dismissed', court: '22nd Circuit Court/15th District Court', name: '23F5-5627-FY' },
  { id: '23-0539-sm', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '15th District Court', name: '23-0539-SM' },
  { id: '23f3-0388-fy', charges: 'Felonious Assault', result: 'Charges Dismissed Following Preliminary Examination', court: '14A District Court', name: '23F3-0388-FY' },
