const pageTitle = 'In the News & Press Coverage | Law Offices of Joseph A. Simon';
const pageDescription =
  'Press coverage and news reports on criminal defense matters, case dismissals, and trial proceedings handled by Ann Arbor defense attorney Joseph A. Simon.';

const featured = [
  {
    title: 'AG drops charges against Northfield police lieutenant',
