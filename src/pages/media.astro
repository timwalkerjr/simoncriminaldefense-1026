  },
  {
    source: 'mLive',
    title: 'Pet shop owner charged with animal cruelty sentenced on violation',
    img: 'https://pagesmith-cdn.com/ee60f2da/images/1-dbbd85-200.webp',
    href: '/media-articles/pet-shop-owner-charged-with-animal-cruelty-sentenced-on-violation',
