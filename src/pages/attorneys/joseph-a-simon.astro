---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Joseph A. Simon | Law Offices of Joseph A. Simon';
const pageDescription =
  'Throughout his career, spanning more than 30 years, Mr. Simon has tried hundreds of criminal cases throughout the state of Michigan. He has established a reputation for providing vigorous and successful defenses.';
---

<BaseLayout title={pageTitle} description={pageDescription} headerVariant="transparent">
  <main data-ps="src/pages/attorneys/joseph-a-simon.astro:o4wnoj">
    <section class="attorney-hero text-white" data-ps="src/pages/attorneys/joseph-a-simon.astro:egs6cw">
      <div class="mx-auto max-w-[1280px] px-6 pt-[150px] pb-[72px]" data-ps="src/pages/attorneys/joseph-a-simon.astro:hq3tz5">
        <nav class="mb-8 flex items-center gap-2 text-[13px] text-[#C3CCDA]" aria-label="Breadcrumb" data-ps="src/pages/attorneys/joseph-a-simon.astro:klzf0q">
          <a href="/" class="text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trvt">Home</a>
          <span data-ps="src/pages/attorneys/joseph-a-simon.astro:3nr4ij">/</span>
          <a href="/#about" class="text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trvu">Our Team</a>
        </nav>

        <div class="mb-4 flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#C9A840]" data-ps="src/pages/attorneys/joseph-a-simon.astro:hq3tz4">
          <span class="inline-block h-[2px] w-[28px] bg-[#C9A840]" data-ps="src/pages/attorneys/joseph-a-simon.astro:3nr4ik"></span>
          <span data-ps="src/pages/attorneys/joseph-a-simon.astro:3nr4il">Criminal Defense Attorney</span>
        </div>

        <h1 class="font-serif text-[52px] font-black leading-[58.24px] tracking-[-0.6px] text-white max-md:text-[40px] max-md:leading-[46px]" data-ps="src/pages/attorneys/joseph-a-simon.astro:i0d2qj">Joseph A. Simon</h1>

        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-5" data-ps="src/pages/attorneys/joseph-a-simon.astro:hq3tz3">
          <a
            href="/#contact"
            class="inline-flex items-center rounded-[3px] border border-transparent bg-[#732521] px-[30px] py-[16px] text-[16px] font-semibold text-white transition hover:bg-[#581b19]"
           data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trvv">Request a Confidential Consultation</a>
          <a
            href="tel:+17348876200"
            class="border-b border-[#C9A840] pb-1 text-[16px] font-semibold text-white transition hover:text-[#DDC582]"
           data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trvw">(734) 887-6200</a>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-[1100px] px-6 py-[64px]" data-ps="src/pages/attorneys/joseph-a-simon.astro:hq3tz2">
      <article class="bio-copy text-[18px] leading-[32.4px] text-[#141C28]" data-ps="src/pages/attorneys/joseph-a-simon.astro:cev6j3">
        <figure class="bio-figure">
          <img
            src="https://pagesmith-cdn.com/ee60f2da/images/joseph-a-simon-1-747926-800.webp"
            alt="Joseph A. Simon, Criminal Defense Attorney"
            width="800"
            height="1067"
            loading="lazy"
            class="h-auto w-full rounded-[4px]" data-ps="src/pages/attorneys/joseph-a-simon.astro:g9cidk" />
        </figure>

        <p data-ps="src/pages/attorneys/joseph-a-simon.astro:f3vv7q">Throughout his career, spanning more than 35 years, Mr. Simon has tried hundreds of criminal cases throughout the state of Michigan. He has established a reputation for providing vigorous and successful defenses to individuals throughout Washtenaw, Wayne, Jackson, Lenawee and Livingston counties in a wide range of criminal defense cases, including those involving OWI and DUI charges, domestic assault, assault &amp; battery, theft offenses, traffic offenses, computer crimes, homicide allegations and alleged drug crimes.</p>

        <p data-ps="src/pages/attorneys/joseph-a-simon.astro:f3vv7r">Mr. Simon's ethics and thorough approach have garnered him several accolades, including achieving Martindale-Hubbell's AV-Preeminent* peer-reviewed rating for the highest standards in ethics and legal ability; &nbsp;being listed in <a href="https://www.bestlawyers.com/lawyers/joseph-a-simon/32940" target="_blank" rel="noopener" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trwi"><strong><em>The Best Lawyers in America</em></strong></a>® since 2000, under the specialty of criminal defense, having three times been selected as Ann Arbor’s criminal defense lawyer of the year (2013, 2015, 2023) <a href="https://www.bestlawyers.com/lawyers/joseph-a-simon/32940" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trwj"><strong><em>2023 Lawyer of the Year;</em></strong></a><strong> </strong><a href="https://www.avvo.com/attorneys/48104-mi-joseph-simon-760453.html" target="_blank" rel="noopener" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trwk"><strong><em>Achieving AVVO's highest “10.0” rating</em></strong></a>; being selected as a Michigan <a href="https://attorneys.superlawyers.com/search?ls=&amp;fs=&amp;ac_locality=Ann+Arbor&amp;ac_province=MI&amp;q=joe+simon&amp;l=Ann+Arbor%2C+MI%2C+United+States" target="_blank" rel="noopener" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trwl"><strong><em>Super Lawyer</em></strong></a> in the specialty of criminal defense since 2007; being named a criminal defense <a href="https://www.leadinglawyers.com/atty_profile.cfm?TOCUID=30027701" target="_blank" rel="noopener" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trwm"><strong><em>Leading</em> <em>Lawyer</em></strong></a> since 2014 and selected as one of <a href="https://www.top100criminaldefenseattorneys.com/" target="_blank" rel="noopener" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trwn"><strong><em>America’s Top 100 Criminal Defense Attorney</em>s</strong></a>® since 2019**.</p>

        <p data-ps="src/pages/attorneys/joseph-a-simon.astro:f3vv7s">A frequent contributor to the Institute of Continuing Legal Education in Ann Arbor, Mr. Simon has delivered seminars and taught classes on nine different criminal law-related subjects ranging from misdemeanor defense to handling felony assault cases. He also authored Michigan Automated Sentencing Guidelines©, a computer program for scoring the state's sentencing guidelines that is used by probation agents throughout the state.</p>

        <p data-ps="src/pages/attorneys/joseph-a-simon.astro:f3vv8e">Mr. Simon practices before all Michigan state courts and is admitted to the U.S. District Court for the Eastern District of Michigan.</p>
      </article>
    </div>

    <section class="bg-[#061633] py-[100px]" data-ps="src/pages/attorneys/joseph-a-simon.astro:egs6cv">
      <div class="mx-auto max-w-[1280px] px-6 text-center" data-ps="src/pages/attorneys/joseph-a-simon.astro:hq3tz1">
        <div class="mb-4" data-ps="src/pages/attorneys/joseph-a-simon.astro:hq3tz0">
          <span class="inline-flex items-center text-[12px] font-bold uppercase tracking-[1.8px] text-[#C9A840]" data-ps="src/pages/attorneys/joseph-a-simon.astro:3nr4im">
            <span class="mr-3 inline-block h-[2px] w-[28px] bg-[#C9A840]" data-ps="src/pages/attorneys/joseph-a-simon.astro:3nr4in"></span>Consultation
          </span>
        </div>
        <h2 class="mx-auto mb-6 max-w-[820px] font-serif text-[44px] font-black leading-[50.16px] tracking-[-0.53px] text-white max-md:text-[32px] max-md:leading-[40px]" data-ps="src/pages/attorneys/joseph-a-simon.astro:3by5iy">Whatever the charge, talk to us first.</h2>
        <p class="mx-auto mb-8 max-w-[680px] text-[18.08px] leading-[31px] text-[#C3CCDA]" data-ps="src/pages/attorneys/joseph-a-simon.astro:f3vv8f">Your consultation is confidential and available 24/7. Tell us what you're facing and we'll explain how Michigan law applies to it.</p>

        <div class="mb-12 flex flex-wrap justify-center gap-4" data-ps="src/pages/attorneys/joseph-a-simon.astro:hq3tyz">
          <a
            href="/#contact"
            class="inline-flex items-center gap-2 rounded-[3px] bg-[#732521] px-[30px] py-[16px] text-[16.16px] font-semibold text-white transition hover:bg-[#581b19]"
           data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trwo">Request a Confidential Consultation<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
          <a
            href="tel:+17348876200"
            class="inline-flex items-center gap-2 rounded-[3px] border border-white/30 px-[30px] py-[16px] text-[16.16px] font-semibold text-white transition hover:border-[#C9A840] hover:text-[#DDC582]"
           data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trwp">Call (734) 887-6200</a>
        </div>

        <div class="border-t border-white/10 pt-8 mt-8" data-ps="src/pages/attorneys/joseph-a-simon.astro:hq3tyy">
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-3" data-ps="src/pages/attorneys/joseph-a-simon.astro:hq3tyx">
            <a href="/" class="text-[14px] text-[#C3CCDA] transition hover:text-white" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trwq">Home</a>
            <a href="/practice-areas" class="text-[14px] text-[#C3CCDA] transition hover:text-white" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trwr">Practice Areas</a>
            <a href="/#results" class="text-[14px] text-[#C3CCDA] transition hover:text-white" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trxd">Results</a>
            <a href="/#about" class="text-[14px] text-[#C3CCDA] transition hover:text-white" data-ps="src/pages/attorneys/joseph-a-simon.astro:m7trxe">About</a>
            <a href="/#testimonials" class="text-[14px] text-[#C3CCDA] transition hover:text-white" data-ps="src/pages/attorneys/joseph-a-simon.astro:jwl4bf">Testimonials</a>
            <a href="/#faq" class="text-[14px] text-[#C3CCDA] transition hover:text-white" data-ps="src/pages/attorneys/joseph-a-simon.astro:jwl4be">FAQs</a>
            <a href="/#contact" class="text-[14px] text-[#C3CCDA] transition hover:text-white" data-ps="src/pages/attorneys/joseph-a-simon.astro:jwl4bd">Contact</a>
          </div>
          <div class="mt-6" data-ps="src/pages/attorneys/joseph-a-simon.astro:hq3tyw">
            <a href="tel:+17348876200" class="text-[16px] font-bold text-[#C9A840] transition hover:text-[#DDC582]" data-ps="src/pages/attorneys/joseph-a-simon.astro:jwl4bc">Call (734) 887-6200</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .attorney-hero {
    background-color: rgba(0, 0, 0, 0);
    background-image: linear-gradient(100deg, rgba(4, 16, 38, 0.97), rgba(8, 26, 60, 0.85)), url("https://jas-law-astro-review.netlify.app/hero-court-1.webp");
    background-size: auto, cover;
    background-position: 0% 0%, 50% 50%;
  }

  .bio-copy p {
    margin: 0 0 24px;
  }

  .bio-copy a {
    color: #732521;
    font-weight: 700;
    font-style: italic;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bio-figure {
    float: left;
    width: 100%;
    max-width: 400px;
    margin: 8px 40px 16px 0;
    shape-outside: margin-box;
  }

  .bio-copy::after {
    content: '';
    display: block;
    clear: both;
  }

  @media (max-width: 640px) {
    .bio-figure {
      float: none;
      margin: 0 0 24px;
    }
  }
</style>
