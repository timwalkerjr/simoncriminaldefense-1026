---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Contact | Joseph A. Simon';
const pageDescription =
  'Joseph A. Simon, Criminal Defense Attorney serving in Washtenaw County, MI has over 30 years of of excellence in criminal defense.  Contact Joe to start your defense today.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="bg-[#F7F5F1] text-[#061633] pt-[140px] pb-16" data-ps="src/pages/contact.astro:76y6mv">
    <div class="max-w-[1280px] mx-auto px-6" data-ps="src/pages/contact.astro:uoopdd">
      <h1 class="text-[36px] sm:text-[52px] font-black mb-8" data-ps="src/pages/contact.astro:xwwez5">Contact Us</h1>
      <div class="prose prose-lg max-w-[1000px] prose-a:text-[#732521]" data-ps="src/pages/contact.astro:uoopde">
        <p data-ps="src/pages/contact.astro:wmga29">
          Through a career spanning more than 30 years, few lawyers can match Mr. Simon's experience, reputation and results. He has <a href="/courtroom-victories" data-ps="src/pages/contact.astro:piidd7">tried hundreds of criminal cases</a> throughout the state of Michigan establishing a reputation for excellence and providing vigorous and successful defenses to individuals throughout Washtenaw, Wayne, Jackson, Lenawee and Livingston counties in a wide range of criminal defense cases, including those involving OWI and DUI charges, domestic assault, assault &amp; battery, theft offenses, traffic offenses, homicide allegations and alleged drug crimes.
        </p>
      </div>
    </div>
  </section>

  <section id="contact" class="bg-[#061633] text-white py-[90px] lg:py-[100px] border-t border-white/10" data-ps="src/pages/contact.astro:76y6mw">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/contact.astro:uoopdf">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.15fr] gap-12 lg:gap-16 items-start" data-ps="src/pages/contact.astro:uoopdg">
        <div data-ps="src/pages/contact.astro:uoopdh">
          <div class="flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#C9A840] mb-3" data-ps="src/pages/contact.astro:uoopdi">
            <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/contact.astro:lvpf81"></span>
            <span data-ps="src/pages/contact.astro:lvpf82">Confidential Consultation</span>
          </div>
          <h2 class="font-heading font-black text-white leading-[1.14] tracking-[-0.53px] mb-4 text-[34px] sm:text-[44px]" data-ps="src/pages/contact.astro:j8hhrk">Contact us for a Free Confidential Consultation</h2>
          <p class="text-[17px] sm:text-[18.08px] text-[#C3CCDA] leading-[1.7] mb-8" data-ps="src/pages/contact.astro:wmga28">
            Located in Ann Arbor, Michigan, the Law Offices of Joseph A. Simon handles all criminal defense matters primarily in Washtenaw County but also service all surrounding counties. Contact us to receive a free, confidential consultation with one of our attorneys at <a href="tel:+17348876200" class="underline" data-ps="src/pages/contact.astro:piidd6">734-887-6200</a> or email Mr. Simon at <a href="mailto:joe@simoncriminaldefense.com" class="underline break-words" data-ps="src/pages/contact.astro:piidd5">joe@simoncriminaldefense.com</a>.
          </p>

          <div class="space-y-6 mb-8" data-ps="src/pages/contact.astro:uoopdj">
            <div class="flex items-start gap-4" data-ps="src/pages/contact.astro:uoopdk">
              <div class="w-10 h-10 rounded-[4px] bg-white/[0.05] border border-white/10 flex items-center justify-center text-[#C9A840] shrink-0 mt-1" data-ps="src/pages/contact.astro:uoope6">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"></path></svg>
              </div>
              <div data-ps="src/pages/contact.astro:uoope7">
                <div class="text-[11px] uppercase tracking-wider text-[#C9A840] font-bold" data-ps="src/pages/contact.astro:uoope8">Call Anytime</div>
                <a href="tel:+17348876200" class="text-[18px] font-bold text-white hover:text-[#DDC582] transition-colors no-underline" data-ps="src/pages/contact.astro:piidd4">(734) 887-6200</a>
              </div>
            </div>
            <div class="flex items-start gap-4" data-ps="src/pages/contact.astro:uoope9">
              <div class="w-10 h-10 rounded-[4px] bg-white/[0.05] border border-white/10 flex items-center justify-center text-[#C9A840] shrink-0 mt-1" data-ps="src/pages/contact.astro:uoopea">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"></path></svg>
              </div>
              <div data-ps="src/pages/contact.astro:uoopeb">
                <div class="text-[11px] uppercase tracking-wider text-[#C9A840] font-bold" data-ps="src/pages/contact.astro:uoopec">Office</div>
                <p class="text-[15.5px] text-[#C3CCDA] leading-snug" data-ps="src/pages/contact.astro:wmga27">1310 South Main Street, Suite 11<br />Ann Arbor, MI 48104</p>
              </div>
            </div>
            <div class="flex items-start gap-4" data-ps="src/pages/contact.astro:uooped">
              <div class="w-10 h-10 rounded-[4px] bg-white/[0.05] border border-white/10 flex items-center justify-center text-[#C9A840] shrink-0 mt-1" data-ps="src/pages/contact.astro:uoopee">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"></path></svg>
              </div>
              <div data-ps="src/pages/contact.astro:uoopef">
                <div class="text-[11px] uppercase tracking-wider text-[#C9A840] font-bold" data-ps="src/pages/contact.astro:lx8n1r">Hours</div>
                <p class="text-[15.5px] text-[#C3CCDA] leading-snug" data-ps="src/pages/contact.astro:wmga26">Open 24/7/365</p>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2 text-[14px] text-[#98A6BB] border-t border-white/10 pt-6" data-ps="src/pages/contact.astro:lx8n1q">
            <svg class="w-4 h-4 text-[#C9A840]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"></path></svg>
            <span data-ps="src/pages/contact.astro:lvpf8o">Free Confidential Consultation</span>
          </div>
        </div>

        <div class="bg-[#0B1F42] border border-white/10 p-7 sm:p-9 rounded-[10px] shadow-2xl" data-ps="src/pages/contact.astro:lx8n1p">
          <h3 class="font-heading font-black text-[22px] sm:text-[24px] text-white mb-2" data-ps="src/pages/contact.astro:4k2kjz">Request a confidential consultation</h3>
          <p class="text-[14px] text-[#C3CCDA] mb-6" data-ps="src/pages/contact.astro:wmga25">Contact us to request a free, confidential consultation.</p>
          <form id="consultation-form" class="space-y-4">
            <input type="hidden" name="_formId" value="contact" />
            <input type="hidden" name="subject" value="JAS Law website contact request" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/pages/contact.astro:lx8n1o">
              <div data-ps="src/pages/contact.astro:lx8n1n">
                <label for="fullName" class="block text-[13px] font-semibold text-[#C3CCDA] mb-1.5" data-ps="src/pages/contact.astro:zcrc0w">Full Name</label>
                <input type="text" id="fullName" name="name" autocomplete="name" required placeholder="John Doe" class="w-full bg-white/[0.043] border border-white/16 rounded-[4px] text-white px-4 py-3 text-[15.36px] placeholder:text-[#98A6BB]/60 focus:outline-none focus:border-[#C9A840] transition" />
              </div>
              <div data-ps="src/pages/contact.astro:lx8n1m">
                <label for="phone" class="block text-[13px] font-semibold text-[#C3CCDA] mb-1.5" data-ps="src/pages/contact.astro:zcrc0v">Phone</label>
                <input type="tel" id="phone" name="phone" autocomplete="tel" required placeholder="(734) 000-0000" class="w-full bg-white/[0.043] border border-white/16 rounded-[4px] text-white px-4 py-3 text-[15.36px] placeholder:text-[#98A6BB]/60 focus:outline-none focus:border-[#C9A840] transition" />
              </div>
            </div>
            <div data-ps="src/pages/contact.astro:lx8n1l">
              <label for="email" class="block text-[13px] font-semibold text-[#C3CCDA] mb-1.5" data-ps="src/pages/contact.astro:zcrc09">Email</label>
              <input type="email" id="email" name="email" autocomplete="email" required placeholder="you@example.com" class="w-full bg-white/[0.043] border border-white/16 rounded-[4px] text-white px-4 py-3 text-[15.36px] placeholder:text-[#98A6BB]/60 focus:outline-none focus:border-[#C9A840] transition" />
            </div>
            <div data-ps="src/pages/contact.astro:lx8n1k">
              <label for="chargeType" class="block text-[13px] font-semibold text-[#C3CCDA] mb-1.5" data-ps="src/pages/contact.astro:zcrc08">Type of Charge / Matter</label>
              <select id="chargeType" name="chargeType" class="w-full bg-[#0B1F42] border border-white/16 rounded-[4px] text-white px-4 py-3 text-[15.36px] focus:outline-none focus:border-[#C9A840] transition">
                <option value="">Select a charge type</option>
                <option value="DUI / OWI">DUI / OWI</option>
                <option value="Drug Crimes">Drug Crime</option>
                <option value="Assault / Battery">Assault / Battery</option>
                <option value="Domestic Violence">Domestic Violence</option>
                <option value="Criminal Sexual Conduct">Sex Crime / CSC</option>
                <option value="Home Invasion">Home Invasion</option>
                <option value="Computer Crimes">Computer Crime</option>
                <option value="College / Campus Crimes">College / Campus Crime</option>
                <option value="Expungements">Expungement</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div data-ps="src/pages/contact.astro:lx8n1j">
              <label for="situation" class="block text-[13px] font-semibold text-[#C3CCDA] mb-1.5" data-ps="src/pages/contact.astro:zcrc07">Describe Your Situation</label>
              <textarea id="situation" name="message" rows="3" placeholder="Briefly describe your situation." class="w-full bg-white/[0.043] border border-white/16 rounded-[4px] text-white px-4 py-3 text-[15.36px] placeholder:text-[#98A6BB]/60 focus:outline-none focus:border-[#C9A840] transition resize-none"></textarea>
            </div>
            <altcha-widget challenge="/psapi-internal-v1/altcha/challenge" display="invisible" auto="onfocus"></altcha-widget>
            <button type="submit" id="submit-btn" class="w-full bg-[#732521] text-white font-semibold text-[15.52px] py-3.5 rounded-[3px] hover:bg-[#5a1c19] transition mt-2 cursor-pointer shadow-lg disabled:opacity-60 disabled:cursor-wait" data-ps="src/pages/contact.astro:qxoia4">Send My Case Details</button>
            <div id="form-feedback" role="status" aria-live="polite" class="text-center text-[14px] mt-2 hidden" data-ps="src/pages/contact.astro:lx8n1i"></div>
            <p class="text-[12px] text-[#98A6BB] text-center mt-3 flex items-center justify-center gap-1.5" data-ps="src/pages/contact.astro:wmga24">
              <svg class="w-3.5 h-3.5 text-[#C9A840]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"></path></svg>
              <span data-ps="src/pages/contact.astro:5adute">Free Confidential Consultation</span>
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import 'altcha';

  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  const showFeedback = (message: string, tone: 'success' | 'error') => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className =
      tone === 'success'
        ? 'text-center text-[14px] mt-2 text-green-300'
        : 'text-center text-[14px] mt-2 text-red-300';
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submitBtn) return;

    const data = new FormData(form);
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    if (feedback) feedback.className = 'text-center text-[14px] mt-2 hidden';

    try {
      const response = await fetch('/psapi-internal-v1/forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          _formId: data.get('_formId'),
          subject: data.get('subject'),
          name: data.get('name'),
          phone: data.get('phone'),
          email: data.get('email'),
          chargeType: data.get('chargeType'),
          message: data.get('message'),
          altcha: data.get('altcha'),
        }),
      });

      const result = await response.json().catch(() => ({ success: false }));
      if (response.ok && result.success) {
        form.reset();
        showFeedback('Thank you! Your message has been sent.', 'success');
      } else {
        throw new Error(result.error || 'Your message could not be sent. Please call (734) 887-6200.');
      }
    } catch (error) {
      showFeedback(
        error instanceof Error ? error.message : 'Your message could not be sent. Please try again.',
        'error',
      );
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send My Case Details';
    }
  });
</script>
