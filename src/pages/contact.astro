---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/home/ContactForm.astro';
import pages from '@/content/original-static-pages.json';
const page=pages.contact;
---
<BaseLayout title={page.title} description={page.description}>
 <section class="bg-[#F7F5F1] text-[#061633] pt-[140px] pb-16"><div class="max-w-[1280px] mx-auto px-6"><h1 class="text-[36px] sm:text-[52px] font-black mb-8">{page.heading}</h1><div data-original-static="contact" class="prose prose-lg max-w-[1000px] prose-a:text-[#732521]" set:html={page.bodyHtml} /></div></section>
 <ContactForm kind="contact" />
</BaseLayout>
