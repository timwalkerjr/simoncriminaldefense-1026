---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Case Results | Law Offices of Joseph A. Simon';
const pageDescription =
  'Real outcomes from cases handled by the Law Offices of Joseph A. Simon. Every case is different, and past results do not guarantee a similar outcome.';

const cases = [
  { caseId: '6a70eac27d0217789171e21c', id: '263-0102-sm', charges: 'Breaking and Entering -Illegal Entry', result: 'Charges Dismissed', court: '14A-4 District Court', name: '263-0102-SM' },
  { caseId: '6a70ea7ba8de8ca07bb2bfce', id: '264-0169-sm', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '14A-3 District Court', name: '264-0169-SM' },
  { caseId: '6a67ae2f512545ac1ef592cd', id: '261-0203-sm', charges: 'Stalking - Domestic Relationship; Domestic Violence', result: 'Not Guilty Verdict', court: '14A-1 District Court', name: '261-0203-SM' },
  { caseId: '6a3d785df0ebfe6e9e2d81c5', id: '26-0015-od', charges: 'Operating While Intoxicated', result: 'Charges Dismissed following grant of Defense Motion to Suppress Evidence', court: '15th District Court', name: '26-0015-OD' },
  { caseId: '6a3bdf64f2486522ec20e36e', id: '26-0191-sm', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '15th District Court', name: '26-0191-SM' },
  { caseId: '6a39437cac3cfe781df28165', id: '26f2-0530-fy', charges: 'Interfering with Electronic Communications Device and Domestic Violence', result: 'Charges Dismissed at Preliminary Examination', court: '22nd Circuit Court/14A1 District Court', name: '26F2-0530-FY' },
  { caseId: '6a20118ddfa1523b9725bbec', id: '26f4-0265-fy', charges: 'Assault with a Dangerous Weapon (Felonious Assault); Domestic Violence', result: 'Charges Dismissed', court: '22nd Circuit Court and 14-4 District Court', name: '26F4-0265-FY' },
  { caseId: '69f4d4b5fae99aa078e91916', id: '261-0074', charges: 'Domestic Violence', result: 'Charges Dismissed at Trial', court: '14A-1 District Court', name: '261-0074' },
  { caseId: '69f4d47cb14bcefe7533c2c8', id: '23fb-1425-fy', charges: 'Larceny in a Building; Unlawful Use of a Financial Transaction Device', result: 'Charges Dismissed at Preliminary Examination', court: '22nd Circuit Court/14B District Court', name: '23FB-1425-FY' },
  { caseId: '69f4d42337b28c863fcc20ea', id: '26-0055-sm', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '15th District Court', name: '26-0055-SM' },
  { caseId: '69c5555b26ec8f28ec325b11', id: '25-0588-sm', charges: 'Domestic Violence', result: 'Charges Dismissed', court: '15th District Court', name: '25-0588-SM' },
  { caseId: '69c513ddce1999e41df0d3a2', id: '25f1-2214-fy', charges: 'Assault with Intent to do Great Bodily Harm Less Than Murder/Strangulation', result: 'Charges Dismissed at Preliminary Examination', court: '14A District Court/22nd Circuit Court', name: '25F1-2214-FY' },
  { caseId: '6977d46719c2422a66de36d7', id: '25-0568-od', charges: 'Operating While Intoxicated', result: 'Charges Reduced to Civil Infraction', court: '15th District Court', name: '25-0568-OD' },
  { caseId: '6977d4316d7b534ca2a07bd0', id: '13-0261-sd', charges: 'Operating With a High Blood Alcohol Level (Superdrunk)', result: 'Charges Dismissed', court: '15th District Court', name: '13-0261-SD' },
  { caseId: '6977d3c0eb0f8d5b17257885', id: '252-0508-sd', charges: 'Operating While Impaired', result: 'Charges Reduced to Careless Driving', court: '14A-2 District Court', name: '252-0508-SD' },
  { caseId: '6925e675365b3bf19714de23', id: '25f3-1777-fy', charges: 'Interference With Electronics Communications Device; Malicious Destruction of Property', result: 'Charges Dismissed', court: '14A District Court - 22nd Circuit Court', name: '25F3-1777-FY' },
  { caseId: '691f4d8ff85be467bb779628', id: '25-000263-fh', charges: 'Assault with Intent to do Great Bodily Harm Less Than Murder or by Strangulation; Attempted Interference with Electronic Communications Device; Domestic Violence', result: 'All Charges Dismissed', court: '22nd Circuit Court', name: '25-000263-FH' },
  { caseId: '691f4c9f5ffb41dc3f38507b', id: '25f5-5799-fy', charges: 'Interference with Electronic Communications Device, Malicious Destruction of Property', result: 'Charges Dismissed', court: '22nd Circuit Court/15th District Court', name: '25F5-5799-FY' },
  { caseId: '6915ffda600f87920f3387bf', id: '25-0612-sm', charges: 'Assault and Battery', result: 'Charges Dismissed', court: '15th District Court', name: '25-0612-SM' },
  { caseId: '690cf4a15067d36d56478fb3', id: '252-0668-sd', charges: 'Operating While Intoxicated OWI', result: 'Charges dismissed in favor of Civil Infraction', court: '14A-2 District Court', name: '252-0668-SD' },
  { caseId: '690c8d95dbf3414ca4138e2e', id: '25-0479-sm', charges: 'Domestic Violence', result: 'Not Guilty Verdict at Trial', court: '15th District Court', name: '25-0479-SM' },
  { caseId: '690a7061f06cda276ab87850', id: '25f4-1379-fy', charges: 'Aggravated Stalking', result: 'Charges Dismissed', court: '22n Circuit Court/14A-4 District Court', name: '25F4-1379-FY' },
  { caseId: '690a6df466794860c06234c7', id: '25aa02105-om', charges: 'Resisting/Obstructing Police', result: 'Charges Dismissed', court: '15th District Court', name: '25AA02105-OM' },
  { caseId: '68c421c84296627991e3e0eb', id: '24f5-5604-fy', charges: 'Criminal Sexual Conduct, Second Degree', result: 'Charges Dismissed at Preliminary Examination', court: '15th District Court/22nd Circuit Court', name: '24F5-5604-FY' },
];

const pages = [
  { label: '1', href: '/courtroom-victories', current: true },
  { label: '2', href: '/courtroom-victories/2', current: false },
];
---

<BaseLayout headerVariant="solid" title={pageTitle} description={pageDescription}>
  <main data-ps="src/pages/courtroom-victories.astro:398iae">
    <section id="results" class="bg-[#F7F5F1] text-[#061633] pt-[150px] pb-[90px] lg:pb-[100px] border-t border-[#E6E2D9]" data-ps="src/pages/courtroom-victories.astro:fwlt1c">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/courtroom-victories.astro:yx79g7">
        <div class="mb-12" data-ps="src/pages/courtroom-victories.astro:yx79g6">
          <div class="flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#732521] mb-3" data-ps="src/pages/courtroom-victories.astro:yx79g5">
            <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/courtroom-victories.astro:v1wahi"></span>
            <span data-ps="src/pages/courtroom-victories.astro:v1wahj">COURTROOM RESULTS</span>
          </div>
          <h1 class="font-heading font-black leading-[1.14] tracking-[-0.53px] mb-4 text-[36px] sm:text-[44px]" data-ps="src/pages/courtroom-victories.astro:f5wkr9">Representative case results.</h1>
          <p class="text-[17px] sm:text-[18.08px] text-[#454F5E] leading-[1.65] max-w-[840px]" data-ps="src/pages/courtroom-victories.astro:12yeln">Real outcomes from cases handled by the firm. Every case is different, and past results do not guarantee a similar outcome.</p>
        </div>

        <div class="flex flex-wrap justify-between items-center gap-3 mb-6 text-[14px] text-[#454F5E]" data-ps="src/pages/courtroom-victories.astro:yx79g4">
          <p data-ps="src/pages/courtroom-victories.astro:12yelm">Showing 1–24 of 358 case results</p>
          <p data-ps="src/pages/courtroom-victories.astro:12yell">Page 1 of 15</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-ps="src/pages/courtroom-victories.astro:yx79g3">
          {cases.map((c, __psIdx) => (
            <article data-case-id={c.caseId} id={c.id} class="bg-white border border-[#E6E2D9] p-7 rounded-[4px] flex flex-col justify-between hover:border-[#C9A840] transition min-w-0 break-words" data-ps={`src/pages/courtroom-victories.astro:66xdnu-${__psIdx}`}>
              <div data-ps={`src/pages/courtroom-victories.astro:yx79g2-${__psIdx}`}>
                <div data-field="charges" class="text-[12px] font-bold uppercase text-[#732521] tracking-wider mb-2" data-ps={`src/pages/courtroom-victories.astro:yx79g1-${__psIdx}`}>{c.charges}</div>
                <h2 data-field="result" class="font-heading font-bold text-[#061633] leading-snug mb-3 text-[18.88px] whitespace-pre-line" data-ps={`src/pages/courtroom-victories.astro:hhnjo-${__psIdx}`}>{c.result}</h2>
                <p data-field="court" class="text-[15px] text-[#454F5E] leading-[1.6] mb-6" data-ps={`src/pages/courtroom-victories.astro:12yelk-${__psIdx}`}>{c.court}</p>
              </div>
              <div class="border border-[#C9A840]/50 bg-[#F7F5F1] text-[#655018] text-[11.68px] font-bold px-3 py-1 rounded-[2px] tracking-wide self-start" data-ps={`src/pages/courtroom-victories.astro:yx79g0-${__psIdx}`}>
                Case <span data-field="name" data-ps={`src/pages/courtroom-victories.astro:v1wahk-${__psIdx}`}>{c.name}</span>
              </div>
            </article>
          ))}
        </div>

        <nav aria-label="Case results pagination" class="flex flex-wrap items-center justify-center gap-2 mt-10" data-ps="src/pages/courtroom-victories.astro:fa6iv1">
          {pages.map((p, __psIdx) => (
            <a class:list={['page-link inline-flex items-center justify-center min-w-[40px] h-10 px-3 border font-bold rounded-[3px]', p.current ? 'bg-[#732521] text-white border-[#732521]' : 'bg-white text-[#061633] border-[#E6E2D9]']} href={p.href} aria-label={`Page ${p.label}`} aria-current={p.current ? 'page' : undefined} data-ps={`src/pages/courtroom-victories.astro:60zi3e-${__psIdx}`}>{p.label}</a>
          ))}
          <span class="px-1 text-[#454F5E]" aria-hidden="true" data-ps="src/pages/courtroom-victories.astro:v1wahl">…</span>
          <a class="page-link inline-flex items-center justify-center min-w-[40px] h-10 px-3 border border-[#E6E2D9] bg-white text-[#061633] font-bold rounded-[3px]" href="/courtroom-victories/15" aria-label="Page 15" data-ps="src/pages/courtroom-victories.astro:60zi3f">15</a>
          <a rel="next" class="page-link inline-flex items-center justify-center h-10 px-4 border border-[#E6E2D9] bg-white text-[#061633] font-bold rounded-[3px]" href="/courtroom-victories/2" data-ps="src/pages/courtroom-victories.astro:60zi3g">Next →</a>
        </nav>

        <p class="text-center text-[13px] text-[#454F5E] mt-8" data-ps="src/pages/courtroom-victories.astro:12yelj">Prior results do not guarantee a similar outcome. Each case depends on its own facts and circumstances.</p>
        <div class="text-center mt-6" data-ps="src/pages/courtroom-victories.astro:yx79fz">
          <a href="/#contact" class="text-[#732521] font-bold underline underline-offset-4" data-ps="src/pages/courtroom-victories.astro:60zi3h">Request a confidential consultation →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
