---
import { getCollection, render } from 'astro:content';
import MediaArticleLayout from '@/layouts/MediaArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('media', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<MediaArticleLayout
  frontmatter={entry.data}
  mdxFilePath={`src/content/media/${entry.id}.mdx`}
  currentId={entry.id}
>
  <Content />
</MediaArticleLayout>
