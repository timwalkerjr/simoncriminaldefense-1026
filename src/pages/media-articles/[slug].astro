---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getMediaArticles } from '@/data/mediaArticles';
import { SITE } from '@/config/site';

export async function getStaticPaths() {
  const MEDIA_ARTICLES = await getMediaArticles();
  return MEDIA_ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const MEDIA_ARTICLES = await getMediaArticles();
const canonicalUrl = new URL(`/media-articles/${article.slug}/`, SITE.url).toString();
const heroImageUrl = new URL(article.images[0]?.src || '/hero-court-1.svg', SITE.url).toString();

const practiceAreasList = [
  { name: 'Drug Crimes Defense', href: '/practice-area/drug-crimes/' },
  { name: 'Assault & Battery', href: '/practice-area/assault-defense/' },
  { name: 'Domestic Violence', href: '/practice-area/domestic-violence-defense/' },
  { name: 'Criminal Sexual Conduct', href: '/practice-area/sex-crime-defense/' },
  { name: 'Expungements (Clean Slate)', href: '/practice-area/expungements/' },
  { name: 'College Crimes Defense', href: '/practice-area/college-crimes-defense/' },
  { name: 'Police Investigations', href: '/practice-area/police-investigations/' },
];

const otherArticles = MEDIA_ARTICLES.filter((a) => a.slug !== article.slug).slice(0, 5);


---

<BaseLayout
  title={`${article.seoTitle || article.title}`}
  description={article.seoDescription || article.title}
  image={heroImageUrl}
  canonicalUrl={canonicalUrl}
>
  <!-- Hero Section -->
  <section class="bg-[#061633] pt-[140px] pb-[60px] relative overflow-hidden" data-ps="src/pages/media-articles/[slug].astro:hero">
    <div class="absolute inset-0 opacity-20" style="background-image: url('/hero-court-1.svg'); background-size: cover; background-position: center;" data-ps="src/pages/media-articles/[slug].astro:hero-bg"></div>
    <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(4, 16, 38, 0.97) 0%, rgba(5, 19, 45, 0.9) 46%, rgba(8, 26, 60, 0.62) 100%);" data-ps="src/pages/media-articles/[slug].astro:hero-overlay"></div>
    
    <div class="relative max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/media-articles/[slug].astro:hero-container">
      <!-- Breadcrumbs -->
      <nav class="text-[13px] text-[#C3CCDA] mb-6 flex flex-wrap items-center gap-2" aria-label="Breadcrumb" data-ps="src/pages/media-articles/[slug].astro:breadcrumb">
        <a href="/" class="hover:text-white transition-colors no-underline text-[#C3CCDA]" data-ps="src/pages/media-articles/[slug].astro:wke5jx">Home</a>
        <span class="text-[#727C8B]" data-ps="src/pages/media-articles/[slug].astro:zdi37a">/</span>
        <a href="/media/" class="hover:text-white transition-colors no-underline text-[#C3CCDA]" data-ps="src/pages/media-articles/[slug].astro:wke5kj">In the News</a>
        <span class="text-[#727C8B]" data-ps="src/pages/media-articles/[slug].astro:zdi379">/</span>
        <span class="text-[#C9A840] truncate max-w-[300px] sm:max-w-[450px]" data-ps="src/pages/media-articles/[slug].astro:zdi378">{article.title}</span>
      </nav>

      <!-- Publisher / Category Eyebrow -->
      <div class="flex items-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#C9A840] mb-4" data-ps="src/pages/media-articles/[slug].astro:eyebrow">
        <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/media-articles/[slug].astro:zdi377"></span>
        <span data-ps="src/pages/media-articles/[slug].astro:zdi376">{article.publisher} {article.sourceDateLabel ? `· ${article.sourceDateLabel}` : ''}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-heading font-black text-white leading-[1.08] tracking-[-0.6px] text-[32px] sm:text-[42px] lg:text-[46px] mb-6 max-w-[980px]" data-ps="src/pages/media-articles/[slug].astro:h1">
        {article.title}
      </h1>

      <!-- Subtitle / Meta -->
      <p class="text-[17px] sm:text-[19px] text-[#C3CCDA] leading-[1.66] max-w-[850px] mb-8" data-ps="src/pages/media-articles/[slug].astro:desc">
        {article.representationNote}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 pt-2" data-ps="src/pages/media-articles/[slug].astro:hero-ctas">
        <a href={article.externalArticleUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-[#732521] text-white font-semibold text-[15.5px] px-[28px] py-[15px] rounded-[3px] hover:bg-[#5a1c19] transition no-underline shadow-sm" data-ps="src/pages/media-articles/[slug].astro:wke5kk">
          <span data-ps="src/pages/media-articles/[slug].astro:zdi375">{article.externalLinkText}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
        </a>
        <a href="tel:+17348876200" class="inline-flex items-center gap-2 border border-white/30 text-white font-semibold text-[15.5px] px-[28px] py-[15px] rounded-[3px] hover:border-[#C9A840] hover:text-[#DDC582] transition no-underline" data-ps="src/pages/media-articles/[slug].astro:wke5kl">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          (734) 887-6200
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#0B1F42] py-4 sm:py-5 border-t border-white/10" data-ps="src/pages/media-articles/[slug].astro:trust">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-center gap-x-6 sm:gap-x-8 gap-y-2 text-[13.5px] sm:text-[14px] text-white" data-ps="src/pages/media-articles/[slug].astro:tan8gm">
      <span data-ps="src/pages/media-articles/[slug].astro:zdi374">40+ Years Defending Michigan</span>
      <span class="text-[#C9A840]" data-ps="src/pages/media-articles/[slug].astro:zdi373">|</span>
      <span data-ps="src/pages/media-articles/[slug].astro:zdi372">Available 24/7 for Urgent Matters</span>
      <span class="text-[#C9A840]" data-ps="src/pages/media-articles/[slug].astro:zdi371">|</span>
      <span data-ps="src/pages/media-articles/[slug].astro:zdi36f">★★★★★ 5.0 Google Rating</span>
    </div>
  </section>

  <!-- Main Content Layout -->
  <section class="py-[60px] lg:py-[80px] bg-[#F7F5F1] border-t border-[#E6E2D9]" data-ps="src/pages/media-articles/[slug].astro:content">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8" data-ps="src/pages/media-articles/[slug].astro:tan8gn">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] xl:grid-cols-[1fr_360px] gap-8 lg:gap-12 items-start" data-ps="src/pages/media-articles/[slug].astro:tan8go">
        
        <!-- Left Main Card -->
        <article class="bg-white border border-[#E6E2D9] rounded-[6px] p-6 sm:p-10 lg:p-12 shadow-sm" data-ps="src/pages/media-articles/[slug].astro:6q32cf">
          <!-- Press Header Details -->
          <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-[#E6E2D9]" data-ps="src/pages/media-articles/[slug].astro:tan8ha">
            <div class="flex flex-wrap items-center gap-3 text-[13.5px] text-[#454F5E]" data-ps="src/pages/media-articles/[slug].astro:tan8hb">
              <span class="font-bold text-[#061633]" data-ps="src/pages/media-articles/[slug].astro:zdi36e">Source: <span data-media-credit>{article.credit}</span></span>
              {article.sourceDateLabel && (
                <>
                  <span class="text-[#98A6BB]" data-ps="src/pages/media-articles/[slug].astro:zdi36d">·</span>
                  <span data-ps="src/pages/media-articles/[slug].astro:zdi36c">{article.sourceDateLabel}</span>
                </>
              )}
            </div>

            <span class="inline-block bg-[#F7F5F1] text-[#061633] text-[12px] font-semibold px-3 py-1 rounded-[2px] border border-[#E6E2D9]" data-ps="src/pages/media-articles/[slug].astro:zdi36b">
              Press Coverage
            </span>
          </div>

          <div class="flex flex-wrap gap-6 mb-8">
            {article.images.map(image => <img data-media-image src={image.src} alt={image.alt} loading="lazy" class="max-w-full w-auto max-h-[360px] object-contain rounded-[4px]" />)}
          </div>
          <!-- HTML Post Content -->
          <div
            class="prose prose-lg max-w-none prose-p:text-[#454F5E] prose-p:text-[17px] prose-p:leading-[1.75] prose-strong:text-[#061633] prose-strong:font-bold prose-a:text-[#732521] hover:prose-a:text-[#5a1c19] prose-a:font-semibold"
            data-media-body={article.id}
            set:html={article.bodyHtml}
          />

          <div class="media-cta not-prose mt-8 pt-8 border-t border-[#E6E2D9]">
            <a data-media-source href={article.externalArticleUrl} target="_blank" rel="noopener" class="inline-flex items-center justify-center bg-[#732521] text-white hover:bg-[#5a1c19] font-semibold px-6 py-4 rounded-[3px] no-underline">{article.externalLinkText}</a>
            <p class="mt-6"><a href="/media/" class="text-[#732521] font-semibold underline">← Back to all press coverage</a></p>
          </div>
        </article>

        <!-- Right Sidebar -->
        <aside class="space-y-6" data-ps="src/pages/media-articles/[slug].astro:vpcdjy">
          <!-- Consultation Card -->
          <div class="bg-[#061633] text-white rounded-[6px] p-6 sm:p-8 border border-white/10 shadow-sm" data-ps="src/pages/media-articles/[slug].astro:tan8hh">
            <div class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[1.6px] text-[#C9A840] mb-3" data-ps="src/pages/media-articles/[slug].astro:tan8hi">
              <span class="w-[16px] h-[1.5px] bg-[#C9A840] inline-block" data-ps="src/pages/media-articles/[slug].astro:zdi36a"></span>
              <span data-ps="src/pages/media-articles/[slug].astro:zdi369">Confidential Defense</span>
            </div>
            
            <h3 class="font-heading font-bold text-[22px] leading-tight text-white mb-3" data-ps="src/pages/media-articles/[slug].astro:a85ovq">
              Facing Charges in Michigan?
            </h3>
            
            <p class="text-[14px] text-[#C3CCDA] leading-[1.6] mb-6" data-ps="src/pages/media-articles/[slug].astro:pgg8xj">
              Do not speak to law enforcement without counsel. Early legal intervention protects your constitutional rights and preserves key evidence.
            </p>

            <div class="space-y-3" data-ps="src/pages/media-articles/[slug].astro:tan8hj">
              <a href="/#contact" class="block w-full text-center bg-[#732521] text-white font-semibold text-[14.5px] py-3 px-4 rounded-[3px] hover:bg-[#5a1c19] transition no-underline" data-ps="src/pages/media-articles/[slug].astro:wke5km">
                Confidential Consultation
              </a>
              
              <a href="tel:+17348876200" class="flex items-center justify-center gap-2 w-full text-center border border-white/30 text-white font-semibold text-[14.5px] py-3 px-4 rounded-[3px] hover:border-[#C9A840] hover:text-[#DDC582] transition no-underline" data-ps="src/pages/media-articles/[slug].astro:wke5kn">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                (734) 887-6200
              </a>
            </div>

            <div class="mt-4 text-center text-[12px] text-[#98A6BB]" data-ps="src/pages/media-articles/[slug].astro:gzflm9">
              Available 24/7 for urgent matters
            </div>
          </div>

          <!-- Other Press Stories -->
          <div class="bg-white border border-[#E6E2D9] rounded-[6px] p-6 shadow-sm" data-ps="src/pages/media-articles/[slug].astro:gzflma">
            <div class="flex items-center gap-2 mb-4 text-[12px] font-bold uppercase tracking-[1.5px] text-[#732521]" data-ps="src/pages/media-articles/[slug].astro:gzflmb">
              <span class="w-[18px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/media-articles/[slug].astro:zdi368"></span>
              <span data-ps="src/pages/media-articles/[slug].astro:zdi367">More Media Coverage</span>
            </div>
            <ul class="list-none p-0 m-0 space-y-3.5 text-[14px]">
              {otherArticles.map((oa, __psIdx) => (
                <li class="border-b border-[#E6E2D9]/60 pb-3 last:border-b-0 last:pb-0" data-ps={`src/pages/media-articles/[slug].astro:5784qb-${__psIdx}`}>
                  <span class="text-[11.5px] font-bold text-[#C9A840] uppercase tracking-wider block mb-0.5" data-ps={`src/pages/media-articles/[slug].astro:zdi366-${__psIdx}`}>{oa.publisher}</span>
                  <a href={oa.path} class="text-[#061633] font-semibold hover:text-[#732521] transition-colors no-underline line-clamp-2 leading-snug" data-ps={`src/pages/media-articles/[slug].astro:wke5ko-${__psIdx}`}>
                    {oa.title}
                  </a>
                </li>
              ))}
            </ul>
            <div class="pt-4 mt-4 border-t border-[#E6E2D9]" data-ps="src/pages/media-articles/[slug].astro:gzflmc">
              <a href="/media/" class="text-[13px] font-bold text-[#732521] hover:underline inline-flex items-center gap-1" data-ps="src/pages/media-articles/[slug].astro:wke5kp">
                View all 21 press articles →
              </a>
            </div>
          </div>

          <!-- Practice Areas Cross Links Card -->
          <div class="bg-white border border-[#E6E2D9] rounded-[6px] p-6 shadow-sm" data-ps="src/pages/media-articles/[slug].astro:gzflmd">
            <div class="flex items-center gap-2 mb-4 text-[12px] font-bold uppercase tracking-[1.5px] text-[#732521]" data-ps="src/pages/media-articles/[slug].astro:gzflme">
              <span class="w-[18px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/media-articles/[slug].astro:zdi35k"></span>
              <span data-ps="src/pages/media-articles/[slug].astro:zdi35j">Practice Areas</span>
            </div>
            <ul class="list-none p-0 m-0 space-y-2.5 text-[14.5px]">
              {practiceAreasList.map((pa, __psIdx) => (
                <li data-ps={`src/pages/media-articles/[slug].astro:5784qc-${__psIdx}`}>
                  <a href={pa.href} class="text-[#454F5E] hover:text-[#732521] transition-colors no-underline flex items-center justify-between group" data-ps={`src/pages/media-articles/[slug].astro:wke5kq-${__psIdx}`}>
                    <span data-ps={`src/pages/media-articles/[slug].astro:zdi35i-${__psIdx}`}>{pa.name}</span>
                    <span class="text-[#C9A840] group-hover:translate-x-1 transition-transform" data-ps={`src/pages/media-articles/[slug].astro:zdi35h-${__psIdx}`}>→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Bottom Consultation Section -->
  <section class="bg-[#061633] py-[90px] lg:py-[100px] border-t border-white/10" data-ps="src/pages/media-articles/[slug].astro:bottom-consultation">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 text-center" data-ps="src/pages/media-articles/[slug].astro:gzflmf">
      <div class="max-w-[820px] mx-auto" data-ps="src/pages/media-articles/[slug].astro:gzflmg">
        <div class="flex items-center justify-center gap-3 text-[12px] font-bold uppercase tracking-[1.8px] text-[#C9A840] mb-4" data-ps="src/pages/media-articles/[slug].astro:gzflmh">
          <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/media-articles/[slug].astro:zdi35g"></span>
          <span data-ps="src/pages/media-articles/[slug].astro:zdi35f">Confidential Legal Consultation</span>
          <span class="w-[28px] h-[2px] bg-[#C9A840] inline-block" data-ps="src/pages/media-articles/[slug].astro:zdi35e"></span>
        </div>

        <h2 class="font-heading font-black text-white leading-[1.14] tracking-[-0.53px] text-[34px] sm:text-[44px] mb-5" data-ps="src/pages/media-articles/[slug].astro:4g98bv">
          Speak with an experienced Ann Arbor criminal defense lawyer.
        </h2>

        <p class="text-[17px] sm:text-[19.04px] text-[#C3CCDA] leading-[1.66] mb-8 max-w-[700px] mx-auto" data-ps="src/pages/media-articles/[slug].astro:pgg8y5">
          Early involvement allows us to evaluate the stop, search, and evidence while every legal and procedural option is still open.
        </p>

        <div class="flex flex-wrap justify-center gap-4" data-ps="src/pages/media-articles/[slug].astro:gzflmi">
          <a href="/#contact" class="inline-flex items-center gap-2 bg-[#732521] text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] hover:bg-[#5a1c19] transition no-underline shadow-sm" data-ps="src/pages/media-articles/[slug].astro:wke5kr">
            Request a Confidential Consultation
          </a>
          <a href="tel:+17348876200" class="inline-flex items-center gap-2 border border-white/30 text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] hover:border-[#C9A840] hover:text-[#DDC582] transition no-underline" data-ps="src/pages/media-articles/[slug].astro:wke5ks">
            Call (734) 887-6200
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
