---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Chelsea Assault Defense Attorney Joe Simon Local, 5-Stars';
const description =
  'Named a Top Ten Criminal Defense Attorney in Michigan by Leading Lawyers Magazine, Joe Simon Successfully Defending Chelsea Assault Cases for Over 35 Years.';

const mainImage = 'https://pagesmith-cdn.com/ee60f2da/images/66aa4f5d078bef17fc3fa2a6_criminal8-a836a1-1536.webp';
const sidebarImageOne = 'https://pagesmith-cdn.com/ee60f2da/images/66aa4f5d078bef17fc3fa22b_criminal-34-76a076-1536.webp';
const sidebarImageTwo = 'https://pagesmith-cdn.com/ee60f2da/images/66aa4f5d078bef17fc3fa2bd_criminal-17-626dbe-1536.webp';

const ladder = [
  'Simple Assault and/or Assault and Battery',
  null,
  'Aggravated Assault',
  'Felonious Assault (Assault with a dangerous weapon)',
  'Assault with Intent to Commit Great Bodily Harm',
  'Assault by Strangulation',
  'Assault with Intent to Commit Murder',
];

const charges = [
  'Assault and/or Assault and Battery Charges',
  'Aggravated Assault Charges',
  'Felonious Assault Charges',
  'Assault With a Dangerous Weapon Charges',
  'Assault With Intent to Commit Great Bodily Harm Charges',
  'Assault By Strangulation Charges',
  'Assault With Intent To Maim Charges',
  'Assault With Intent to Murder Charges',
  'Self Defense',
  'Defense of Others',
];
---

<BaseLayout title={title} description={description} headerVariant="transparent">
  <main data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ue7rk2">
    <section class="practice-hero" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:logh5c">
      <div class="mx-auto w-full max-w-[1280px] px-6" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:7hevf">
        <nav aria-label="Breadcrumb" class="breadcrumbs" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:21v76z">
          <a href="/" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:jjbff4">Home</a><span aria-hidden="true" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:2ljzek">/</span><a href="/service-areas/chelsea" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:jjbfei">Chelsea</a><span aria-hidden="true" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:2ljzej">/</span><span data-ps="src/pages/practice-area/chelsea-assault-charges.astro:2ljzei">Chelsea Assault Charges</span>
        </nav>
        <div class="eyebrow" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:7hevg">Chelsea Assault Charges</div>
        <h1 class="hero-title" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ov4p44">Chelsea Assault Defense Attorney Joe Simon Local, 5-Stars</h1>
        <p class="hero-intro" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:qn9c3f">Defending Chelsea Assault Charges With Excellence For Over 35 Years. Local, Experienced, Established.</p>
        <p class="hero-description" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:qn9c3e">Named a Top Ten Criminal Defense Attorney in Michigan by Leading Lawyers Magazine, Joe Simon Successfully Defending Chelsea Assault Cases for Over 35 Years.</p>
        <div class="hero-actions" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ibnpl0">
          <a class="hero-button" href="/#contact" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:jjbfeh">Request a Confidential Consultation</a>
          <a class="hero-phone" href="tel:+17348876200" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:jjbfeg">(734) 887-6200</a>
        </div>
      </div>
    </section>

    <div class="practice-body mx-auto w-full max-w-[1280px] px-6" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ibnpkz">
      <div class="reading-column" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ibnpky">
        <h2 class="intro-heading" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:a6prwg">Defending Chelsea Assault Charges</h2>
        <img
          class="main-image"
          src={mainImage}
          alt=""
          width="1536"
          height="731"
          loading="lazy"
          decoding="async" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:2arpgv" />

        <div class="source-copy" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ibnpkx">
          <p data-ps="src/pages/practice-area/chelsea-assault-charges.astro:qn9c3d">The “ladder” of Assault charges in Michigan ranges from misdemeanor Simple Assault and/or Assault and Battery, to capital charges, punishable by up to life in prison. These include:</p>
          <ul>
            {ladder.map((item) =>
              item === null ? (
                <li data-ps="src/pages/practice-area/chelsea-assault-charges.astro:axoocl"><a href="/practice-area/domestic-violence-defense" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:jjbfef"><em>Domestic Violence</em></a></li>
              ) : (
                <li data-ps="src/pages/practice-area/chelsea-assault-charges.astro:axoocm">{item}</li>
              ),
            )}
          </ul>
          <p data-ps="src/pages/practice-area/chelsea-assault-charges.astro:qn9c3c">All Chelsea assault charges are aggressively investigated by police, sometimes with mandatory arrest protocols, and are vigorously prosecuted. Only the most capable defense attorneys should handle these charges. For over 35 years, Joseph A. Simon has successfully defended assault charges in Chelsea leading to our case results, peer-reviewed ratings, and our 5-star client ratings.</p>

          <h2 id="main-1" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:a6prwh">Chelsea Assault FAQs:</h2>

          <h3 data-ps="src/pages/practice-area/chelsea-assault-charges.astro:4hp5b7"><strong>I Was Charged With Assault in Chelsea But I Never Touched Anyone. Is This Legal?</strong></h3>
          <p data-ps="src/pages/practice-area/chelsea-assault-charges.astro:qn9c3b">An Assault is the offer of physical force or violence (clenching a fist, pointing a weapon) to another. A Battery is a harmful or offensive touching (actual contact with a person or an object closely connected with a person) of another. Assault charges, therefore, do not necessarily require an actual touching. Assaults increase in severity by certain “aggravating variables,” including the use of a weapon, a resulting injury or serious injury, or an intent to cause great bodily harm or death.</p>

          <h3 data-ps="src/pages/practice-area/chelsea-assault-charges.astro:4hp5b6">I Was Charged With Assault in Chelsea but I Was Defending Myself. Can I Still Be Prosecuted?</h3>
          <p data-ps="src/pages/practice-area/chelsea-assault-charges.astro:qn9c3a">Yes. Self Defense is an “affirmative defense” that is usually decided by a judge or jury in a trial. In Michigan, a person must both honestly and reasonably believe they are in danger to use force to defend themselves or another to lawfully exercise the privilege. Self Defense can sometimes require a duty to retreat from danger when it is safe to do so. In some instances, a person has a right to "stand their ground" and use force, sometimes deadly force, to protect themselves.</p>
          <p data-ps="src/pages/practice-area/chelsea-assault-charges.astro:qn9c39">For over 35 years, Joseph A. Simon has been helping persons charged with Ann Arbor assault crimes protect their freedom, reputation and future goals. If you or a loved one are being investigated for or charged with an assault offense in Ann Arbor contact our firm at 734-887-6200 for a free consultation.</p>

          <h3 data-ps="src/pages/practice-area/chelsea-assault-charges.astro:4hp5b5">Is it Best to have a Local Criminal Defense Attorney Represent Me in My Chelsea Assault Case?</h3>
          <p data-ps="src/pages/practice-area/chelsea-assault-charges.astro:qn9c38">Absolutely. Local, established criminal defense attorneys have an intimate knowledge of the local court practices and participants. Knowing the arguments that will appeal to the presiding judge, knowing the practices and protocols of the local prosecuting attorneys, and having local recognition and standing in a legal community can be invaluable to a case outcome. The Law Offices of Joseph A. Simon is truly local to Chelsea. Located in Washtenaw County in the heart of Ann Arbor, just a few miles from Chelsea, we regularly and frequently practice in the 14A-3 District Court and stand ready to serve you.</p>
        </div>
      </div>

      <aside class="practice-sidebar" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:cu2b1">
        <section class="sidebar-card" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:logh5b">
          <h2 data-ps="src/pages/practice-area/chelsea-assault-charges.astro:a6prwi">We Defend These Charges:</h2>
          <ul class="charge-list">
            {charges.map((item) => <li data-ps="src/pages/practice-area/chelsea-assault-charges.astro:axoocn">{item}</li>)}
          </ul>
        </section>
        <img class="sidebar-image" src={sidebarImageOne} alt="" width="1536" height="1024" loading="lazy" decoding="async" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:2arpg9" />
        <img class="sidebar-image" src={sidebarImageTwo} alt="" width="1536" height="1024" loading="lazy" decoding="async" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:2arpg8" />
        <a class="all-practices" href="/service-areas/chelsea" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:jjbfee">Explore Chelsea Legal Services →</a>
        <a class="all-practices" href="/practice-areas" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:jjbfed">Explore All Practice Areas <span aria-hidden="true" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:2ljzeh">→</span></a>
      </aside>
    </div>

    <section class="consult-band" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:logh5a">
      <div class="mx-auto w-full max-w-[1280px] px-6 text-center" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ibnpkw">
        <div class="mb-4" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ibnpkv">
          <span class="consult-eyebrow" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:2ljzdv"><span class="consult-rule" aria-hidden="true" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:2ljzdu"></span>Consultation</span>
        </div>
        <h2 class="consult-title" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:a6prwj">Whatever the charge, talk to us first.</h2>
        <p class="consult-text" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:qn9c2m">Your consultation is confidential and available 24/7. Tell us what you're facing and we'll explain how Michigan law applies to it.</p>
        <div class="consult-actions" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ibnpku">
          <a href="/#contact" class="consult-primary" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:l92pgk">
            Request a Confidential Consultation
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
          <a href="tel:+17348876200" class="consult-secondary" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:l92pgj">Call (734) 887-6200</a>
        </div>
        <div class="consult-links" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ibnpkt">
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-3" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ibnpks">
            <a href="/" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:l92pgi">Home</a>
            <a href="/practice-areas" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:l92pgh">Practice Areas</a>
            <a href="/#results" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:l92pgg">Results</a>
            <a href="/#about" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:l92pgf">About</a>
            <a href="/#testimonials" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:l92pge">Testimonials</a>
            <a href="/#faq" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:l92pgd">FAQs</a>
            <a href="/#contact" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:l92pgc">Contact</a>
          </div>
          <div class="mt-6" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:ibnpkr">
            <a href="tel:+17348876200" class="consult-call" data-ps="src/pages/practice-area/chelsea-assault-charges.astro:l92pgb">Call (734) 887-6200</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .practice-hero {
    color: #fff;
    padding: 9rem 0 6rem;
    background-color: #061532;
    background-image:
      linear-gradient(100deg, rgba(4, 16, 38, 0.97), rgba(8, 26, 60, 0.85)),
      url("https://jas-law-astro-review.netlify.app/hero-court-1.webp");
    background-size: auto, cover;
    background-position: 0% 0%, 50% 50%;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 13px;
    color: #c3ccda;
    margin-bottom: 2rem;
  }
  .breadcrumbs a:hover { color: #fff; }
  .breadcrumbs span[aria-hidden='true'] { opacity: 0.7; }
  .breadcrumbs span:last-child { color: #ddc582; }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #ddc582;
    margin-bottom: 1.25rem;
  }
  .eyebrow::before {
    content: '';
    width: 28px;
    height: 2px;
    background: #c9a840;
  }

  .hero-title {
    color: #fff;
    font-weight: 900;
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.6px;
    max-width: 1120px;
    margin: 0 0 1.5rem;
  }

  .hero-intro {
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.5rem);
    line-height: 1.5;
    color: #ddc582;
    max-width: 760px;
    margin: 0 0 1rem;
  }

  .hero-description {
    font-size: 17px;
    line-height: 1.7;
    color: #c3ccda;
    max-width: 720px;
    margin: 0 0 2.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    padding: 16px 30px;
    border-radius: 3px;
    background: #732521;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }
  .hero-button:hover { background: #581b19; }

  .hero-phone {
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    padding-bottom: 6px;
    border-bottom: 1px solid #c9a840;
    transition: color 0.2s ease;
  }
  .hero-phone:hover { color: #ddc582; }

  .practice-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  @media (min-width: 1024px) {
    .practice-body {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 3.5rem;
      align-items: start;
    }
  }

  .intro-heading {
    font-weight: 900;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.5px;
    color: #061532;
    margin: 0 0 1.75rem;
  }

  .main-image,
  .sidebar-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 2px;
  }
  .main-image { aspect-ratio: 21 / 10; margin-bottom: 2.25rem; }
  .sidebar-image { aspect-ratio: 3 / 2; margin-bottom: 1.5rem; }

  .source-copy {
    color: #343d4d;
    font-size: 17px;
    line-height: 1.85;
  }
  .source-copy p { margin: 0 0 1.5rem; }
  .source-copy ul {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
  }
  .source-copy ul li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.6rem;
  }
  .source-copy ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #c9a840;
  }
  .source-copy ul a {
    color: #732521;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .source-copy h2 {
    font-weight: 900;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    line-height: 1.15;
    color: #061532;
    margin: 3rem 0 1.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid #e7e3d9;
  }
  .source-copy h3 {
    font-weight: 800;
    font-size: 1.4rem;
    line-height: 1.35;
    color: #061532;
    margin: 2.25rem 0 0.9rem;
  }
  .source-copy h3 strong { font-weight: 800; }

  .practice-sidebar {
    display: flex;
    flex-direction: column;
  }

  .sidebar-card {
    background: #f7f6f2;
    border: 1px solid #e7e3d9;
    border-radius: 6px;
    padding: 1.5rem 1.5rem 1.25rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-card h2 {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #732521;
    margin: 0 0 1rem;
  }
  .charge-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #454e5e;
  }
  .charge-list li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.7rem;
  }
  .charge-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: #c9a840;
  }

  .all-practices {
    display: block;
    color: #732521;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 1rem;
    transition: color 0.2s ease;
  }
  .all-practices:hover { color: #581b19; text-decoration: underline; }

  .consult-band {
    background: #061633;
    padding: 5rem 0 3.5rem;
    color: #fff;
  }
  @media (min-width: 1024px) {
    .consult-band { padding: 100px 0 56px; }
  }

  .consult-eyebrow {
    display: inline-flex;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #c9a840;
  }
  .consult-rule {
    display: inline-block;
    width: 28px;
    height: 2px;
    margin-right: 0.75rem;
    background: #c9a840;
  }

  .consult-title {
    color: #fff;
    font-weight: 900;
    font-size: clamp(2rem, 1.5rem + 1.8vw, 2.75rem);
    line-height: 1.14;
    letter-spacing: -0.5px;
    max-width: 820px;
    margin: 0 auto 1.5rem;
  }

  .consult-text {
    font-size: 18px;
    line-height: 1.7;
    color: #c3ccda;
    max-width: 680px;
    margin: 0 auto 2.25rem;
  }

  .consult-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .consult-primary,
  .consult-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 16px 30px;
    border-radius: 3px;
    font-size: 16px;
    font-weight: 600;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .consult-primary { background: #732521; color: #fff; }
  .consult-primary:hover { background: #581b19; }
  .consult-secondary { border: 1px solid rgba(255, 255, 255, 0.3); color: #fff; }
  .consult-secondary:hover { border-color: #c9a840; color: #ddc582; }

  .consult-links {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2rem;
    margin-top: 2rem;
  }
  .consult-links a:not(.consult-call) {
    font-size: 14px;
    color: #c3ccda;
    transition: color 0.2s ease;
  }
  .consult-links a:not(.consult-call):hover { color: #fff; }
  .consult-call {
    color: #c9a840;
    font-size: 16px;
    font-weight: 700;
    transition: color 0.2s ease;
  }
  .consult-call:hover { color: #ddc582; }

  @media (prefers-reduced-motion: reduce) {
    .hero-button,
    .hero-phone,
    .consult-primary,
    .consult-secondary,
    .all-practices { transition: none; }
  }
</style>
