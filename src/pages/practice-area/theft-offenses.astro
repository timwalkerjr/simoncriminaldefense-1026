---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = 'Washtenaw County Theft Crimes Defense Lawyer - Joe Simon';
const pageDescription =
  'Named a Michigan Top Ten Criminal Defense Attorney by Leading Lawyers Magazine, Attorney Joe Simon Has Successfully Defended Theft Charges for Over 35 Years.';

const heroImage = 'https://jas-law-astro-review.netlify.app/hero-court-1.webp';
const mainImage = 'https://pagesmith-cdn.com/ee60f2da/images/66aa4f5d078bef17fc3fa264_5e693233d73d1103401bf0c1_criminal1-74abf4-1536.webp';

const charges = [
  'Larceny Less Than $200',
  'Larceny $200 to $1000',
  'Larceny $1,000 to $20,000',
  'Larceny $20,000 or More',
  'Embezzlement Less Than $200',
  'Embezzlement $200 to $1000',
  'Embezzlement $1,000 to $20,000',
  'Embezzlement $20,000 or More',
  'Obtaining Money or Property By False Pretenses',
  'Receiving and Concealing Stolen Property',
  'Larceny From A Motor Vehicle',
  'Larceny From A Person',
  'Larceny of a Motor Vehicle',
  'Larceny By Conversion',
  'Retail Fraud First, Second, and Third Degree',
  'Forgery-Uttering & Publishing',
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  headerVariant="transparent"
>
  <main data-ps="src/pages/practice-area/theft-offenses.astro:o3d9rw">
    <section class="practice-hero" style={`background-image: linear-gradient(100deg, rgba(4, 16, 38, 0.97), rgba(8, 26, 60, 0.85)), url("${heroImage}");`} data-ps="src/pages/practice-area/theft-offenses.astro:hf8ztd">
      <div class="practice-container" data-ps="src/pages/practice-area/theft-offenses.astro:kilvyi">
        <nav class="breadcrumbs" aria-label="Breadcrumb" data-ps="src/pages/practice-area/theft-offenses.astro:mczoa1">
          <a href="/" data-ps="src/pages/practice-area/theft-offenses.astro:p9owmw">Home</a><span data-ps="src/pages/practice-area/theft-offenses.astro:j53010">/</span><a href="/practice-areas" data-ps="src/pages/practice-area/theft-offenses.astro:p9owmv">Practice Areas</a><span data-ps="src/pages/practice-area/theft-offenses.astro:j5300z">/</span><span class="current" data-ps="src/pages/practice-area/theft-offenses.astro:j5300y">Theft Offenses</span>
        </nav>
        <div class="eyebrow" data-ps="src/pages/practice-area/theft-offenses.astro:ug5w1q">Theft Offenses</div>
        <h1 data-ps="src/pages/practice-area/theft-offenses.astro:et06o7">Washtenaw County Theft Crimes Defense Lawyer - Joe Simon</h1>
        <p class="hero-intro" data-ps="src/pages/practice-area/theft-offenses.astro:wdmtbs">Larceny, Embezzlement, and Theft Charges Defense Lawyer Joseph A. Simon. Excellence For Over 35 Years. Local, Experienced, Established.</p>
        <p class="hero-description" data-ps="src/pages/practice-area/theft-offenses.astro:wdmtbr">Named a Michigan Top Ten Criminal Defense Attorney by Leading Lawyers Magazine, Attorney Joe Simon Has Successfully Defended Theft Charges for Over 35 Years.</p>
        <div class="hero-actions" data-ps="src/pages/practice-area/theft-offenses.astro:ug5w1r">
          <a class="button" href="/#contact" data-ps="src/pages/practice-area/theft-offenses.astro:p9owmu">Request a Confidential Consultation</a>
          <a class="phone" href="tel:+17348876200" data-ps="src/pages/practice-area/theft-offenses.astro:p9owmt">(734) 887-6200</a>
        </div>
      </div>
    </section>

    <div class="practice-body practice-container" data-ps="src/pages/practice-area/theft-offenses.astro:ug5w1s">
      <div class="reading-column" data-ps="src/pages/practice-area/theft-offenses.astro:ug5w1t">
        <img class="main-image" src={mainImage} alt="" loading="lazy" width="1536" height="731" data-ps="src/pages/practice-area/theft-offenses.astro:i0crmu" />
        <article class="source-copy" data-ps="src/pages/practice-area/theft-offenses.astro:fdbzzk">
          <p data-ps="src/pages/practice-area/theft-offenses.astro:wdmtbq">Theft offenses in Michigan include Larceny -the taking of another person's personal property with the intent to keep it; Identity Theft; Uttering and Publishing; Embezzlement; Retail Fraud; and Possessing Stolen Property; and more. These are examples of specialized theft offenses comprised of different requirements that require the assistance and guidance of an experienced criminal defense attorney.</p>
          <p data-ps="src/pages/practice-area/theft-offenses.astro:wdmtb4">Retail Fraud is Michigan's shoplifting legislation. It can be charged as Third Degree Retail Fraud, a 93-day misdemeanor, Second Degree Retail Fraud, a 1-year misdemeanor, and First Degree Retail Fraud, a felony with a maximum sentence of five years. The the degrees are based on the value of the goods in question and the number of prior Retail Fraud offenses a person has.</p>
          <p data-ps="src/pages/practice-area/theft-offenses.astro:wdmtb3">Identity Theft involves using, with intent to defraud, “personal identifying information” to obtain or to try to obtain property, access confidential information or commit another crime. "Personal identifying information" means a name, number, or other information that is used to identify a specific person or to access to a person's financial accounts. This can be as simple as giving a false name, driver license or social security number or as extensive as using a person’s mother's maiden name or log-in password.</p>
          <p data-ps="src/pages/practice-area/theft-offenses.astro:wdmtb2">Embezzlement is the theft of property that you came to possess as a result of your employment or other agency relationship. Depending on the value of the property, it can be charged as a 93-day misdemeanor (Embezzlement under $200), a 20-year felony (Embezzlement over $100,000) or anywhere in between. For example, Embezzlement $1,000.00 or more but less than $20,000.00 is a five year offense. Prior convictions may increase the possible penalty. If the embezzlement victim is a non-profit corporation, a charity, or a person 60 years of age or over, a sentence for embezzlement may run consecutively to any sentence imposed for any other criminal offense.</p>
          <p data-ps="src/pages/practice-area/theft-offenses.astro:wdmtb1">Many people don't realize it is also a crime to buy, receive, possess, conceal, or aid in the concealment of stolen, embezzled, or converted money, goods, or property. A person can be guilty of this crime even if he did not know that the property was stolen. All the prosecutor needs to show is a reason to believe that the property was stolen. A cracked steering column in a vehicle you are driving would almost certainly suffice – even if you can prove that you paid the “owner” $10,000 for the car. Telling the police you paid $100 for a nearly-new 16-inch MacBook Pro is an example of how a prosecutor may try to establish a reason to believe that the computer may have been stolen. A deal too good to be true usually is.</p>
          <h3 data-ps="src/pages/practice-area/theft-offenses.astro:qva0v5">What Do The Best Criminal Defense Attorneys Do To Defend Theft Offenses?</h3>
          <p data-ps="src/pages/practice-area/theft-offenses.astro:wdmtb0">Ethically, lawyers cannot and should not make claims about themselves such as being “the best.” Instead, lawyers should stand on their experience, ratings, reputation, and results. The best practices to defend theft cases include: intimate knowledge of the local courts and participants; a thorough confidential client interview; obtaining all case discovery including in-car and body-cam police video, audio dispatch recordings, 9-1-1 audio recordings, obtaining surveillance video, interviewing any witnesses, preparing a client for the courtroom, and the ability to present a case in court in pretrial motion hearings and at trial.</p>
          <p data-ps="src/pages/practice-area/theft-offenses.astro:wdmtaz">In Michigan, theft offenses can be nuanced and complicated and should be defended by only the most experienced defense attorneys. For over 35 years, Joseph A. Simon has been helping persons charged with theft offenses protect their freedom, reputation and future goals. Our attorneys have over 60 years combined experience in criminal defense and an unwavering commitment to excellence in criminal defense. If you or a loved one are being investigated for or charged with a theft offense in Washtenaw, Wayne, Jackson, Livingston, or Lenawee County, contact our firm at 734-887-6200 for a free consultation.</p>
        </article>
      </div>

      <aside class="practice-sidebar" data-ps="src/pages/practice-area/theft-offenses.astro:d9q1qp">
        <section class="sidebar-card charges" data-ps="src/pages/practice-area/theft-offenses.astro:hf8ztc">
          <h2 data-ps="src/pages/practice-area/theft-offenses.astro:thf3we">We Defend These Charges:</h2>
          <ul>
            {charges.map((charge) => <li data-ps="src/pages/practice-area/theft-offenses.astro:sqg7fl">{charge}</li>)}
          </ul>
        </section>
        <a class="all-practices" href="/practice-areas" data-ps="src/pages/practice-area/theft-offenses.astro:p9owms">Explore All Practice Areas <span aria-hidden="true" data-ps="src/pages/practice-area/theft-offenses.astro:j5300x">→</span></a>
      </aside>
    </div>

    <section class="bg-[#061633] py-[100px]" data-ps="src/pages/practice-area/theft-offenses.astro:hf8ztb">
      <div class="max-w-[1280px] mx-auto px-6 text-center" data-ps="src/pages/practice-area/theft-offenses.astro:ug5w1u">
        <div class="mb-4" data-ps="src/pages/practice-area/theft-offenses.astro:ug5w1v">
          <span class="inline-flex items-center text-[12px] font-bold uppercase tracking-[1.8px] text-[#C9A840]" data-ps="src/pages/practice-area/theft-offenses.astro:j5300w"><span class="w-[28px] h-[2px] bg-[#C9A840] inline-block mr-3" data-ps="src/pages/practice-area/theft-offenses.astro:j5300v"></span>Consultation</span>
        </div>
        <h2 class="text-[44px] font-black leading-[1.14] tracking-[-0.53px] text-white mb-6 max-w-[820px] mx-auto" data-ps="src/pages/practice-area/theft-offenses.astro:thf3wd">Whatever the charge, talk to us first.</h2>
        <p class="text-[18.08px] leading-[31px] text-[#C3CCDA] max-w-[680px] mx-auto mb-8" data-ps="src/pages/practice-area/theft-offenses.astro:wdmtay">Your consultation is confidential and available 24/7. Tell us what you're facing and we'll explain how Michigan law applies to it.</p>
        <div class="flex flex-wrap justify-center gap-4 mb-12" data-ps="src/pages/practice-area/theft-offenses.astro:ug5w1w">
          <a href="/#contact" class="bg-[#732521] text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] hover:bg-[#5a1c19] transition inline-flex items-center gap-2" data-ps="src/pages/practice-area/theft-offenses.astro:p9owmr">Request a Confidential Consultation<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
          <a href="tel:+17348876200" class="border border-white/30 text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] hover:border-[#C9A840] hover:text-[#DDC582] transition inline-flex items-center gap-2" data-ps="src/pages/practice-area/theft-offenses.astro:p9owm5">Call (734) 887-6200</a>
        </div>
        <div class="border-t border-white/10 pt-8 mt-8" data-ps="src/pages/practice-area/theft-offenses.astro:ug5w1x">
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-3" data-ps="src/pages/practice-area/theft-offenses.astro:ug5w1y">
            <a href="/" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/theft-offenses.astro:z6no2o">Home</a>
            <a href="/practice-areas" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/theft-offenses.astro:z6no2n">Practice Areas</a>
            <a href="/#results" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/theft-offenses.astro:z6no2m">Results</a>
            <a href="/#about" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/theft-offenses.astro:z6no2l">About</a>
            <a href="/#testimonials" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/theft-offenses.astro:z6no2k">Testimonials</a>
            <a href="/#faq" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/theft-offenses.astro:z6no2j">FAQs</a>
            <a href="/#contact" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/theft-offenses.astro:z6no2i">Contact</a>
          </div>
          <div class="mt-6" data-ps="src/pages/practice-area/theft-offenses.astro:ug5w1z">
            <a href="tel:+17348876200" class="text-[#C9A840] font-bold text-[16px] hover:text-[#DDC582] transition" data-ps="src/pages/practice-area/theft-offenses.astro:z6no2h">Call (734) 887-6200</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .practice-container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  /* Hero */
  .practice-hero {
    background-color: var(--color-dark-background);
    background-size: auto, cover;
    background-position: 0% 0%, 50% 50%;
    background-repeat: no-repeat;
    color: #fff;
    padding-top: 136px;
    padding-bottom: 64px;
  }
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: #c3ccda;
    margin-bottom: 40px;
  }
  .breadcrumbs a {
    color: #c3ccda;
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: #fff;
  }
  .breadcrumbs .current {
    color: #ddc582;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #c9a840;
    margin-bottom: 20px;
  }
  .eyebrow::before {
    content: "";
    width: 28px;
    height: 2px;
    background: #c9a840;
  }
  .practice-hero h1 {
    font-size: clamp(2.25rem, 1.4rem + 2.8vw, 3.25rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.6px;
    color: #fff;
    max-width: 1000px;
    margin: 0 0 24px;
  }
  .hero-intro {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.5;
    color: #ddc582;
    max-width: 920px;
    margin: 0 0 18px;
  }
  .hero-description {
    font-size: 17px;
    line-height: 1.7;
    color: #c3ccda;
    max-width: 800px;
    margin: 0 0 32px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
  }
  .hero-actions .button {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    padding: 16px 30px;
    border-radius: 3px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .hero-actions .button:hover {
    background: var(--color-primary-hover);
  }
  .hero-actions .phone {
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid #c9a840;
  }

  /* Body */
  .practice-body {
    display: grid;
    grid-template-columns: minmax(0, 800px) 300px;
    justify-content: center;
    gap: 72px;
    padding-top: 56px;
    padding-bottom: 80px;
    align-items: start;
  }
  .reading-column {
    min-width: 0;
    max-width: 800px;
  }
  @media (max-width: 1200px) {
    .practice-body {
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 48px;
    }
  }
  .main-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2.1 / 1;
    object-fit: cover;
    border-radius: 2px;
    margin-bottom: 36px;
  }
  .source-copy {
    color: var(--color-muted-foreground);
    font-size: 18px;
    line-height: 1.8;
  }
  .source-copy p {
    margin: 0 0 24px;
  }
  .source-copy h3 {
    font-size: 24px;
    font-weight: 900;
    line-height: 1.3;
    color: var(--color-foreground);
    margin: 40px 0 18px;
  }

  /* Sidebar */
  .practice-sidebar {
    position: static;
  }
  .sidebar-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 28px 26px 24px;
  }
  .sidebar-card h2 {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-primary);
    line-height: 1.5;
    margin: 0 0 20px;
  }
  .sidebar-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .sidebar-card li {
    position: relative;
    padding-left: 22px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }
  .sidebar-card li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }
  .all-practices {
    display: inline-block;
    margin-top: 24px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }
  .all-practices:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .practice-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .reading-column {
      max-width: none;
    }
    .practice-sidebar {
      max-width: 420px;
    }
  }

  @media (max-width: 480px) {
    .practice-hero {
      padding-top: 120px;
    }
    .source-copy {
      font-size: 17px;
    }
  }
</style>
