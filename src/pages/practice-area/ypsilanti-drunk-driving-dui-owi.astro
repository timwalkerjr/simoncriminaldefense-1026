        <h2 class="font-heading text-[34px] font-black leading-[1.2] tracking-[-0.5px] text-[#061532] md:text-[44px]" data-ps="src/pages/practice-area/ypsilanti-drunk-driving-dui-owi.astro:xdbjeb">
