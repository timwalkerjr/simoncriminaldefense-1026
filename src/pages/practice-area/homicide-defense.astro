---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Washtenaw County Homicide Defense Lawyer - Joseph A. Simon';
const description =
  'Named a 2020 Top Ten Criminal Defense Attorney in Michigan by Leading Lawyers Magazine, Attorney Joe Simon Defending Homicide Charges for Over 35 Years.';

const chargeItems = [
  'Murder',
  'First Degree Murder',
  'Second Degree Murder',
  'Voluntary Manslaughter',
  'Involuntary Manslaughter',
  'Drunk Driving - DUI/OWI Resulting in Death',
  'Driving on Suspended License Resulting in Death',
  'Delivery of a Controlled Substance Resulting in Death',
  'Vehicular Homicide',
  'Moving Violation Resulting in Death',
];
---

<BaseLayout title={title} description={description} headerVariant="transparent">
  <main class="homicide-page" data-ps="src/pages/practice-area/homicide-defense.astro:5wao0y">
    <section class="practice-hero" data-ps="src/pages/practice-area/homicide-defense.astro:sqvbth">
      <div class="practice-container" data-ps="src/pages/practice-area/homicide-defense.astro:q6tbsg">
        <nav class="breadcrumbs" aria-label="Breadcrumb" data-ps="src/pages/practice-area/homicide-defense.astro:s1743z">
          <a href="/" data-ps="src/pages/practice-area/homicide-defense.astro:xaiyj5">Home</a>
          <span aria-hidden="true" data-ps="src/pages/practice-area/homicide-defense.astro:xoyg78">/</span>
          <a href="/practice-areas" data-ps="src/pages/practice-area/homicide-defense.astro:xaiyj4">Practice Areas</a>
          <span aria-hidden="true" data-ps="src/pages/practice-area/homicide-defense.astro:xoyg79">/</span>
          <span class="current" data-ps="src/pages/practice-area/homicide-defense.astro:xoyg7a">Homicide</span>
        </nav>

        <div class="eyebrow" data-ps="src/pages/practice-area/homicide-defense.astro:umr17c">Homicide</div>

        <h1 data-ps="src/pages/practice-area/homicide-defense.astro:ha15zc">Washtenaw County Homicide Defense Lawyer - Joseph A. Simon</h1>

        <p class="hero-intro" data-ps="src/pages/practice-area/homicide-defense.astro:umn6r4">
          Washtenaw County Homicide Defense Lawyer. Excellence For Over 35 Years. Local, Experienced, Established.
        </p>

        <p class="hero-description" data-ps="src/pages/practice-area/homicide-defense.astro:umn6rq">
          Named a 2020 Top Ten Criminal Defense Attorney in Michigan by Leading Lawyers Magazine, Attorney Joe Simon
          Defending Homicide Charges for Over 35 Years.
        </p>

        <div class="hero-actions" data-ps="src/pages/practice-area/homicide-defense.astro:umr17d">
          <a class="button" href="/#contact" data-ps="src/pages/practice-area/homicide-defense.astro:xaiyj3">Request a Confidential Consultation</a>
          <a class="phone" href="tel:+17348876200" data-ps="src/pages/practice-area/homicide-defense.astro:xaiyj2">(734) 887-6200</a>
        </div>
      </div>
    </section>

    <div class="practice-body practice-container" data-ps="src/pages/practice-area/homicide-defense.astro:umr17e">
      <div class="reading-column" data-ps="src/pages/practice-area/homicide-defense.astro:umr17f">
        <h2 class="intro-heading" data-ps="src/pages/practice-area/homicide-defense.astro:2lm8rp">
          Persons Facing Homicide Charges Should Look To Only The Most Experienced Criminal Defense Attorneys.
        </h2>

        <img
          class="main-image"
          src="https://cdn.prod.website-files.com/66aa4f5d078bef17fc3fa225/66aa4f5d078bef17fc3fa3b2_criminal3.avif"
          alt=""
          loading="lazy"
          decoding="async" data-ps="src/pages/practice-area/homicide-defense.astro:nok7g5" />

        <article class="source-copy" data-ps="src/pages/practice-area/homicide-defense.astro:ussbna">
          <p data-ps="src/pages/practice-area/homicide-defense.astro:umn6rr">
            Homicide offenses include Murder, Voluntary and Involuntary Manslaughter, and Vehicular Homicide such as
            Drunk Driving (OWI) Resulting in Death, Delivery of a Controlled Substance Resulting in Death and Moving
            Violation resulting in Death.
          </p>
          <p data-ps="src/pages/practice-area/homicide-defense.astro:umn6rs">
            Homicide cases should only be defended by the most experienced and capable defense attorneys. For over 35
            years, Joseph A. Simon has aggressively and successfully defended persons charged with homicide offenses and
            has earned the highest professional accolades for legal ability and ethics.
          </p>
          <p data-ps="src/pages/practice-area/homicide-defense.astro:umn6rt">
            If you or a loved one are being investigated for, or have been arrested or charged with a homicide offense in
            Ann Arbor or Washtenaw, Wayne, Jackson, Livingston, or Lenawee County, contact Ann Arbor criminal defense
            attorney Joseph A. Simon at 734-887-6200 and see why so many clients have chosen Joseph A. Simon to be their
            defense attorney and protector of their freedom and reputation.
          </p>
        </article>
      </div>

      <aside class="practice-sidebar" data-ps="src/pages/practice-area/homicide-defense.astro:2wzef">
        <section class="sidebar-card charges" data-ps="src/pages/practice-area/homicide-defense.astro:sqvbti">
          <h2 data-ps="src/pages/practice-area/homicide-defense.astro:2lm8rq">We Defend These Charges:</h2>
          <ul>
            {chargeItems.map((item) => <li data-ps="src/pages/practice-area/homicide-defense.astro:3cl58m">{item}</li>)}
          </ul>
        </section>

        <img
          class="sidebar-image"
          src="https://cdn.prod.website-files.com/66aa4f5d078bef17fc3fa225/66aa4f5d078bef17fc3fa264_5e693233d73d1103401bf0c1_criminal1.avif"
          alt=""
          loading="lazy"
          decoding="async" data-ps="src/pages/practice-area/homicide-defense.astro:nok7gr" />
        <img
          class="sidebar-image"
          src="https://cdn.prod.website-files.com/66aa4f5d078bef17fc3fa225/66aa4f5d078bef17fc3fa3b3_criminal4.avif"
          alt=""
          loading="lazy"
          decoding="async" data-ps="src/pages/practice-area/homicide-defense.astro:nok7gs" />

        <a class="all-practices" href="/practice-areas" data-ps="src/pages/practice-area/homicide-defense.astro:xaiyj1">
          Explore All Practice Areas <span aria-hidden="true" data-ps="src/pages/practice-area/homicide-defense.astro:xoyg7b">→</span>
        </a>
      </aside>
    </div>

    <section class="bg-[#061633] py-[100px]" data-ps="src/pages/practice-area/homicide-defense.astro:sqvbtj">
      <div class="max-w-[1280px] mx-auto px-6 text-center" data-ps="src/pages/practice-area/homicide-defense.astro:umr17g">
        <div class="mb-4" data-ps="src/pages/practice-area/homicide-defense.astro:umr17h">
          <span class="inline-flex items-center text-[12px] font-bold uppercase tracking-[1.8px] text-[#C9A840]" data-ps="src/pages/practice-area/homicide-defense.astro:xoyg7c"><span class="w-[28px] h-[2px] bg-[#C9A840] inline-block mr-3" data-ps="src/pages/practice-area/homicide-defense.astro:xoyg7d"></span>Consultation</span>
        </div>
        <h2 class="text-[44px] font-black leading-[1.14] tracking-[-0.53px] text-white mb-6 max-w-[820px] mx-auto" data-ps="src/pages/practice-area/homicide-defense.astro:2lm8rr">Whatever the charge, talk to us first.</h2>
        <p class="text-[18.08px] leading-[31px] text-[#C3CCDA] max-w-[680px] mx-auto mb-8" data-ps="src/pages/practice-area/homicide-defense.astro:umn6ru">Your consultation is confidential and available 24/7. Tell us what you're facing and we'll explain how Michigan law applies to it.</p>
        <div class="flex flex-wrap justify-center gap-4 mb-12" data-ps="src/pages/practice-area/homicide-defense.astro:umr17i">
          <a href="/#contact" class="bg-[#732521] text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] hover:bg-[#5a1c19] transition inline-flex items-center gap-2" data-ps="src/pages/practice-area/homicide-defense.astro:xaiyif">Request a Confidential Consultation<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
          <a href="tel:+17348876200" class="border border-white/30 text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] hover:border-[#C9A840] hover:text-[#DDC582] transition inline-flex items-center gap-2" data-ps="src/pages/practice-area/homicide-defense.astro:xaiyie">Call (734) 887-6200</a>
        </div>
        <div class="border-t border-white/10 pt-8 mt-8" data-ps="src/pages/practice-area/homicide-defense.astro:umr17j">
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-3" data-ps="src/pages/practice-area/homicide-defense.astro:umr17k">
            <a href="/" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/homicide-defense.astro:xaiyid">Home</a>
            <a href="/practice-areas" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/homicide-defense.astro:co9gor">Practice Areas</a>
            <a href="/#results" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/homicide-defense.astro:co9gos">Results</a>
            <a href="/#about" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/homicide-defense.astro:co9got">About</a>
            <a href="/#testimonials" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/homicide-defense.astro:co9gou">Testimonials</a>
            <a href="/#faq" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/homicide-defense.astro:co9gov">FAQs</a>
            <a href="/#contact" class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/homicide-defense.astro:co9gow">Contact</a>
          </div>
          <div class="mt-6" data-ps="src/pages/practice-area/homicide-defense.astro:umr17l">
            <a href="tel:+17348876200" class="text-[#C9A840] font-bold text-[16px] hover:text-[#DDC582] transition" data-ps="src/pages/practice-area/homicide-defense.astro:co9gox">Call (734) 887-6200</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .practice-hero {
    position: relative;
    padding: 150px 0 96px;
    color: #ffffff;
    background:
      linear-gradient(100deg, rgba(4, 16, 38, 0.97) 0%, rgba(8, 26, 60, 0.85) 100%),
      url("https://jas-law-astro-review.netlify.app/hero-court-1.webp") 50% 50% / cover no-repeat;
  }

  .practice-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    line-height: 19.5px;
    color: #c3ccda;
    margin-bottom: 40px;
  }
  .breadcrumbs a {
    color: #c3ccda;
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: #ffffff;
  }
  .breadcrumbs .current {
    color: #ddc582;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #c9a840;
    margin-bottom: 20px;
  }
  .eyebrow::before {
    content: '';
    width: 28px;
    height: 2px;
    background: #c9a840;
  }

  .practice-hero h1 {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 38px;
    line-height: 1.12;
    letter-spacing: -0.6px;
    color: #ffffff;
    max-width: 880px;
    margin: 0 0 24px;
  }

  .hero-intro {
    font-size: 24px;
    line-height: 36px;
    color: #ddc582;
    max-width: 820px;
    margin: 0 0 20px;
  }

  .hero-description {
    font-size: 17px;
    line-height: 28.9px;
    color: #c3ccda;
    max-width: 760px;
    margin: 0 0 36px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }
  .hero-actions .button {
    display: inline-flex;
    align-items: center;
    padding: 16px 30px;
    background: #732521;
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    border: 1px solid transparent;
    border-radius: 3px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .hero-actions .button:hover {
    background: #581b19;
  }
  .hero-actions .phone {
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    color: #ffffff;
    padding-bottom: 6px;
    border-bottom: 1px solid #c9a840;
    text-decoration: none;
  }

  .practice-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 56px;
    padding-top: 90px;
    padding-bottom: 90px;
    align-items: start;
  }

  .intro-heading {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 40px;
    line-height: 1.14;
    letter-spacing: -0.5px;
    color: #061532;
    max-width: 720px;
    margin: 0 0 32px;
  }

  .main-image,
  .sidebar-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 10;
    object-fit: cover;
    border-radius: 4px;
  }
  .main-image {
    margin-bottom: 40px;
  }

  .source-copy p {
    font-size: 18px;
    line-height: 31px;
    color: #454e5e;
    margin: 0 0 24px;
  }

  .sidebar-card {
    background: #f7f6f2;
    border: 1px solid #e7e3d9;
    border-radius: 6px;
    padding: 32px 28px;
  }
  .sidebar-card h2 {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.2px;
    line-height: 19.5px;
    text-transform: uppercase;
    color: #732521;
    margin: 0 0 20px;
  }
  .sidebar-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sidebar-card li {
    position: relative;
    padding-left: 22px;
    font-size: 16px;
    line-height: 25.6px;
    color: #454e5e;
    margin-bottom: 12px;
  }
  .sidebar-card li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: #c9a840;
  }

  .practice-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .sidebar-image {
    aspect-ratio: 5 / 3;
  }

  .all-practices {
    font-size: 16px;
    font-weight: 700;
    color: #732521;
    text-decoration: none;
  }
  .all-practices:hover {
    text-decoration: underline;
  }

  @media (min-width: 901px) {
    .practice-hero h1 {
      font-size: 52px;
      line-height: 58.24px;
      max-width: 960px;
    }
  }

  @media (max-width: 900px) {
    .practice-body {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .practice-sidebar {
      max-width: 520px;
    }
  }

  @media (max-width: 640px) {
    .practice-hero {
      padding-top: 120px;
    }
    .practice-hero h1 {
      font-size: 32px;
    }
    .intro-heading {
      font-size: 30px;
    }
    .hero-intro {
      font-size: 20px;
      line-height: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-actions .button {
      transition: none;
    }
  }
</style>
