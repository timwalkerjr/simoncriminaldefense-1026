      url("https://jas-law-astro-review.netlify.app/hero-court-1.webp") 50% 50% / cover no-repeat;
    padding: 140px 0 88px;
    color: #fff;
  }
  .practice-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: #c3ccda;
    margin-bottom: 36px;
  }
  .breadcrumbs a { color: #c3ccda; text-decoration: none; }
  .breadcrumbs a:hover { color: #fff; }
  .breadcrumbs .current { color: #ddc582; }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: #c9a840;
    margin-bottom: 20px;
  }
  .eyebrow::before {
    content: "";
    width: 28px;
    height: 2px;
    background: #c9a840;
  }
  .practice-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 52px);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.6px;
    color: #fff;
    max-width: 880px;
    margin: 0 0 24px;
  }
  .hero-intro {
    font-size: 24px;
    line-height: 36px;
    color: #ddc582;
    margin: 0 0 16px;
  }
  .hero-description {
    font-size: 17px;
    line-height: 28.9px;
    color: #c3ccda;
    max-width: 760px;
    margin: 0 0 32px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
  }
  .hero-actions .button {
    display: inline-block;
    background: #732521;
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    padding: 16px 30px;
    border-radius: 3px;
    border: 1px solid transparent;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .hero-actions .button:hover { background: #581b19; }
  .hero-actions .phone {
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid #c9a840;
  }

  .practice-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 72px;
    padding-top: 90px;
    padding-bottom: 90px;
    align-items: start;
  }
  .intro-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 1.4rem + 1.4vw, 44px);
    font-weight: 900;
    line-height: 1.14;
    letter-spacing: -0.53px;
    color: #061532;
    max-width: 560px;
    margin: 0 0 40px;
  }
  .main-image,
  .sidebar-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 4px;
  }
  .main-image { aspect-ratio: 2.1 / 1; margin-bottom: 40px; }
  .sidebar-image { aspect-ratio: 5 / 3; margin-bottom: 24px; }

  .source-copy h3 {
    font-family: var(--font-serif);
    font-size: 23px;
    font-weight: 800;
    line-height: 1.35;
    color: #061532;
    margin: 40px 0 16px;
  }
  .source-copy h3:first-child { margin-top: 0; }
  .source-copy p {
    font-size: 18px;
    line-height: 1.8;
    color: #141c28;
    margin: 0 0 20px;
  }
  .source-copy a {
    color: #732521;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .source-copy a:hover { color: #581b19; }

  .sidebar-card {
    background: #f7f6f2;
    border: 1px solid #e7e3d9;
    border-radius: 8px;
    padding: 28px 26px;
    margin-bottom: 24px;
  }
  .sidebar-card h2 {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #732521;
    margin: 0 0 20px;
  }
  .sidebar-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sidebar-card li {
    position: relative;
    padding-left: 22px;
    font-size: 16px;
    line-height: 25.6px;
    color: #454e5e;
    margin-bottom: 12px;
  }
  .sidebar-card li::before {
    content: "—";
    position: absolute;
    left: 0;
    top: 0;
    color: #c9a840;
  }
  .all-practices {
    display: block;
    font-size: 16px;
    font-weight: 700;
    color: #732521;
    text-decoration: none;
    margin-top: 40px;
  }
  .all-practices:hover { text-decoration: underline; }
  .practice-sidebar > .all-practices + .all-practices { margin-top: 32px; }

  @media (max-width: 960px) {
    .practice-body {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .practice-sidebar { max-width: 520px; }
  }
  @media (max-width: 640px) {
    .practice-hero { padding: 120px 0 64px; }
    .practice-body { padding-top: 60px; padding-bottom: 60px; }
    .source-copy p { font-size: 17px; line-height: 1.75; }
  }
</style>
