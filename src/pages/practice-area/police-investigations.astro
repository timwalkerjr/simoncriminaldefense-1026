---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Washtenaw County Police Investigations Defense Lawyer';
const description =
  'Early Intervention in Police Investigations is Your Best Defense. Joe Simon Named a Top Ten Criminal Defense Attorney in Michigan by Leading Lawyers Magazine.';

const charges = [
  'Police want me to make a statement',
  "I'm being investigated for a crime",
  'A search warrant was executed at my home',
  'I was arrested but not yet charged with a crime',
  "I was arrested for drunk driving but don't have a court date",
  'The police took a sample of my blood',
  'I was fired from my job and now the police are contacting me',
  'I have a warrant outstanding for my arrest',
  "I was arrested but my case hasn't opened with the courts",
  'Someone is making allegations of a crime against me',
];

const footerLinks = [
  { label: 'Home', href: '/' },
  { label: 'Practice Areas', href: '/practice-areas' },
  { label: 'Results', href: '/#results' },
  { label: 'About', href: '/#about' },
  { label: 'Testimonials', href: '/#testimonials' },
  { label: 'FAQs', href: '/#faq' },
  { label: 'Contact', href: '/#contact' },
];
---

<BaseLayout title={title} description={description} headerVariant="transparent">
  <main data-ps="src/pages/practice-area/police-investigations.astro:gufksn">
    <section class="pi-hero" data-ps="src/pages/practice-area/police-investigations.astro:yatsd0">
      <div class="pi-container" data-ps="src/pages/practice-area/police-investigations.astro:mrjlvd">
        <nav class="pi-breadcrumbs" aria-label="Breadcrumb" data-ps="src/pages/practice-area/police-investigations.astro:kx5tju">
          <a href="/" data-ps="src/pages/practice-area/police-investigations.astro:nqfv3t">Home</a>
          <span aria-hidden="true" data-ps="src/pages/practice-area/police-investigations.astro:ay87dm">/</span>
          <a href="/practice-areas" data-ps="src/pages/practice-area/police-investigations.astro:nqfv3s">Practice Areas</a>
          <span aria-hidden="true" data-ps="src/pages/practice-area/police-investigations.astro:ay87dn">/</span>
          <span data-ps="src/pages/practice-area/police-investigations.astro:ay87do">Police Investigations</span>
        </nav>

        <div class="pi-eyebrow" data-ps="src/pages/practice-area/police-investigations.astro:8figyp">Police Investigations</div>

        <h1 data-ps="src/pages/practice-area/police-investigations.astro:vjzj8h">Washtenaw County Police Investigations Defense Lawyer</h1>

        <p class="pi-hero-intro" data-ps="src/pages/practice-area/police-investigations.astro:uudrsq">
          Washtenaw County Police Investigations Defense Lawyer. Local, Experienced, Established. Joseph A. Simon
        </p>

        <p class="pi-hero-description" data-ps="src/pages/practice-area/police-investigations.astro:uudrsp">
          Early Intervention in Police Investigations is Your Best Defense. Joe Simon Named a Top Ten Criminal Defense Attorney in Michigan by Leading Lawyers Magazine.
        </p>

        <div class="pi-hero-actions" data-ps="src/pages/practice-area/police-investigations.astro:8figyq">
          <a class="pi-button" href="/#contact" data-ps="src/pages/practice-area/police-investigations.astro:nqfv3r">Request a Confidential Consultation</a>
          <a class="pi-phone" href="tel:+17348876200" data-ps="src/pages/practice-area/police-investigations.astro:nqfv3q">(734) 887-6200</a>
        </div>
      </div>
    </section>

    <div class="pi-body pi-container" data-ps="src/pages/practice-area/police-investigations.astro:8figyr">
      <div class="pi-reading" data-ps="src/pages/practice-area/police-investigations.astro:8figys">
        <h2 class="pi-intro-heading" data-ps="src/pages/practice-area/police-investigations.astro:osplj0">
          Sometimes the best defense to a criminal charge comes before charges are even turned over to the prosecuting attorney for review.
        </h2>

        <img
          class="pi-main-image"
          src="https://pagesmith-cdn.com/ee60f2da/images/66aa4f5d078bef17fc3fa3a4_criminal6-665e08-1536.webp"
          alt=""
          width="1536"
          height="864"
          loading="lazy" data-ps="src/pages/practice-area/police-investigations.astro:p9sq7o" />

        <article class="pi-copy" data-ps="src/pages/practice-area/police-investigations.astro:w8wsj7">
          <p data-ps="src/pages/practice-area/police-investigations.astro:uudrs3">
            Sometimes the best defense to a criminal charge comes <em>before </em>charges are even turned over to the prosecuting attorney for review. &nbsp;Just as medical health professionals advise that early intervention is often the key to successful recovery, early intervention of an experienced criminal defense attorney can be the key to preventing or reducing charges.
          </p>

          <h3 data-ps="src/pages/practice-area/police-investigations.astro:a4aobf"><strong>What Do The Best Criminal Defense Attorneys Do To Defend A Criminal Investigation?</strong></h3>

          <p data-ps="src/pages/practice-area/police-investigations.astro:uudrs2">
            Ethically, lawyers cannot and should not make claims about themselves such as being “the best.” Instead, lawyers should stand on their experience, ratings, reputation, and results. &nbsp;The best practices for Defending a criminal investigation include: &nbsp;intimate knowledge of the local police agencies, prosecuting agencies, and courts; a thorough confidential client interview; obtaining all preliminary case discovery, if possible, including in-car and body-cam police video, audio dispatch recordings, 9-1-1 audio recordings, interviewing any witnesses, independent private investigation, and monitoring a case to try to prevent an ambush or surprise arrest.
          </p>

          <p data-ps="src/pages/practice-area/police-investigations.astro:uudrs1">
            Our attorneys have over 65 years combined experience in criminal defense and an unwavering commitment to excellence in criminal defense. If you or a loved one are contacted by the police regarding an investigation for a crime in the greater Ann Arbor area or Washtenaw, Wayne, Jackson, Livingston, or Lenawee County, contact us for a free consultation at 734-887-6200.
          </p>
        </article>
      </div>

      <aside class="pi-sidebar" data-ps="src/pages/practice-area/police-investigations.astro:m30e32">
        <section class="pi-card pi-charges" data-ps="src/pages/practice-area/police-investigations.astro:yatscz">
          <h2 data-ps="src/pages/practice-area/police-investigations.astro:osplj1">We Defend These Charges:</h2>
          <ul>
            {charges.map((charge) => <li data-ps="src/pages/practice-area/police-investigations.astro:pjohzy">{charge}</li>)}
          </ul>
        </section>

        <img
          class="pi-side-image"
          src="https://pagesmith-cdn.com/ee60f2da/images/66aa4f5d078bef17fc3fa3b2_criminal3-b9bf33-1536.webp"
          alt=""
          width="1536"
          height="1024"
          loading="lazy" data-ps="src/pages/practice-area/police-investigations.astro:p9sq72" />
        <img
          class="pi-side-image"
          src="https://pagesmith-cdn.com/ee60f2da/images/66aa4f5d078bef17fc3fa2a6_criminal8-a836a1-1536.webp"
          alt=""
          width="1536"
          height="1024"
          loading="lazy" data-ps="src/pages/practice-area/police-investigations.astro:p9sq71" />

        <a class="pi-all-practices" href="/practice-areas" data-ps="src/pages/practice-area/police-investigations.astro:nqfv34">
          Explore All Practice Areas <span aria-hidden="true" data-ps="src/pages/practice-area/police-investigations.astro:ay87dp">→</span>
        </a>
      </aside>
    </div>

    <section class="bg-[#061633] py-[100px]" data-ps="src/pages/practice-area/police-investigations.astro:yatscy">
      <div class="max-w-[1280px] mx-auto px-6 text-center" data-ps="src/pages/practice-area/police-investigations.astro:8figyt">
        <div class="mb-4" data-ps="src/pages/practice-area/police-investigations.astro:8figyu">
          <span class="inline-flex items-center text-[12px] font-bold uppercase tracking-[1.8px] text-[#C9A840]" data-ps="src/pages/practice-area/police-investigations.astro:ay87dq"><span class="w-[28px] h-[2px] bg-[#C9A840] inline-block mr-3" data-ps="src/pages/practice-area/police-investigations.astro:ay87dr"></span>Consultation</span>
        </div>
        <h2 class="text-[44px] font-black leading-[1.14] tracking-[-0.53px] text-white mb-6 max-w-[820px] mx-auto" data-ps="src/pages/practice-area/police-investigations.astro:osplj2">Whatever the charge, talk to us first.</h2>
        <p class="text-[18.08px] leading-[31px] text-[#C3CCDA] max-w-[680px] mx-auto mb-8" data-ps="src/pages/practice-area/police-investigations.astro:uudrs0">Your consultation is confidential and available 24/7. Tell us what you're facing and we'll explain how Michigan law applies to it.</p>
        <div class="flex flex-wrap justify-center gap-4 mb-12" data-ps="src/pages/practice-area/police-investigations.astro:8figyv">
          <a href="/#contact" class="bg-[#732521] text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] hover:bg-[#5a1c19] transition inline-flex items-center gap-2" data-ps="src/pages/practice-area/police-investigations.astro:nqfv33">Request a Confidential Consultation<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
          <a href="tel:+17348876200" class="border border-white/30 text-white font-semibold text-[16.16px] px-[30px] py-[16px] rounded-[3px] hover:border-[#C9A840] hover:text-[#DDC582] transition inline-flex items-center gap-2" data-ps="src/pages/practice-area/police-investigations.astro:rk94o">Call (734) 887-6200</a>
        </div>
        <div class="border-t border-white/10 pt-8 mt-8" data-ps="src/pages/practice-area/police-investigations.astro:8figyw">
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-3" data-ps="src/pages/practice-area/police-investigations.astro:8figyx">
            {footerLinks.map((link) => <a href={link.href} class="text-[14px] text-[#C3CCDA] hover:text-white transition" data-ps="src/pages/practice-area/police-investigations.astro:rk94n">{link.label}</a>)}
          </div>
          <div class="mt-6" data-ps="src/pages/practice-area/police-investigations.astro:8figyy">
            <a href="tel:+17348876200" class="text-[#C9A840] font-bold text-[16px] hover:text-[#DDC582] transition" data-ps="src/pages/practice-area/police-investigations.astro:rk94m">Call (734) 887-6200</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .pi-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .pi-hero {
    position: relative;
    padding: 9rem 0 5.5rem;
    color: #fff;
    background-color: #061532;
    background-image:
      linear-gradient(100deg, rgba(4, 16, 38, 0.97) 0%, rgba(8, 26, 60, 0.85) 100%),
      url("https://jas-law-astro-review.netlify.app/hero-court-1.webp");
    background-size: auto, cover;
    background-position: 0% 0%, 50% 50%;
  }

  .pi-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 13px;
    line-height: 1.5;
    color: #c3ccda;
  }
  .pi-breadcrumbs a {
    color: #c3ccda;
    text-decoration: none;
  }
  .pi-breadcrumbs a:hover {
    color: #fff;
  }
  .pi-breadcrumbs span:last-child {
    color: #ddc582;
  }

  .pi-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #c9a840;
  }
  .pi-eyebrow::before {
    content: '';
    width: 28px;
    height: 2px;
    background: #c9a840;
  }

  .pi-hero h1 {
    margin: 1.25rem 0 0;
    max-width: 920px;
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.25rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.6px;
    color: #fff;
  }

  .pi-hero-intro {
    margin: 1.5rem 0 0;
    max-width: 920px;
    font-size: clamp(1.1rem, 0.95rem + 0.5vw, 1.5rem);
    line-height: 1.5;
    color: #ddc582;
  }

  .pi-hero-description {
    margin: 1rem 0 0;
    max-width: 780px;
    font-size: 17px;
    line-height: 1.7;
    color: #c3ccda;
  }

  .pi-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .pi-button {
    display: inline-flex;
    align-items: center;
    padding: 16px 30px;
    border: 1px solid transparent;
    border-radius: 3px;
    background: #732521;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .pi-button:hover {
    background: #581b19;
  }

  .pi-phone {
    padding-bottom: 6px;
    border-bottom: 1px solid #c9a840;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }
  .pi-phone:hover {
    color: #ddc582;
  }

  .pi-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    padding-top: 90px;
    padding-bottom: 90px;
  }

  .pi-intro-heading {
    max-width: 640px;
    margin: 0;
    font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.75rem);
    font-weight: 900;
    line-height: 1.14;
    letter-spacing: -0.5px;
    color: #061532;
  }

  .pi-main-image {
    display: block;
    width: 100%;
    aspect-ratio: 2.1 / 1;
    height: auto;
    margin: 2.25rem 0 2.5rem;
    border-radius: 4px;
    object-fit: cover;
  }

  .pi-copy {
    font-size: 18px;
    line-height: 1.8;
    color: #454e5e;
  }
  .pi-copy p {
    margin: 0 0 1.25rem;
  }
  .pi-copy h3 {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.4375rem;
    font-weight: 800;
    line-height: 1.35;
    color: #061532;
  }
  .pi-copy strong {
    font-weight: 800;
  }

  .pi-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pi-card {
    padding: 28px;
    border: 1px solid #e7e3d9;
    border-radius: 6px;
    background: #f7f6f2;
  }

  .pi-charges h2 {
    margin: 0 0 1.25rem;
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #732521;
  }
  .pi-charges ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pi-charges li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.9rem;
    font-size: 16px;
    line-height: 1.6;
    color: #454e5e;
  }
  .pi-charges li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: #c9a840;
  }

  .pi-side-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
    border-radius: 4px;
    object-fit: cover;
  }

  .pi-all-practices {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 16px;
    font-weight: 700;
    color: #732521;
    text-decoration: none;
  }
  .pi-all-practices:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .pi-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
      padding-top: 64px;
      padding-bottom: 64px;
    }
    .pi-hero {
      padding-top: 7.5rem;
    }
  }

  @media (max-width: 640px) {
    .pi-intro-heading {
      font-size: 1.75rem;
    }
    .pi-hero-actions {
      gap: 1rem;
    }
    .pi-button {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pi-button {
      transition: none;
    }
  }
</style>
