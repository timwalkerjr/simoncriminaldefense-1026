        <h2 class="mx-auto mb-6 max-w-[820px] font-heading text-[clamp(2rem,1.4rem+1.8vw,2.75rem)] font-black leading-[1.14] tracking-[-0.5px] text-white" data-ps="src/pages/practice-area/ann-arbor-domestic-violence.astro:9gbwfx">
