---
import BaseLayout from '@/layouts/BaseLayout.astro';

const mainImage = 'https://pagesmith-cdn.com/ee60f2da/images/66aa4f5d078bef17fc3fa264_5e693233d73d1103401bf0c1_criminal1-74abf4-1536.webp';
const sidebarImageOne = 'https://pagesmith-cdn.com/ee60f2da/images/66aa4f5d078bef17fc3fa285_criminal10-21e31f-1536.webp';
const sidebarImageTwo = 'https://pagesmith-cdn.com/ee60f2da/images/66aa4f5d078bef17fc3fa243_criminal-22-313879-1536.webp';

const charges = [
  'Criminal Sexual Conduct Allegations',
  'Hazing Charges',
  'Possessing Open Intoxicants',
  'False Identification - Fake ID Charges',
  'Campus Theft Allegations',
  'Assault and Battery Charges',
  'Game Day Offenses',
  'Malicious Destruction of Property',
];
---

<BaseLayout
  headerVariant="transparent"
  title="Washtenaw County College Crimes Criminal Defense - Joe Simon"
  description="Joe Simon Has Been Named a 2020 Top Ten Criminal Defense Attorney in the State of Michigan by Leading Lawyers Magazine, Following A Peer Review Survey."
>
  <div class="cc-page" data-ps="src/pages/practice-area/college-crimes-defense.astro:e5512z">
    <section class="cc-hero" data-ps="src/pages/practice-area/college-crimes-defense.astro:gij1y8">
      <div class="cc-container" data-ps="src/pages/practice-area/college-crimes-defense.astro:e55130">
        <nav class="cc-breadcrumbs" aria-label="Breadcrumb" data-ps="src/pages/practice-area/college-crimes-defense.astro:fzitej">
          <a href="/" data-ps="src/pages/practice-area/college-crimes-defense.astro:njbu2s">Home</a>
          <span aria-hidden="true" data-ps="src/pages/practice-area/college-crimes-defense.astro:z0ploy">/</span>
          <a href="/practice-areas" data-ps="src/pages/practice-area/college-crimes-defense.astro:njbu2r">Practice Areas</a>
          <span aria-hidden="true" data-ps="src/pages/practice-area/college-crimes-defense.astro:z0ploz">/</span>
          <span class="cc-crumb-current" data-ps="src/pages/practice-area/college-crimes-defense.astro:z0plp0">College Crimes</span>
        </nav>

        <div class="cc-eyebrow" data-ps="src/pages/practice-area/college-crimes-defense.astro:e55131">College Crimes</div>

        <h1 data-ps="src/pages/practice-area/college-crimes-defense.astro:g8btzp">Washtenaw County College Crimes Criminal Defense - Joe Simon</h1>

        <p class="cc-hero-intro" data-ps="src/pages/practice-area/college-crimes-defense.astro:un9qro">Washtenaw County College Crimes Defense Lawyer Located Right Across From Michigan Football Stadium</p>

        <p class="cc-hero-description" data-ps="src/pages/practice-area/college-crimes-defense.astro:un9qrn">Joe Simon Has Been Named a 2020 Top Ten Criminal Defense Attorney in the State of Michigan by Leading Lawyers Magazine, Following A Peer Review Survey.</p>

        <div class="cc-hero-actions" data-ps="src/pages/practice-area/college-crimes-defense.astro:1u2ahh">
          <a class="cc-button" href="/#contact" data-ps="src/pages/practice-area/college-crimes-defense.astro:njbu2q">Request a Confidential Consultation</a>
          <a class="cc-phone" href="tel:+17348876200" data-ps="src/pages/practice-area/college-crimes-defense.astro:njbu2p">(734) 887-6200</a>
        </div>
      </div>
    </section>

    <div class="cc-body cc-container" data-ps="src/pages/practice-area/college-crimes-defense.astro:1u2ahg">
      <div class="cc-reading" data-ps="src/pages/practice-area/college-crimes-defense.astro:1u2ahf">
        <h2 class="cc-intro-heading" data-ps="src/pages/practice-area/college-crimes-defense.astro:1jwws2">Let Our Experience, Reputation, And Standing Defend And Protect Your Future</h2>

        <img
          class="cc-main-image"
          src={mainImage}
          alt=""
          width="1536"
          height="731"
          loading="lazy" data-ps="src/pages/practice-area/college-crimes-defense.astro:bmvwqq" />

        <div class="cc-copy" data-ps="src/pages/practice-area/college-crimes-defense.astro:1u2ahe">
          <p data-ps="src/pages/practice-area/college-crimes-defense.astro:un9qr1">The Law Offices of Joseph A. Simon are located across the street from the University of Michigan Football Stadium. Representing college students is a significant part of our practice. The college environment can sometimes lead to indiscretion and bad judgment. It can also lead to being in the wrong place at the wrong time and most certainly can lead to being wrongfully accused of a crime.</p>

          <p data-ps="src/pages/practice-area/college-crimes-defense.astro:un9qr0">College crimes can include game-day offenses such as possessing open intoxicants in public, urinating in public, theft offenses, property crimes, drug offenses, and assaults. They can also include campus crimes such as <a href="/practice-area/sex-crime-defense" data-ps="src/pages/practice-area/college-crimes-defense.astro:njbu2o"><em>criminal sexual conduct</em>,</a> <a href="/practice-area/domestic-violence-defense" data-ps="src/pages/practice-area/college-crimes-defense.astro:njbu22"><em>domestic assault</em></a>, <a href="/practice-area/assault-defense" data-ps="src/pages/practice-area/college-crimes-defense.astro:njbu21"><em>assault and battery</em>,</a> theft offenses, false identification offenses, capture and/or distribution of illicit images, drug offenses, and alcohol-related crimes.</p>

          <p data-ps="src/pages/practice-area/college-crimes-defense.astro:un9qqz">For over 35 years, Joseph A. Simon has been helping college students protect their future and their academic and career goals. Mr. Simon’s successful history in representing college students has earned him favorable reviews by parent groups at the University of Michigan and other Fraternal, Social and Academic campus groups.</p>

          <p data-ps="src/pages/practice-area/college-crimes-defense.astro:un9qqy">If you or a loved one are arrested or charged with any of these college crimes in the City of Ann Arbor or Washtenaw, Wayne, Jackson, Livingston, or Lenawee County contact Ann Arbor criminal defense attorney Joseph A. Simon at 734-887-6200.</p>
        </div>
      </div>

      <aside class="cc-sidebar" data-ps="src/pages/practice-area/college-crimes-defense.astro:3paet8">
        <section class="cc-charges" data-ps="src/pages/practice-area/college-crimes-defense.astro:gij1y7">
          <h2 data-ps="src/pages/practice-area/college-crimes-defense.astro:1jwws3">We Defend These Charges:</h2>
          <ul>
            {charges.map((charge) => <li data-ps="src/pages/practice-area/college-crimes-defense.astro:2avt8z">{charge}</li>)}
          </ul>
        </section>

        <img
          class="cc-side-image"
          src={sidebarImageOne}
          alt=""
          width="1536"
          height="918"
          loading="lazy" data-ps="src/pages/practice-area/college-crimes-defense.astro:bmvwrc" />
        <img
          class="cc-side-image cc-side-image-tall"
          src={sidebarImageTwo}
          alt=""
          width="1536"
          height="1024"
          loading="lazy" data-ps="src/pages/practice-area/college-crimes-defense.astro:bmvwrd" />

        <a class="cc-all-practices" href="/practice-areas" data-ps="src/pages/practice-area/college-crimes-defense.astro:njbu20">
          Explore All Practice Areas <span aria-hidden="true" data-ps="src/pages/practice-area/college-crimes-defense.astro:z0plp1">→</span>
        </a>
      </aside>
    </div>

    <section class="cc-cta" data-ps="src/pages/practice-area/college-crimes-defense.astro:gij1y6">
      <div class="cc-container cc-cta-inner" data-ps="src/pages/practice-area/college-crimes-defense.astro:1u2ahd">
        <div class="cc-eyebrow cc-eyebrow-center" data-ps="src/pages/practice-area/college-crimes-defense.astro:1u2ahc">Consultation</div>

        <h2 data-ps="src/pages/practice-area/college-crimes-defense.astro:1jwws4">Whatever the charge, talk to us first.</h2>

        <p class="cc-cta-text" data-ps="src/pages/practice-area/college-crimes-defense.astro:un9qqx">Your consultation is confidential and available 24/7. Tell us what you're facing and we'll explain how Michigan law applies to it.</p>

        <div class="cc-cta-actions" data-ps="src/pages/practice-area/college-crimes-defense.astro:1u2ahb">
          <a class="cc-button" href="/#contact" data-ps="src/pages/practice-area/college-crimes-defense.astro:njbu1z">
            Request a Confidential Consultation
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
          <a class="cc-button cc-button-outline" href="tel:+17348876200" data-ps="src/pages/practice-area/college-crimes-defense.astro:no7hv8">Call (734) 887-6200</a>
        </div>

        <div class="cc-cta-links" data-ps="src/pages/practice-area/college-crimes-defense.astro:1u2aha">
          <div class="cc-cta-nav" data-ps="src/pages/practice-area/college-crimes-defense.astro:1u2ah9">
            <a href="/" data-ps="src/pages/practice-area/college-crimes-defense.astro:no7hv7">Home</a>
            <a href="/practice-areas" data-ps="src/pages/practice-area/college-crimes-defense.astro:no7hv6">Practice Areas</a>
            <a href="/#results" data-ps="src/pages/practice-area/college-crimes-defense.astro:no7hv5">Results</a>
            <a href="/#about" data-ps="src/pages/practice-area/college-crimes-defense.astro:no7hv4">About</a>
            <a href="/#testimonials" data-ps="src/pages/practice-area/college-crimes-defense.astro:no7hv3">Testimonials</a>
            <a href="/#faq" data-ps="src/pages/practice-area/college-crimes-defense.astro:no7hv2">FAQs</a>
            <a href="/#contact" data-ps="src/pages/practice-area/college-crimes-defense.astro:no7hv1">Contact</a>
          </div>
          <div class="cc-cta-call" data-ps="src/pages/practice-area/college-crimes-defense.astro:1u2ah8">
            <a href="tel:+17348876200" data-ps="src/pages/practice-area/college-crimes-defense.astro:no7hv0">Call (734) 887-6200</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .cc-page {
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .cc-container {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  /* Hero */
  .cc-hero {
    background:
      linear-gradient(100deg, rgba(4, 16, 38, 0.97) 0%, rgba(8, 26, 60, 0.85) 100%),
      url("https://jas-law-astro-review.netlify.app/hero-court-1.webp") 50% 50% / cover no-repeat;
    padding-top: 128px;
    padding-bottom: 88px;
    color: #ffffff;
  }

  .cc-hero .cc-container {
    max-width: 1280px;
  }

  .cc-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    line-height: 19.5px;
    color: #c3ccda;
  }

  .cc-breadcrumbs a {
    color: #c3ccda;
    text-decoration: none;
  }

  .cc-breadcrumbs a:hover {
    color: #ffffff;
  }

  .cc-crumb-current {
    color: #ddc582;
  }

  .cc-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
    font-size: 12px;
    font-weight: 700;
    line-height: 18px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #c9a840;
  }

  .cc-eyebrow::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 2px;
    background: #c9a840;
  }

  .cc-eyebrow-center {
    justify-content: center;
    margin-top: 0;
    margin-bottom: 16px;
  }

  .cc-hero h1 {
    margin-top: 20px;
    max-width: 920px;
    font-size: clamp(2.25rem, 1.5rem + 2.4vw, 3.25rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.6px;
    color: #ffffff;
  }

  .cc-hero-intro {
    margin-top: 24px;
    max-width: 820px;
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.5;
    color: #ddc582;
  }

  .cc-hero-description {
    margin-top: 20px;
    max-width: 760px;
    font-size: 17px;
    line-height: 1.7;
    color: #c3ccda;
  }

  .cc-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 40px;
  }

  .cc-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 30px;
    border: 1px solid transparent;
    border-radius: 3px;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .cc-button:hover {
    background: var(--color-primary-hover);
  }

  .cc-button svg {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .cc-button-outline {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .cc-button-outline:hover {
    background: transparent;
    border-color: #c9a840;
    color: #ddc582;
  }

  .cc-phone {
    padding-bottom: 6px;
    border-bottom: 1px solid #c9a840;
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  .cc-phone:hover {
    color: #ddc582;
  }

  /* Body */
  .cc-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 56px;
    padding-top: 90px;
    padding-bottom: 96px;
    align-items: start;
  }

  .cc-intro-heading {
    font-size: 40px;
    font-weight: 900;
    line-height: 1.22;
    letter-spacing: -0.4px;
    color: var(--color-foreground);
  }

  .cc-main-image,
  .cc-side-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 4px;
  }

  .cc-main-image {
    margin-top: 32px;
    aspect-ratio: 2.1 / 1;
  }

  .cc-copy {
    margin-top: 40px;
  }

  .cc-copy p {
    margin: 0 0 24px;
    font-size: 18px;
    line-height: 1.8;
    color: var(--color-muted-foreground);
  }

  .cc-copy a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cc-copy a:hover {
    color: var(--color-primary-hover);
  }

  /* Sidebar */
  .cc-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cc-charges {
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
  }

  .cc-charges h2 {
    margin: 0 0 20px;
    font-size: 13px;
    font-weight: 800;
    line-height: 19.5px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .cc-charges ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cc-charges li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 14px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  .cc-charges li:last-child {
    margin-bottom: 0;
  }

  .cc-charges li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: #c9a840;
  }

  .cc-side-image {
    aspect-ratio: 1.68 / 1;
  }

  .cc-side-image-tall {
    aspect-ratio: 1.5 / 1;
  }

  .cc-all-practices {
    display: inline-flex;
    gap: 6px;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .cc-all-practices:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Consultation band */
  .cc-cta {
    background: var(--color-dark-background);
    color: #ffffff;
    padding: 100px 0;
    text-align: center;
  }

  .cc-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cc-cta h2 {
    max-width: 820px;
    margin: 0 0 24px;
    font-size: 44px;
    font-weight: 900;
    line-height: 1.14;
    letter-spacing: -0.53px;
    color: #ffffff;
  }

  .cc-cta-text {
    max-width: 680px;
    margin: 0 0 32px;
    font-size: 18px;
    line-height: 1.7;
    color: #c3ccda;
  }

  .cc-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-bottom: 48px;
  }

  .cc-cta-links {
    width: 100%;
    margin-top: 16px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cc-cta-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 24px;
  }

  .cc-cta-nav a {
    font-size: 14px;
    color: #c3ccda;
    text-decoration: none;
  }

  .cc-cta-nav a:hover {
    color: #ffffff;
  }

  .cc-cta-call {
    margin-top: 24px;
  }

  .cc-cta-call a {
    font-size: 16px;
    font-weight: 700;
    color: #c9a840;
    text-decoration: none;
  }

  .cc-cta-call a:hover {
    color: #ddc582;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .cc-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
    }

    .cc-sidebar {
      max-width: 520px;
    }
  }

  @media (max-width: 640px) {
    .cc-hero {
      padding-top: 112px;
      padding-bottom: 64px;
    }

    .cc-intro-heading {
      font-size: 32px;
    }

    .cc-cta h2 {
      font-size: 34px;
    }

    .cc-copy p,
    .cc-cta-text {
      font-size: 17px;
    }

    .cc-button {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }

    .cc-cta-actions .cc-button {
      max-width: 360px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cc-button {
      transition: none;
    }
  }
</style>
